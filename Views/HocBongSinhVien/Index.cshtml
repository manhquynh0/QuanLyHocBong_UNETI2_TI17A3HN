@* Họ và tên: Nguyễn Phi Hùng - Mã sinh viên: 23103100148
   Nội dung thực hiện: Module 3 - danh sách học bổng phía sinh viên (tìm kiếm, lọc, sắp xếp, phân trang). *@
@using QuanLyHocBong_UNETI2_TI17A3HN.ViewModels
@model HocBongSinhVienListViewModel
@{
    ViewData["Title"] = "Danh sách học bổng";

    // Giữ nguyên từ khóa, bộ lọc, kiểu sắp xếp khi chuyển trang
    Dictionary<string, string> RouteTrang(int trang)
    {
        var d = new Dictionary<string, string> { ["page"] = trang.ToString(), ["sort"] = Model.Sort };
        if (!string.IsNullOrWhiteSpace(Model.Keyword)) d["keyword"] = Model.Keyword!;
        if (Model.MaDonViTaiTro.HasValue) d["maDonViTaiTro"] = Model.MaDonViTaiTro.Value.ToString();
        if (!string.IsNullOrEmpty(Model.BacDaoTao)) d["bacDaoTao"] = Model.BacDaoTao!;
        if (!string.IsNullOrEmpty(Model.HanNop)) d["hanNop"] = Model.HanNop!;
        if (Model.PhuHop) d["phuHop"] = "true";
        return d;
    }

    var tu = Model.TotalItems == 0 ? 0 : (Model.Page - 1) * Model.PageSize + 1;
    var den = Math.Min(Model.Page * Model.PageSize, Model.TotalItems);
}

<h2 class="mt-3 mb-1">Học bổng đang mở</h2>
<p class="text-muted">
    @if (Model.CoHoSoCaNhan)
    {
        <span>Điểm trung bình tích lũy của bạn: <strong>@Model.DiemCuaToi.ToString("0.00")</strong></span>
    }
    else
    {
        <span>Tài khoản chưa có hồ sơ sinh viên.</span>
    }
</p>

<form method="get" asp-action="Index" class="card card-body mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-lg-4">
            <label class="form-label mb-1">Tìm kiếm</label>
            <input type="text" name="keyword" value="@Model.Keyword" class="form-control"
                   placeholder="Tên học bổng hoặc đơn vị tài trợ" />
        </div>
        <div class="col-lg-3 col-md-6">
            <label class="form-label mb-1">Đơn vị tài trợ</label>
            <select name="maDonViTaiTro" class="form-select">
                <option value="">Tất cả</option>
                @foreach (var d in Model.DonViTaiTros)
                {
                    <option value="@d.MaDonViTaiTro" selected="@(Model.MaDonViTaiTro == d.MaDonViTaiTro)">@d.TenDonViTaiTro</option>
                }
            </select>
        </div>
        <div class="col-lg-2 col-md-6">
            <label class="form-label mb-1">Bậc đào tạo</label>
            <select name="bacDaoTao" class="form-select">
                <option value="">Tất cả</option>
                @foreach (var b in Model.BacDaoTaos)
                {
                    <option value="@b" selected="@(Model.BacDaoTao == b)">@b</option>
                }
            </select>
        </div>
        <div class="col-lg-3 col-md-6">
            <label class="form-label mb-1">Thời hạn</label>
            <select name="hanNop" class="form-select">
                <option value="" selected="@string.IsNullOrEmpty(Model.HanNop)">Tất cả</option>
                <option value="conhan" selected="@(Model.HanNop == "conhan")">Còn hạn nộp</option>
                <option value="hethan" selected="@(Model.HanNop == "hethan")">Đã hết hạn</option>
            </select>
        </div>
        <div class="col-lg-4 col-md-6">
            <label class="form-label mb-1">Sắp xếp</label>
            <select name="sort" class="form-select">
                <option value="han_asc" selected="@(Model.Sort == "han_asc")">Hạn nộp: gần nhất trước</option>
                <option value="han_desc" selected="@(Model.Sort == "han_desc")">Hạn nộp: xa nhất trước</option>
                <option value="ten_asc" selected="@(Model.Sort == "ten_asc")">Tên A → Z</option>
                <option value="ten_desc" selected="@(Model.Sort == "ten_desc")">Tên Z → A</option>
                <option value="suat_desc" selected="@(Model.Sort == "suat_desc")">Số suất giảm dần</option>
                <option value="suat_asc" selected="@(Model.Sort == "suat_asc")">Số suất tăng dần</option>
            </select>
        </div>
        <div class="col-lg-4 col-md-6">
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" name="phuHop" value="true" id="phuHop" checked="@Model.PhuHop" />
                <label class="form-check-label" for="phuHop">Chỉ hiện học bổng đủ điều kiện điểm của tôi</label>
            </div>
        </div>
        <div class="col-lg-4 text-lg-end">
            <button type="submit" class="btn btn-primary">Tìm kiếm / Lọc</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Đặt lại</a>
        </div>
    </div>
</form>

<div class="text-muted mb-2">
    @if (Model.TotalItems == 0)
    {
        <span>Không có học bổng nào phù hợp.</span>
    }
    else
    {
        <span>Hiển thị @(tu)–@(den) trong tổng số @Model.TotalItems học bổng (trang @Model.Page/@Model.TotalPages)</span>
    }
</div>

<div class="row row-cols-1 row-cols-md-2 g-3">
    @foreach (var hb in Model.Items)
    {
        string? lyDo = null;
        if (hb.ChuaDenNgay) lyDo = "Chưa đến ngày nhận hồ sơ";
        else if (hb.HetHan) lyDo = "Đã hết hạn nộp hồ sơ";
        else if (!hb.DangMo) lyDo = "Không nhận hồ sơ";
        else if (hb.DaNop) lyDo = "Bạn đã nộp hồ sơ cho học bổng này";
        else if (!hb.DuDiem) lyDo = "Điểm trung bình chưa đạt yêu cầu";

        <div class="col">
            <div class="card h-100 @(hb.HetHan ? "border-secondary bg-light" : "")">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <h5 class="card-title mb-1">
                            <a asp-action="Details" asp-route-id="@hb.MaHocBong" class="text-decoration-none">@hb.TenHocBong</a>
                        </h5>
                        @if (hb.HetHan)
                        {
                            <span class="badge text-bg-secondary flex-shrink-0">Hết hạn</span>
                        }
                        else if (hb.ChuaDenNgay)
                        {
                            <span class="badge text-bg-info flex-shrink-0">Sắp mở</span>
                        }
                        else if (hb.SoNgayConLai <= 7)
                        {
                            <span class="badge text-bg-warning flex-shrink-0">Còn @(hb.SoNgayConLai == 0 ? "hôm nay" : hb.SoNgayConLai + " ngày")</span>
                        }
                        else
                        {
                            <span class="badge text-bg-success flex-shrink-0">Còn hạn</span>
                        }
                    </div>
                    <div class="text-muted small mb-2">@hb.TenDonViTaiTro</div>
                    <p class="card-text small" style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">
                        @hb.MoTaHocBong
                    </p>
                    <ul class="list-unstyled small mb-0">
                        <li><span class="text-muted">Bậc đào tạo:</span> @hb.BacDaoTao</li>
                        <li><span class="text-muted">ĐTB tối thiểu:</span> @hb.DiemTrungBinhToiThieu.ToString("0.00")
                            @if (Model.CoHoSoCaNhan)
                            {
                                if (hb.DuDiem) { <span class="text-success">(bạn đạt)</span> }
                                else { <span class="text-danger">(bạn chưa đạt)</span> }
                            }
                        </li>
                        <li><span class="text-muted">Số suất:</span> @hb.SoSuat</li>
                        <li><span class="text-muted">Nhận hồ sơ:</span> @hb.NgayBatDauNhanHoSo.ToString("dd/MM/yyyy") – @hb.HanNopHoSo.ToString("dd/MM/yyyy")</li>
                    </ul>
                </div>
                <div class="card-footer bg-transparent d-flex justify-content-between align-items-center">
                    <a asp-action="Details" asp-route-id="@hb.MaHocBong" class="btn btn-sm btn-outline-secondary">Chi tiết</a>
                    @if (lyDo == null)
                    {
                        <a asp-controller="HoSoCuaToi" asp-action="Create" asp-route-maHocBong="@hb.MaHocBong" class="btn btn-sm btn-primary">Nộp hồ sơ</a>
                    }
                    else
                    {
                        <span class="text-muted small">@lyDo</span>
                    }
                </div>
            </div>
        </div>
    }
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-4" aria-label="Phân trang">
        <ul class="pagination justify-content-center flex-wrap">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-all-route-data="@RouteTrang(Model.Page - 1)">&laquo; Trước</a>
            </li>
            @for (var i = 1; i <= Model.TotalPages; i++)
            {
                if (i == 1 || i == Model.TotalPages || Math.Abs(i - Model.Page) <= 2)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-all-route-data="@RouteTrang(i)">@i</a>
                    </li>
                }
                else if (Math.Abs(i - Model.Page) == 3)
                {
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                }
            }
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-all-route-data="@RouteTrang(Model.Page + 1)">Sau &raquo;</a>
            </li>
        </ul>
    </nav>
}
