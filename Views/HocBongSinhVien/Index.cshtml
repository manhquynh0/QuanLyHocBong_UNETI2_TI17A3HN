@* Họ và tên: Nguyễn Phi Hùng - Mã sinh viên: 23103100148
   Nội dung thực hiện: Module 3 - danh sách học bổng phía sinh viên (tìm kiếm, lọc, sắp xếp, phân trang). *@
@using QuanLyHocBong_UNETI2_TI17A3HN.ViewModels
@model HocBongSinhVienListViewModel
@{
    ViewData["Title"] = "Danh sách học bổng";

    Dictionary<string, string> RouteTrang(int trang)
    {
        var d = new Dictionary<string, string> { ["page"] = trang.ToString(), ["sort"] = Model.Sort };
        if (!string.IsNullOrWhiteSpace(Model.Keyword)) d["keyword"] = Model.Keyword!;
        if (Model.MaDonViTaiTro.HasValue) d["maDonViTaiTro"] = Model.MaDonViTaiTro.Value.ToString();
        if (!string.IsNullOrEmpty(Model.BacDaoTao)) d["bacDaoTao"] = Model.BacDaoTao!;
        if (!string.IsNullOrEmpty(Model.HanNop)) d["hanNop"] = Model.HanNop!;
        if (Model.PhuHop) d["phuHop"] = "true";
        return d;
    }

    var tu = Model.TotalItems == 0 ? 0 : (Model.Page - 1) * Model.PageSize + 1;
    var den = Math.Min(Model.Page * Model.PageSize, Model.TotalItems);
}

<div class="page-hero">
    <div class="page-hero-copy">
        <h2>Chương trình học bổng</h2>
        <p>
            @if (Model.CoHoSoCaNhan)
            {
                <span>Điểm trung bình tích lũy hiện tại của bạn: <strong class="text-primary">@Model.DiemCuaToi.ToString("0.00") / 4.0</strong></span>
            }
            else
            {
                <span>Tài khoản chưa đồng bộ hồ sơ sinh viên.</span>
            }
        </p>
    </div>
</div>

<form method="get" asp-action="Index" class="uneti-filter-card">
    <div class="row g-2 align-items-end">
        <div class="col-lg-3 col-md-6">
            <label class="form-label">Từ khóa</label>
            <input type="text" name="keyword" value="@Model.Keyword" class="form-control"
                   placeholder="Tên học bổng hoặc đơn vị tài trợ..." />
        </div>
        <div class="col-lg-3 col-md-6">
            <label class="form-label">Đơn vị tài trợ</label>
            <select name="maDonViTaiTro" class="form-select">
                <option value="">Tất cả đơn vị</option>
                @foreach (var d in Model.DonViTaiTros)
                {
                    <option value="@d.MaDonViTaiTro" selected="@(Model.MaDonViTaiTro == d.MaDonViTaiTro)">@d.TenDonViTaiTro</option>
                }
            </select>
        </div>
        <div class="col-lg-2 col-md-4">
            <label class="form-label">Bậc đào tạo</label>
            <select name="bacDaoTao" class="form-select">
                <option value="">Tất cả bậc</option>
                @foreach (var b in Model.BacDaoTaos)
                {
                    <option value="@b" selected="@(Model.BacDaoTao == b)">@b</option>
                }
            </select>
        </div>
        <div class="col-lg-2 col-md-4">
            <label class="form-label">Thời hạn</label>
            <select name="hanNop" class="form-select">
                <option value="" selected="@string.IsNullOrEmpty(Model.HanNop)">Mọi thời hạn</option>
                <option value="conhan" selected="@(Model.HanNop == "conhan")">Còn hạn nộp</option>
                <option value="hethan" selected="@(Model.HanNop == "hethan")">Đã hết hạn</option>
            </select>
        </div>
        <div class="col-lg-2 col-md-4">
            <label class="form-label">Sắp xếp</label>
            <select name="sort" class="form-select">
                <option value="han_asc" selected="@(Model.Sort == "han_asc")">Hạn nộp gần nhất</option>
                <option value="han_desc" selected="@(Model.Sort == "han_desc")">Hạn nộp xa nhất</option>
                <option value="ten_asc" selected="@(Model.Sort == "ten_asc")">Tên A - Z</option>
                <option value="ten_desc" selected="@(Model.Sort == "ten_desc")">Tên Z - A</option>
                <option value="suat_desc" selected="@(Model.Sort == "suat_desc")">Số suất giảm dần</option>
                <option value="suat_asc" selected="@(Model.Sort == "suat_asc")">Số suất tăng dần</option>
            </select>
        </div>
    </div>
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3 pt-2 border-top">
        <div class="form-check mb-0">
            <input class="form-check-input" type="checkbox" name="phuHop" value="true" id="phuHop" checked="@Model.PhuHop" />
            <label class="form-check-label small fw-medium" for="phuHop">Chỉ hiển thị chương trình đủ điều kiện GPA của tôi</label>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Đặt lại</a>
            <button type="submit" class="btn btn-sm btn-primary px-3"><i class="bi bi-funnel me-1"></i> Lọc danh sách</button>
        </div>
    </div>
</form>

<div class="text-muted small mb-3">
    @if (Model.TotalItems == 0)
    {
        <span>Không tìm thấy chương trình học bổng nào phù hợp.</span>
    }
    else
    {
        <span>Hiển thị <strong>@(tu)–@(den)</strong> trên tổng số <strong>@Model.TotalItems</strong> chương trình học bổng</span>
    }
</div>

<div class="row row-cols-1 row-cols-xl-2 row-cols-xxl-3 g-3">
    @foreach (var hb in Model.Items)
    {
        string? lyDo = null;
        if (hb.ChuaDenNgay) lyDo = "Chưa đến ngày nhận hồ sơ";
        else if (hb.HetHan) lyDo = "Đã hết hạn nộp hồ sơ";
        else if (!hb.DangMo) lyDo = "Tạm ngừng nhận hồ sơ";
        else if (hb.DaNop) lyDo = "Đã nộp hồ sơ";
        else if (!hb.DuDiem) lyDo = "Chưa đạt chuẩn GPA";

        <div class="col">
            <div class="ui-card scholarship-card h-100 @(hb.HetHan ? "card-expired" : "")">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                        <h5 class="card-title mb-0">
                            <a asp-action="Details" asp-route-id="@hb.MaHocBong" class="text-decoration-none">@hb.TenHocBong</a>
                        </h5>
                        @if (hb.HetHan)
                        {
                            <span class="st st-gray flex-shrink-0">Hết hạn</span>
                        }
                        else if (hb.ChuaDenNgay)
                        {
                            <span class="st st-blue flex-shrink-0">Sắp mở</span>
                        }
                        else if (hb.SoNgayConLai <= 7)
                        {
                            <span class="st st-yellow flex-shrink-0">Còn @(hb.SoNgayConLai == 0 ? "hôm nay" : hb.SoNgayConLai + " ngày")</span>
                        }
                        else
                        {
                            <span class="st st-green flex-shrink-0">Còn hạn</span>
                        }
                    </div>
                    <div class="text-muted small mb-2">@hb.TenDonViTaiTro</div>
                    <p class="card-text small" style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">
                        @hb.MoTaHocBong
                    </p>
                    <ul class="scholarship-meta small">
                        <li class="d-flex justify-content-between">
                            <span class="text-muted">Bậc đào tạo:</span>
                            <strong>@hb.BacDaoTao</strong>
                        </li>
                        <li class="d-flex justify-content-between">
                            <span class="text-muted">GPA tối thiểu:</span>
                            <span>
                                <strong>@hb.DiemTrungBinhToiThieu.ToString("0.00")</strong>
                                @if (Model.CoHoSoCaNhan)
                                {
                                    if (hb.DuDiem) { <span class="text-success fw-semibold ms-1">(Đạt)</span> }
                                    else { <span class="text-danger fw-semibold ms-1">(Chưa đạt)</span> }
                                }
                            </span>
                        </li>
                        <li class="d-flex justify-content-between">
                            <span class="text-muted">Chỉ tiêu:</span>
                            <strong>@hb.SoSuat suất</strong>
                        </li>
                        <li class="d-flex justify-content-between">
                            <span class="text-muted">Thời hạn:</span>
                            <span>@hb.NgayBatDauNhanHoSo.ToString("dd/MM/yyyy") – <strong>@hb.HanNopHoSo.ToString("dd/MM/yyyy")</strong></span>
                        </li>
                    </ul>
                </div>
                <div class="card-footer bg-transparent d-flex justify-content-between align-items-center">
                    <a asp-action="Details" asp-route-id="@hb.MaHocBong" class="btn btn-sm btn-outline-secondary">Chi tiết</a>
                    @if (lyDo == null)
                    {
                        <a asp-controller="HoSoCuaToi" asp-action="Create" asp-route-maHocBong="@hb.MaHocBong" class="btn btn-sm btn-primary">Nộp hồ sơ</a>
                    }
                    else
                    {
                        <span class="text-muted small fw-medium">@lyDo</span>
                    }
                </div>
            </div>
        </div>
    }
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-4" aria-label="Phân trang">
        <ul class="pagination justify-content-center flex-wrap">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-all-route-data="@RouteTrang(Model.Page - 1)">« Trước</a>
            </li>
            @for (var i = 1; i <= Model.TotalPages; i++)
            {
                if (i == 1 || i == Model.TotalPages || Math.Abs(i - Model.Page) <= 2)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-all-route-data="@RouteTrang(i)">@i</a>
                    </li>
                }
                else if (Math.Abs(i - Model.Page) == 3)
                {
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                }
            }
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-all-route-data="@RouteTrang(Model.Page + 1)">Sau »</a>
            </li>
        </ul>
    </nav>
}
