@* Họ và tên: Nguyễn Phi Hùng - Mã sinh viên: 23103100148
   Nội dung thực hiện: Module 3 - chi tiết học bổng và kiểm tra khả năng nộp hồ sơ của sinh viên. *@
@using QuanLyHocBong_UNETI2_TI17A3HN.ViewModels
@model HocBongChiTietViewModel
@{
    var hb = Model.HocBong;
    ViewData["Title"] = hb.TenHocBong;
    var homNay = DateTime.Today;
    var hetHan = homNay > hb.HanNopHoSo.Date;
    var chuaDen = homNay < hb.NgayBatDauNhanHoSo.Date;
}

<div class="page-hero">
    <div class="page-hero-copy">
        <h2>@hb.TenHocBong</h2>
        <p>Đơn vị tài trợ: @(hb.DonViTaiTro?.TenDonViTaiTro ?? "Đơn vị đồng hành UNETI")</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        @if (hetHan) { <span class="st st-lg st-gray">Đã hết hạn</span> }
        else if (chuaDen) { <span class="st st-lg st-blue">Sắp mở nhận hồ sơ</span> }
        else { <span class="st st-lg st-green">Đang nhận hồ sơ</span> }
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Danh sách học bổng
        </a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="ui-card mb-3">
            <div class="ui-card-head">
                <h5>Giới thiệu chương trình học bổng</h5>
            </div>
            <div class="ui-card-body" style="white-space: pre-line;">@(string.IsNullOrWhiteSpace(hb.MoTaHocBong) ? "Chưa có mô tả chi tiết." : hb.MoTaHocBong)</div>
        </div>

        <div class="ui-card">
            <div class="ui-card-head">
                <h5>Điều kiện &amp; Tiêu chí xét duyệt</h5>
            </div>
            <div class="ui-card-body" style="white-space: pre-line;">@(string.IsNullOrWhiteSpace(hb.DieuKienXetHocBong) ? "Chưa có điều kiện cụ thể." : hb.DieuKienXetHocBong)</div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="ui-card mb-3">
            <div class="ui-card-head">
                <h5>Thông số chương trình</h5>
            </div>
            <div class="ui-card-body">
                <div class="d-flex flex-column gap-3">
                    <div>
                        <span class="field-label">Bậc đào tạo áp dụng</span>
                        <div class="field-value">@hb.BacDaoTao</div>
                    </div>
                    <div>
                        <span class="field-label">Chỉ tiêu số suất</span>
                        <div class="field-value">@hb.SoSuat suất</div>
                    </div>
                    <div>
                        <span class="field-label">Điểm trung bình tích lũy tối thiểu</span>
                        <div class="field-value accent">@hb.DiemTrungBinhToiThieu.ToString("0.00") / 4.0</div>
                    </div>
                    <div>
                        <span class="field-label">Thời gian nhận hồ sơ</span>
                        <div class="field-value">@hb.NgayBatDauNhanHoSo.ToString("dd/MM/yyyy") – @hb.HanNopHoSo.ToString("dd/MM/yyyy")</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="ui-card">
            <div class="ui-card-body">
                @if (Model.DuocNop)
                {
                    <div class="alert alert-success py-2 px-3 small mb-3">
                        Hồ sơ của bạn đáp ứng đầy đủ điều kiện để ứng tuyển chương trình này.
                    </div>
                    <a asp-controller="HoSoCuaToi" asp-action="Create" asp-route-maHocBong="@hb.MaHocBong" class="btn btn-primary w-100">
                        <i class="bi bi-send me-1"></i> Nộp hồ sơ xin học bổng
                    </a>
                }
                else
                {
                    <div class="alert alert-warning py-2 px-3 small mb-3">
                        <div class="fw-semibold mb-1">Chưa thể nộp hồ sơ:</div>
                        <ul class="mb-0 ps-3">
                            @foreach (var l in Model.LyDoKhongNop)
                            {
                                <li>
                                    @l
                                    @if (l.StartsWith("Hồ sơ cá nhân"))
                                    {
                                        <a asp-controller="HoSoCaNhan" asp-action="Edit" asp-route-returnUrl="@(Context.Request.Path.Add(Context.Request.QueryString))" class="alert-link">Cập nhật ngay</a>
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                    <button class="btn btn-outline-secondary w-100" disabled>Nộp hồ sơ xin học bổng</button>
                }
            </div>
        </div>
    </div>
</div>
