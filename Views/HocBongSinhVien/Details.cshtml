@* Họ và tên: Nguyễn Phi Hùng - Mã sinh viên: 23103100148
   Nội dung thực hiện: Module 3 - chi tiết học bổng và kiểm tra khả năng nộp hồ sơ của sinh viên. *@
@using QuanLyHocBong_UNETI2_TI17A3HN.ViewModels
@model HocBongChiTietViewModel
@{
    var hb = Model.HocBong;
    ViewData["Title"] = hb.TenHocBong;
    var homNay = DateTime.Today;
    var hetHan = homNay > hb.HanNopHoSo.Date;
    var chuaDen = homNay < hb.NgayBatDauNhanHoSo.Date;
}

<nav aria-label="breadcrumb" class="mt-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Học bổng</a></li>
        <li class="breadcrumb-item active">@hb.TenHocBong</li>
    </ol>
</nav>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h2 class="mb-1">@hb.TenHocBong</h2>
                        <div class="text-muted">Đơn vị tài trợ: @hb.DonViTaiTro?.TenDonViTaiTro</div>
                    </div>
                    @if (hetHan) { <span class="badge text-bg-secondary fs-6">Hết hạn</span> }
                    else if (chuaDen) { <span class="badge text-bg-info fs-6">Sắp mở</span> }
                    else { <span class="badge text-bg-success fs-6">Còn hạn</span> }
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header fw-semibold">Mô tả học bổng</div>
            <div class="card-body" style="white-space: pre-line;">@(string.IsNullOrWhiteSpace(hb.MoTaHocBong) ? "Chưa có mô tả." : hb.MoTaHocBong)</div>
        </div>
        <div class="card">
            <div class="card-header fw-semibold">Điều kiện xét học bổng</div>
            <div class="card-body" style="white-space: pre-line;">@(string.IsNullOrWhiteSpace(hb.DieuKienXetHocBong) ? "Chưa có điều kiện cụ thể." : hb.DieuKienXetHocBong)</div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-header fw-semibold">Thông tin chung</div>
            <div class="card-body">
                <dl class="mb-0">
                    <dt>Bậc đào tạo</dt><dd>@hb.BacDaoTao</dd>
                    <dt>Số suất</dt><dd>@hb.SoSuat</dd>
                    <dt>ĐTB tích lũy tối thiểu</dt><dd>@hb.DiemTrungBinhToiThieu.ToString("0.00")</dd>
                    <dt>Thời gian nhận hồ sơ</dt>
                    <dd class="mb-0">@hb.NgayBatDauNhanHoSo.ToString("dd/MM/yyyy") – @hb.HanNopHoSo.ToString("dd/MM/yyyy")</dd>
                </dl>
            </div>
        </div>

        @if (Model.DuocNop)
        {
            <div class="alert alert-success">Bạn đủ điều kiện nộp hồ sơ cho học bổng này.</div>
            <a asp-controller="HoSoCuaToi" asp-action="Create" asp-route-maHocBong="@hb.MaHocBong" class="btn btn-primary w-100">Nộp hồ sơ xin học bổng</a>
        }
        else
        {
            <div class="alert alert-warning mb-2">
                <div class="fw-semibold mb-1">Hiện chưa thể nộp hồ sơ:</div>
                <ul class="mb-0 ps-3">
                    @foreach (var l in Model.LyDoKhongNop)
                    {
                        <li>@l</li>
                    }
                </ul>
            </div>
            <button class="btn btn-secondary w-100" disabled>Nộp hồ sơ xin học bổng</button>
        }
    </div>
</div>
