@model QuanLyHocBong_UNETI2_TI17A3HN.ViewModels.HocBong.HocBongIndexViewModel

@{
    ViewData["Title"] = "Quản lý học bổng";
}

<section class="scholarship-list-page">
    <header class="scholarship-list-heading">
        <div>
            <h1>Quản lý học bổng</h1>
            <p>Danh sách các chương trình học bổng và thông tin tuyển chọn.</p>
        </div>
        <a class="scholarship-list-create" asp-controller="HocBong" asp-action="Create">
            <i class="bi bi-plus-lg" aria-hidden="true"></i>
            <span>Thêm học bổng</span>
        </a>
    </header>

    @if (TempData["HocBongMessage"] is string message)
    {
        var messageType = TempData["HocBongMessageType"]?.ToString() ?? "info";
        <div class="scholarship-toast is-@messageType" role="status" aria-live="polite" data-scholarship-toast>
            <span class="scholarship-toast-icon" aria-hidden="true">
                <i class="bi @(messageType == "success" ? "bi-check-circle-fill" : messageType == "error" ? "bi-x-circle-fill" : "bi-info-circle-fill")"></i>
            </span>
            <span class="scholarship-toast-message">@message</span>
            <button type="button" class="scholarship-toast-close" aria-label="Đóng thông báo">
                <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>
            <span class="scholarship-toast-progress" aria-hidden="true"></span>
        </div>
    }

    <form asp-action="Search" method="get" class="scholarship-filter-form" id="scholarship-search-form">
        <label class="scholarship-filter-search">
            <span class="visually-hidden">Tìm theo tên học bổng hoặc đơn vị tài trợ</span>
            <i class="bi bi-search" aria-hidden="true"></i>
            <input asp-for="TuKhoa" type="search" placeholder="Tìm học bổng, đơn vị tài trợ..." />
        </label>
        <label class="scholarship-filter-field">
            <span class="visually-hidden">Đơn vị tài trợ</span>
            <select asp-for="MaDonViTaiTro" asp-items="Model.DonViTaiTroOptions">
                <option value="">Tất cả đơn vị</option>
            </select>
        </label>
        <label class="scholarship-filter-field">
            <span class="visually-hidden">Bậc đào tạo</span>
            <select asp-for="BacDaoTao" asp-items="Model.BacDaoTaoOptions">
                <option value="">Tất cả bậc</option>
            </select>
        </label>
        <label class="scholarship-filter-field">
            <span class="visually-hidden">Trạng thái học bổng</span>
            <select asp-for="TrangThai" asp-items="Model.TrangThaiOptions">
                <option value="">Tất cả trạng thái</option>
            </select>
        </label>
        <label class="scholarship-filter-field scholarship-filter-score">
            <span class="visually-hidden">Điểm tối thiểu từ</span>
            <input asp-for="DiemToiThieu" type="number" min="0" max="4" step="0.01" placeholder="Điểm từ" />
        </label>
        <label class="scholarship-filter-field">
            <span class="visually-hidden">Tình trạng hạn nộp</span>
            <select asp-for="HanNop">
                <option value="">Mọi hạn nộp</option>
                <option value="con-han">Còn hạn</option>
                <option value="het-han">Hết hạn</option>
            </select>
        </label>
        <label class="scholarship-filter-field scholarship-filter-sort">
            <span class="visually-hidden">Sắp xếp danh sách</span>
            <select asp-for="SapXep">
                <option value="ma-tang">Mặc định</option>
                <option value="ten-az">Tên A - Z</option>
                <option value="ten-za">Tên Z - A</option>
                <option value="han-tang">Hạn nộp tăng</option>
                <option value="han-giam">Hạn nộp giảm</option>
                <option value="suat-tang">Số suất tăng</option>
                <option value="suat-giam">Số suất giảm</option>
            </select>
        </label>
        <a asp-action="Index" class="scholarship-filter-reset" title="Xóa tất cả bộ lọc" aria-label="Xóa tất cả bộ lọc">
            <i class="bi bi-x-lg" aria-hidden="true"></i>
        </a>
        <noscript>
            <button type="submit" class="scholarship-filter-submit">Áp dụng</button>
        </noscript>
    </form>

    <div class="scholarship-list-toolbar">
        <p class="scholarship-list-count">
            <strong>@Model.SoKetQua</strong> học bổng
        </p>
    </div>

    @if (Model.HocBongs.Any())
    {
        <div class="scholarship-table-scroll">
                <table class="scholarship-table">
                    <colgroup>
                        <col class="scholarship-column-code" />
                        <col class="scholarship-column-name" />
                        <col class="scholarship-column-sponsor" />
                        <col class="scholarship-column-slots" />
                        <col class="scholarship-column-deadline" />
                        <col class="scholarship-column-status" />
                        <col class="scholarship-column-actions" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th scope="col">Mã</th>
                            <th scope="col">Học bổng</th>
                            <th scope="col">Đơn vị tài trợ</th>
                            <th scope="col" class="is-numeric">Số suất</th>
                            <th scope="col">Hạn nộp</th>
                            <th scope="col">Trạng thái</th>
                            <th scope="col"><span class="visually-hidden">Thao tác</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.HocBongs)
                        {
                            var trangThai = item.TrangThai?.Trim() ?? string.Empty;
                            var statusClass = "is-unknown";

                            if (trangThai.Contains("nhận hồ sơ", StringComparison.OrdinalIgnoreCase)
                                || string.Equals(trangThai, "Đang mở", StringComparison.OrdinalIgnoreCase))
                            {
                                statusClass = "is-open";
                            }
                            else if (trangThai.Contains("sắp", StringComparison.OrdinalIgnoreCase)
                                || trangThai.Contains("chờ", StringComparison.OrdinalIgnoreCase)
                                || trangThai.Contains("chưa mở", StringComparison.OrdinalIgnoreCase))
                            {
                                statusClass = "is-upcoming";
                            }
                            else if (trangThai.Contains("đóng", StringComparison.OrdinalIgnoreCase)
                                || trangThai.Contains("hết hạn", StringComparison.OrdinalIgnoreCase)
                                || trangThai.Contains("kết thúc", StringComparison.OrdinalIgnoreCase))
                            {
                                statusClass = "is-closed";
                            }
                            else if (trangThai.Contains("tạm dừng", StringComparison.OrdinalIgnoreCase)
                                || trangThai.Contains("ngừng", StringComparison.OrdinalIgnoreCase))
                            {
                                statusClass = "is-paused";
                            }

                            <tr>
                                <td class="scholarship-table-code">#@item.MaHocBong</td>
                                <td class="scholarship-table-name">
                                    <a asp-action="Details" asp-route-id="@item.MaHocBong">@item.TenHocBong</a>
                                    <span>@item.BacDaoTao · Điểm tối thiểu @item.DiemTrungBinhToiThieu.ToString("0.##") / 4.0</span>
                                    @if (!string.IsNullOrWhiteSpace(item.MoTaHocBong))
                                    {
                                        <small>@item.MoTaHocBong</small>
                                    }
                                </td>
                                <td class="scholarship-table-sponsor">@(item.DonViTaiTro?.TenDonViTaiTro ?? "Chưa có đơn vị tài trợ")</td>
                                <td class="is-numeric">@item.SoSuat</td>
                                <td class="scholarship-table-deadline">@item.HanNopHoSo.ToString("dd/MM/yyyy")</td>
                                <td><span class="scholarship-list-status @statusClass">@item.TrangThai</span></td>
                                <td>
                                    <div class="scholarship-row-actions">
                                        <a asp-action="Edit" asp-route-id="@item.MaHocBong" class="scholarship-icon-action" title="Chỉnh sửa" aria-label="Chỉnh sửa @item.TenHocBong">
                                            <i class="bi bi-pencil" aria-hidden="true"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.MaHocBong" class="scholarship-icon-action is-danger" title="Xóa học bổng" aria-label="Xóa @item.TenHocBong">
                                            <i class="bi bi-trash3" aria-hidden="true"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
        </div>
    }
    else
    {
        <div class="scholarship-list-empty">
            <i class="bi bi-award" aria-hidden="true"></i>
            @if (Model.CoBoLoc)
            {
                <h2>Không tìm thấy học bổng phù hợp</h2>
                <p>Thử thay đổi từ khóa hoặc điều kiện lọc.</p>
                <a asp-action="Index" class="scholarship-empty-reset">Xóa bộ lọc</a>
            }
            else
            {
                <h2>Chưa có chương trình học bổng</h2>
                <p>Thêm chương trình đầu tiên để bắt đầu quản lý học bổng.</p>
                <a class="scholarship-list-create" asp-controller="HocBong" asp-action="Create">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i>
                    <span>Thêm học bổng</span>
                </a>
            }
        </div>
    }

    @if (Model.TongSoTrang > 1)
    {
        <nav class="mt-3" aria-label="Phân trang danh sách học bổng">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.CoTrangTruoc ? "" : "disabled")">
                    <a class="page-link" asp-action="Search" asp-route-Trang="@(Model.Trang - 1)"
                       asp-route-TuKhoa="@Model.TuKhoa" asp-route-MaDonViTaiTro="@Model.MaDonViTaiTro"
                       asp-route-BacDaoTao="@Model.BacDaoTao" asp-route-TrangThai="@Model.TrangThai"
                       asp-route-DiemToiThieu="@Model.DiemToiThieu" asp-route-HanNop="@Model.HanNop"
                       asp-route-SapXep="@Model.SapXep" aria-label="Trang trước">« Trước</a>
                </li>

                @for (var pageNumber = 1; pageNumber <= Model.TongSoTrang; pageNumber++)
                {
                    <li class="page-item @(pageNumber == Model.Trang ? "active" : "")">
                        <a class="page-link" asp-action="Search" asp-route-Trang="@pageNumber"
                           asp-route-TuKhoa="@Model.TuKhoa" asp-route-MaDonViTaiTro="@Model.MaDonViTaiTro"
                           asp-route-BacDaoTao="@Model.BacDaoTao" asp-route-TrangThai="@Model.TrangThai"
                           asp-route-DiemToiThieu="@Model.DiemToiThieu" asp-route-HanNop="@Model.HanNop"
                           asp-route-SapXep="@Model.SapXep"
                           aria-current="@(pageNumber == Model.Trang ? "page" : null)">@pageNumber</a>
                    </li>
                }

                <li class="page-item @(Model.CoTrangSau ? "" : "disabled")">
                    <a class="page-link" asp-action="Search" asp-route-Trang="@(Model.Trang + 1)"
                       asp-route-TuKhoa="@Model.TuKhoa" asp-route-MaDonViTaiTro="@Model.MaDonViTaiTro"
                       asp-route-BacDaoTao="@Model.BacDaoTao" asp-route-TrangThai="@Model.TrangThai"
                       asp-route-DiemToiThieu="@Model.DiemToiThieu" asp-route-HanNop="@Model.HanNop"
                       asp-route-SapXep="@Model.SapXep" aria-label="Trang sau">Sau »</a>
                </li>
            </ul>
            <p class="text-center text-muted">Trang @Model.Trang / @Model.TongSoTrang</p>
        </nav>
    }
</section>

@section Styles {
    <link rel="stylesheet" href="~/css/views/hocbong/index.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/views/hocbong/index.js" asp-append-version="true"></script>
    <script src="~/js/views/hocbong/notifications.js" asp-append-version="true"></script>
}
