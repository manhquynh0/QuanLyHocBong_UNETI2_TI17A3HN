@model QuanLyHocBong_UNETI2_TI17A3HN.Models.TaiKhoanFormViewModel
@{
    var editing = Model.MaTaiKhoan != 0;
    ViewData["Title"] = editing ? "Cập nhật tài khoản" : "Thêm tài khoản mới";
    var avatarInitials = string.IsNullOrWhiteSpace(Model.HoTen)
        ? "TK"
        : string.Join("", Model.HoTen.Split(' ', StringSplitOptions.RemoveEmptyEntries).TakeLast(2).Select(w => w[0])).ToUpper();
}

<div class="sponsor-page">
    <div class="page-hero">
        <div class="page-hero-copy">
            <h2>@ViewData["Title"]</h2>
            <p>Cấu hình thông tin định danh, mật khẩu, ảnh đại diện và vai trò phân quyền trên hệ thống.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Danh sách tài khoản
        </a>
    </div>

    <div class="ui-card">
        <div class="ui-card-body">
            <form asp-action="@(editing ? "Edit" : "Create")" asp-route-id="@Model.MaTaiKhoan" method="post" enctype="multipart/form-data" data-loading="true">
                <input asp-for="MaTaiKhoan" type="hidden" />
                <input asp-for="AnhDaiDien" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="d-flex flex-wrap align-items-center gap-4 pb-4 mb-4 border-bottom">
                    <div class="position-relative">
                        @if (!string.IsNullOrEmpty(Model.AnhDaiDien))
                        {
                            <img id="avatarPreviewImg" src="@Model.AnhDaiDien" alt="Avatar" class="rounded-circle border shadow-sm" style="width: 84px; height: 84px; object-fit: cover;" />
                            <div id="avatarPreviewFallback" class="rounded-circle bg-primary text-white fw-bold align-items-center justify-content-center d-none" style="width: 84px; height: 84px; font-size: 24px;">@avatarInitials</div>
                        }
                        else
                        {
                            <img id="avatarPreviewImg" src="" alt="Avatar" class="rounded-circle border shadow-sm d-none" style="width: 84px; height: 84px; object-fit: cover;" />
                            <div id="avatarPreviewFallback" class="rounded-circle bg-primary text-white fw-bold d-flex align-items-center justify-content-center" style="width: 84px; height: 84px; font-size: 24px;">@avatarInitials</div>
                        }
                    </div>
                    <div class="flex-grow-1" style="min-width: 240px;">
                        <label asp-for="AnhDaiDienUpload" class="form-label fw-semibold mb-1">Ảnh đại diện tài khoản</label>
                        <input asp-for="AnhDaiDienUpload" type="file" id="avatarUploadInput" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                        <div class="form-text">Chấp nhận JPG, JPEG, PNG, WEBP (tối đa 5MB). Ảnh sẽ tự đồng bộ lên Cloud.</div>
                        <span asp-validation-for="AnhDaiDienUpload" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="TenDangNhap" class="form-label">Tên đăng nhập <span class="text-danger">*</span></label>
                        <input asp-for="TenDangNhap" class="form-control" placeholder="Nhập mã đăng nhập" />
                        <span asp-validation-for="TenDangNhap" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="MatKhau" class="form-label">Mật khẩu @(editing ? "(để trống nếu giữ nguyên)" : "*")</label>
                        <input asp-for="MatKhau" type="password" class="form-control" placeholder="••••••••" />
                        <span asp-validation-for="MatKhau" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="HoTen" class="form-label">Họ và tên <span class="text-danger">*</span></label>
                        <input asp-for="HoTen" class="form-control" placeholder="Nhập họ và tên đầy đủ" />
                        <span asp-validation-for="HoTen" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label">Địa chỉ Email <span class="text-danger">*</span></label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="user@uneti.edu.vn" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="VaiTro" class="form-label">Vai trò phân quyền</label>
                        <select asp-for="VaiTro" class="form-select">
                            <option value="Admin">Admin</option>
                            <option value="Cán bộ học bổng">Cán bộ học bổng</option>
                            <option value="Sinh viên">Sinh viên</option>
                        </select>
                    </div>

                    <div class="col-md-6 d-flex align-items-end pb-2">
                        <div class="form-check">
                            <input asp-for="TrangThai" class="form-check-input" />
                            <label asp-for="TrangThai" class="form-check-label fw-medium">Kích hoạt tài khoản hoạt động</label>
                        </div>
                    </div>
                </div>

                <div class="form-actions mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">Hủy</a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check-lg me-1"></i> @(editing ? "Lưu thay đổi" : "Tạo tài khoản")
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('avatarUploadInput')?.addEventListener('change', function (e) {
            const file = e.target.files && e.target.files[0];
            if (!file) return;
            const img = document.getElementById('avatarPreviewImg');
            const fallback = document.getElementById('avatarPreviewFallback');
            img.src = URL.createObjectURL(file);
            img.classList.remove('d-none');
            if (fallback) {
                fallback.classList.add('d-none');
                fallback.classList.remove('d-flex');
            }
        });
    </script>
}
