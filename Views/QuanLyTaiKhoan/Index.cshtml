@model IEnumerable<QuanLyHocBong_UNETI2_TI17A3HN.Models.TaiKhoan>
@{ ViewData["Title"] = "Quản lý tài khoản"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1 class="h3">Quản lý tài khoản</h1><a asp-action="Create" class="btn btn-primary">Thêm tài khoản</a></div>
@if (TempData["Error"] is not null) { <div class="alert alert-danger">@TempData["Error"]</div> }
<div class="table-responsive"><table class="table table-striped"><thead><tr><th>Mã</th><th>Tên đăng nhập</th><th>Họ tên</th><th>Email</th><th>Vai trò</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach (var a in Model) { <tr><td>@a.MaTaiKhoan</td><td>@a.TenDangNhap</td><td>@a.HoTen</td><td>@a.Email</td><td>@a.VaiTro</td><td>@(a.TrangThai ? "Hoạt động" : "Đã khóa")</td><td><a asp-action="Edit" asp-route-id="@a.MaTaiKhoan">Sửa</a> <form asp-action="Delete" asp-route-id="@a.MaTaiKhoan" method="post" class="d-inline" onsubmit="return confirm('Xóa tài khoản này?')"><button class="btn btn-link text-danger p-0">Xóa</button></form></td></tr> }</tbody></table></div>
