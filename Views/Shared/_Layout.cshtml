<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Học bổng UNETI</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QuanLyHocBong_UNETI2_TI17A3HN.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var isDashboard = ViewContext.RouteData.Values["controller"]?.ToString() == "Home"
            && ViewContext.RouteData.Values["action"]?.ToString() == "Index";
    }

    <div class="app-shell">
        <aside class="sidebar" aria-label="Điều hướng chính">
            <a class="brand" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">
                    <i class="bi bi-mortarboard-fill"></i>
                </span>
                <span class="brand-copy">
                    <strong>Học bổng UNETI</strong>
                    <small>Cổng quản trị admin</small>
                </span>
            </a>

            <nav class="side-nav">
                <a class="nav-item @(isDashboard ? "active" : "")"
                   asp-controller="Home"
                   asp-action="Index"
                   aria-current="@(isDashboard ? "page" : null)">
                    <i class="bi bi-house-door-fill"></i>
                    <span>Trang tổng quan</span>
                </a>
                <a class="nav-item" href="#">
                    <i class="bi bi-award"></i>
                    <span>Quản lý học bổng</span>
                </a>
                <a class="nav-item" href="#">
                    <i class="bi bi-people-fill"></i>
                    <span>Quản lý sinh viên</span>
                </a>
                <a class="nav-item" href="#">
                    <i class="bi bi-file-earmark-check"></i>
                    <span>Xét duyệt hồ sơ</span>
                </a>
                <a class="nav-item" href="#">
                    <i class="bi bi-calendar-event"></i>
                    <span>Lịch phỏng vấn</span>
                </a>
                <a class="nav-item" href="#">
                    <i class="bi bi-bell"></i>
                    <span>Thông báo</span>
                </a>
                <a class="nav-item" href="#">
                    <i class="bi bi-shield-lock"></i>
                    <span>Tài khoản cán bộ</span>
                </a>
                <a class="nav-item" href="#">
                    <i class="bi bi-gear"></i>
                    <span>Cài đặt hệ thống</span>
                </a>
            </nav>

            <a class="nav-item logout-link" asp-area="" asp-controller="Home" asp-action="Index">
                <i class="bi bi-box-arrow-right"></i>
                <span>Đăng xuất</span>
            </a>
        </aside>

        <div class="workspace">
            <header class="topbar">
                <div class="topbar-user">
                    <button class="notification-button" type="button" aria-label="Thông báo">
                        <i class="bi bi-bell"></i>
                    </button>
                    <div class="user-copy">
                        <strong>Nguyễn Thị B</strong>
                        <small>Phòng CTSV - Cán bộ xét duyệt</small>
                    </div>
                    <div class="user-avatar" aria-label="Ảnh đại diện Nguyễn Thị B">B</div>
                </div>
            </header>

            <main class="page-content" role="main">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
