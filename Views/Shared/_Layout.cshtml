@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Học bổng UNETI</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme-uneti.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ui-uneti.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QuanLyHocBong_UNETI2_TI17A3HN.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
        var isDashboard = currentController == "Home" && currentAction == "Index";

        var userRole = Context.Session.GetString("VaiTro") ?? "";
        var isStudent = userRole.Equals("Sinh viên", StringComparison.OrdinalIgnoreCase)
            || userRole.StartsWith("Sinh", StringComparison.OrdinalIgnoreCase);
        var avatarUrl = Context.Session.GetString("AnhDaiDien");
        var fullName = Context.Session.GetString("HoTen") ?? "Khách";
    }

    <div class="app-shell">
        <aside class="sidebar" aria-label="Điều hướng chính">
            <a class="brand" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">
                    <i class="bi bi-mortarboard-fill"></i>
                </span>
                <span class="brand-copy">
                    <strong>Học bổng UNETI</strong>
                    <small>@(isStudent ? "Cổng thông tin sinh viên" : "Cổng quản trị xét duyệt")</small>
                </span>
            </a>

            <nav class="side-nav">
                @if (isStudent)
                {
                    <a class="nav-item @(isDashboard ? "active" : "")"
                       asp-controller="Home" asp-action="Index">
                        <i class="bi bi-house-door-fill"></i>
                        <span>Trang chủ</span>
                    </a>
                    <a class="nav-item @(currentController == "HocBong" || currentController == "HocBongSinhVien" ? "active" : "")"
                       asp-controller="HocBongSinhVien" asp-action="Index">
                        <i class="bi bi-award-fill"></i>
                        <span>Danh sách học bổng</span>
                    </a>
                    <a class="nav-item @(currentController == "HoSoHocBong" && currentAction == "HoSoCuaToi" ? "active" : "")"
                       asp-controller="HoSoHocBong" asp-action="HoSoCuaToi">
                        <i class="bi bi-folder2-open"></i>
                        <span>Hồ sơ của tôi</span>
                    </a>
                    <a class="nav-item @(currentController == "LichPhongVan" ? "active" : "")"
                       asp-controller="LichPhongVan" asp-action="Index">
                        <i class="bi bi-calendar-check"></i>
                        <span>Lịch phỏng vấn</span>
                    </a>
                    <a class="nav-item @(currentController == "KetQuaHocBong" ? "active" : "")"
                       asp-controller="KetQuaHocBong" asp-action="Index">
                        <i class="bi bi-patch-check-fill"></i>
                        <span>Kết quả học bổng</span>
                    </a>
                    <a class="nav-item @(currentController == "SinhVien" ? "active" : "")"
                       asp-controller="SinhVien" asp-action="ThongTinCaNhan">
                        <i class="bi bi-person-circle"></i>
                        <span>Thông tin cá nhân</span>
                    </a>
                }
                else
                {
                    <a class="nav-item @(isDashboard ? "active" : "")"
                       asp-controller="Home" asp-action="Index">
                        <i class="bi bi-house-door-fill"></i>
                        <span>Trang tổng quan</span>
                    </a>
                    <a class="nav-item @(currentController == "DonViTaiTro" ? "active" : "")"
                       asp-controller="DonViTaiTro" asp-action="Index">
                        <i class="bi bi-building"></i>
                        <span>Đơn vị tài trợ</span>
                    </a>
                    <a class="nav-item @(currentController == "HocBong" ? "active" : "")"
                       asp-controller="HocBong" asp-action="Index">
                        <i class="bi bi-award"></i>
                        <span>Quản lý học bổng</span>
                    </a>
                    <a class="nav-item @(currentController == "SinhVien" ? "active" : "")"
                       asp-controller="SinhVien" asp-action="Index">
                        <i class="bi bi-people-fill"></i>
                        <span>Quản lý sinh viên</span>
                    </a>
                    <a class="nav-item @(currentController == "HoSoHocBong" ? "active" : "")"
                       asp-controller="HoSoHocBong" asp-action="Index">
                        <i class="bi bi-file-earmark-check"></i>
                        <span>Xét duyệt hồ sơ</span>
                    </a>
                    <a class="nav-item @(currentController == "LichPhongVan" ? "active" : "")"
                       asp-controller="LichPhongVan" asp-action="Index">
                        <i class="bi bi-calendar-event"></i>
                        <span>Lịch phỏng vấn</span>
                    </a>
                    <a class="nav-item @(currentController == "KetQuaHocBong" ? "active" : "")"
                       asp-controller="KetQuaHocBong" asp-action="Index">
                        <i class="bi bi-check2-circle"></i>
                        <span>Kết quả học bổng</span>
                    </a>
                    <a class="nav-item @(currentController == "ThongKe" ? "active" : "")"
                       asp-controller="ThongKe" asp-action="Index">
                        <i class="bi bi-bar-chart-fill"></i>
                        <span>Thống kê báo cáo</span>
                    </a>
                    @if (userRole.Equals("Admin", StringComparison.OrdinalIgnoreCase))
                    {
                        <a class="nav-item @(currentController == "QuanLyTaiKhoan" || currentController == "TaiKhoan" ? "active" : "")"
                           asp-controller="QuanLyTaiKhoan" asp-action="Index">
                            <i class="bi bi-shield-lock"></i>
                            <span>Tài khoản cán bộ</span>
                        </a>
                    }
                }
            </nav>

            @if (Context.Session.GetInt32("MaTaiKhoan") != null)
            {
                <a href="@Url.Action("DangXuat", "TaiKhoan")" class="nav-item logout-link text-decoration-none">
                    <i class="bi bi-box-arrow-left"></i>
                    <span>Đăng xuất</span>
                </a>
            }
        </aside>

        <div class="workspace">
            <header class="topbar">
                <div class="topbar-user">
                    <button class="notification-button" type="button" aria-label="Thông báo">
                        <i class="bi bi-bell"></i>
                    </button>
                    <div class="user-copy">
                        <strong>@fullName</strong>
                        <small>@(isStudent ? "Sinh viên" : (string.IsNullOrEmpty(userRole) ? "Chưa đăng nhập" : userRole))</small>
                    </div>
                    @if (!string.IsNullOrEmpty(avatarUrl))
                    {
                        <img src="@avatarUrl" alt="@fullName" class="user-avatar rounded-circle" style="width: 38px; height: 38px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="user-avatar">@(fullName.FirstOrDefault())</div>
                    }
                </div>
            </header>

            <main class="page-content" role="main">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
