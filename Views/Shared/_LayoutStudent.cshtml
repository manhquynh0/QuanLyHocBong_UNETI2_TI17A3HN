@using Microsoft.AspNetCore.Http
@{
    var userName   = Context.Session.GetString("HoTen") ?? "Sinh viên";
    var vaiTro     = Context.Session.GetString("VaiTro") ?? "Sinh viên";
    var avatarUrl  = Context.Session.GetString("AnhDaiDien");
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action     = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    string NavClass(string ctrl, string? act = null)
    {
        bool match = controller.Equals(ctrl, StringComparison.OrdinalIgnoreCase)
                  && (act == null || action.Equals(act, StringComparison.OrdinalIgnoreCase));
        return match ? "nav-item active" : "nav-item";
    }

    var initials = string.IsNullOrWhiteSpace(userName) ? "SV"
        : string.Join("", userName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .TakeLast(2).Select(w => w[0])).ToUpper();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Học bổng UNETI</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme-uneti.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ui-uneti.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
<div class="app-shell d-flex">

    <!-- ===== SIDEBAR ===== -->
    <aside class="sidebar">
        <div class="brand">
            <div class="brand-mark">
                <i class="bi bi-mortarboard-fill"></i>
            </div>
            <div class="brand-copy">
                <strong>Học bổng UNETI</strong>
                <small>Hệ thống xét duyệt</small>
            </div>
        </div>

        <nav class="side-nav">
            <a href="@Url.Action("Index", "Home")" class="@NavClass("Home", "Index")">
                <i class="bi bi-house-door"></i>
                <span>Trang chủ</span>
            </a>

            <a href="@Url.Action("Index", "HocBongSinhVien")" class="@NavClass("HocBongSinhVien")">
                <i class="bi bi-card-checklist"></i>
                <span>Danh sách học bổng</span>
            </a>

            <a href="@Url.Action("HoSoCuaToi", "HoSoHocBong")" class="@NavClass("HoSoHocBong", "HoSoCuaToi") @NavClass("HoSoCuaToi")">
                <i class="bi bi-folder2-open"></i>
                <span>Hồ sơ của tôi</span>
            </a>

            <a href="@Url.Action("Index", "LichPhongVan")" class="@NavClass("LichPhongVan")">
                <i class="bi bi-calendar-check"></i>
                <span>Lịch phỏng vấn</span>
            </a>

            <a href="@Url.Action("Index", "KetQuaHocBong")" class="@NavClass("KetQuaHocBong")">
                <i class="bi bi-patch-check"></i>
                <span>Kết quả học bổng</span>
            </a>

            <a href="@Url.Action("ThongTinCaNhan", "SinhVien")" class="@NavClass("SinhVien", "ThongTinCaNhan") @NavClass("HoSoCaNhan")">
                <i class="bi bi-person"></i>
                <span>Tài khoản</span>
            </a>
        </nav>

        <a href="@Url.Action("DangXuat", "TaiKhoan")" class="nav-item logout-link">
            <i class="bi bi-box-arrow-left"></i>
            <span>Đăng xuất</span>
        </a>
    </aside>

    <!-- ===== MAIN WORKSPACE ===== -->
    <div class="workspace">

        <!-- TOPBAR -->
        <header class="topbar">
            <h1 class="topbar-title me-auto">@(ViewData["Title"] ?? "Danh sách học bổng")</h1>
            <div class="topbar-user">
                <a href="@Url.Action("Index", "HocBongSinhVien")" class="notification-button" title="Thông báo học bổng">
                    <i class="bi bi-bell"></i>
                </a>
                <a href="@Url.Action("ThongTinCaNhan", "SinhVien")" class="d-flex align-items-center gap-2 text-decoration-none">
                    <div class="user-copy">
                        <strong>@userName</strong>
                        <small>@vaiTro</small>
                    </div>
                    @if (!string.IsNullOrEmpty(avatarUrl))
                    {
                        <img src="@avatarUrl" alt="@userName" class="user-avatar rounded-circle" style="width: 38px; height: 38px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="user-avatar">@initials</div>
                    }
                </a>
            </div>
        </header>

        <!-- PAGE CONTENT -->
        <main class="page-content" role="main">
            @RenderBody()
        </main>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
