@model QuanLyHocBong_UNETI2_TI17A3HN.Models.DonViTaiTro
@{
    var editing = Model.MaDonViTaiTro != 0;
    ViewData["Title"] = editing ? "Cập nhật đơn vị tài trợ" : "Thêm đơn vị tài trợ";
}

<div class="sponsor-page" style="max-width: 780px;">
    <div class="page-hero">
        <div class="page-hero-copy">
            <h2>@ViewData["Title"]</h2>
            <p>Khai báo thông tin đối tác và quỹ đồng hành học bổng UNETI.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Danh sách đơn vị
        </a>
    </div>

    <div class="ui-card">
        <div class="ui-card-body">
            <form asp-action="@(editing ? "Edit" : "Create")" asp-route-id="@Model.MaDonViTaiTro" method="post">
                <input asp-for="MaDonViTaiTro" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="row g-3">
                    <div class="col-md-7">
                        <label asp-for="TenDonViTaiTro" class="form-label">Tên đơn vị tài trợ <span class="text-danger">*</span></label>
                        <input asp-for="TenDonViTaiTro" class="form-control" placeholder="Ví dụ: Tập đoàn Viễn thông Quân đội Viettel" />
                        <span asp-validation-for="TenDonViTaiTro" class="text-danger small"></span>
                    </div>

                    <div class="col-md-5">
                        <label asp-for="EmailLienHe" class="form-label">Email đại diện liên hệ</label>
                        <input asp-for="EmailLienHe" class="form-control" placeholder="contact@partner.vn" />
                        <span asp-validation-for="EmailLienHe" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="MoTa" class="form-label">Giới thiệu & lĩnh vực hợp tác</label>
                        <textarea asp-for="MoTa" class="form-control" rows="4" placeholder="Mô tả ngắn gọn về quỹ tài trợ, đối tượng ưu tiên hoặc thỏa thuận hợp tác với nhà trường..."></textarea>
                    </div>

                    <div class="col-12">
                        <div class="form-check">
                            <input asp-for="TrangThai" class="form-check-input" />
                            <label asp-for="TrangThai" class="form-check-label fw-medium">Đơn vị đang hợp tác hoạt động</label>
                        </div>
                    </div>
                </div>

                <div class="form-actions mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">Hủy</a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check-lg me-1"></i> @(editing ? "Lưu thay đổi" : "Thêm đơn vị tài trợ")
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
