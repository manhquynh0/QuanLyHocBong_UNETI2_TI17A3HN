@model QuanLyHocBong_UNETI2_TI17A3HN.Models.SinhVien
@{
    ViewData["Title"] = "Cập nhật hồ sơ sinh viên";
}

<div class="sponsor-page" style="max-width: 840px;">
    <div class="page-hero">
        <div class="page-hero-copy">
            <h2>Cập nhật sinh viên #@Model.MaSinhVien</h2>
            <p>Chỉnh sửa thông tin cá nhân, điểm GPA tích lũy và trạng thái học tập.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Danh sách sinh viên
        </a>
    </div>

    <div class="ui-card">
        <div class="ui-card-body">
            <form asp-action="Edit" asp-route-id="@Model.MaSinhVien" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>
                <input type="hidden" asp-for="MaSinhVien" />
                <input type="hidden" asp-for="MaTaiKhoan" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="HoTen" class="form-label">Họ và tên <span class="text-danger">*</span></label>
                        <input asp-for="HoTen" class="form-control" required />
                        <span asp-validation-for="HoTen" class="text-danger small"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="NgaySinh" class="form-label">Ngày sinh <span class="text-danger">*</span></label>
                        <input asp-for="NgaySinh" type="date" class="form-control" required />
                        <span asp-validation-for="NgaySinh" class="text-danger small"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="GioiTinh" class="form-label">Giới tính <span class="text-danger">*</span></label>
                        <select asp-for="GioiTinh" class="form-select">
                            <option value="Nam">Nam</option>
                            <option value="Nữ">Nữ</option>
                            <option value="Khác">Khác</option>
                        </select>
                        <span asp-validation-for="GioiTinh" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label">Email <span class="text-danger">*</span></label>
                        <input asp-for="Email" type="email" class="form-control" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="SoDienThoai" class="form-label">Số điện thoại <span class="text-danger">*</span></label>
                        <input asp-for="SoDienThoai" class="form-control" required />
                        <span asp-validation-for="SoDienThoai" class="text-danger small"></span>
                    </div>
                    <div class="col-md-12">
                        <label asp-for="DiaChi" class="form-label">Địa chỉ</label>
                        <input asp-for="DiaChi" class="form-control" />
                        <span asp-validation-for="DiaChi" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="BacDaoTao" class="form-label">Bậc đào tạo <span class="text-danger">*</span></label>
                        <select asp-for="BacDaoTao" class="form-select">
                            <option value="Đại học">Đại học</option>
                            <option value="Cao đẳng">Cao đẳng</option>
                        </select>
                        <span asp-validation-for="BacDaoTao" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Nganh" class="form-label">Chuyên ngành <span class="text-danger">*</span></label>
                        <input asp-for="Nganh" class="form-control" required />
                        <span asp-validation-for="Nganh" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="DiemTrungBinhTichLuy" class="form-label">Điểm GPA tích lũy (hệ 4) <span class="text-danger">*</span></label>
                        <input asp-for="DiemTrungBinhTichLuy" type="number" step="0.01" min="0" max="4" class="form-control" required />
                        <span asp-validation-for="DiemTrungBinhTichLuy" class="text-danger small"></span>
                    </div>
                    <div class="col-md-8">
                        <label asp-for="ThanhTichHocTap" class="form-label">Thành tích học tập</label>
                        <textarea asp-for="ThanhTichHocTap" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="ThanhTichHocTap" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="TrangThai" class="form-label">Trạng thái <span class="text-danger">*</span></label>
                        <select asp-for="TrangThai" class="form-select">
                            <option value="Đang học">Đang học</option>
                            <option value="Hoạt động">Hoạt động</option>
                            <option value="Bảo lưu">Bảo lưu</option>
                            <option value="Đã tốt nghiệp">Đã tốt nghiệp</option>
                        </select>
                        <span asp-validation-for="TrangThai" class="text-danger small"></span>
                    </div>
                </div>

                <div class="form-actions mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">Hủy</a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check-lg me-1"></i> Lưu thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
