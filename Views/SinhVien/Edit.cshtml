@model QuanLyHocBong_UNETI2_TI17A3HN.Models.SinhVien
@{
    ViewData["Title"] = "Cập nhật hồ sơ sinh viên";
}

<div class="container-fluid py-2" style="max-width: 820px;">
    <div class="mb-3">
        <a asp-action="Index" class="text-decoration-none small text-secondary">
            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách sinh viên
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white py-3 border-bottom">
            <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-pencil-square text-primary me-2"></i>Cập nhật sinh viên #@Model.MaSinhVien</h5>
        </div>
        <div class="card-body p-4">
            <form asp-action="Edit" asp-route-id="@Model.MaSinhVien" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="MaSinhVien" />
                <input type="hidden" asp-for="MaTaiKhoan" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold small">Họ và tên</label>
                        <input asp-for="HoTen" class="form-control" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold small">Ngày sinh</label>
                        <input asp-for="NgaySinh" type="date" class="form-control" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold small">Giới tính</label>
                        <select asp-for="GioiTinh" class="form-select">
                            <option value="Nam">Nam</option>
                            <option value="Nữ">Nữ</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold small">Email</label>
                        <input asp-for="Email" type="email" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold small">Số điện thoại</label>
                        <input asp-for="SoDienThoai" class="form-control" required />
                    </div>
                    <div class="col-md-12">
                        <label class="form-label fw-semibold small">Địa chỉ</label>
                        <input asp-for="DiaChi" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Bậc đào tạo</label>
                        <input asp-for="BacDaoTao" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Chuyên ngành</label>
                        <input asp-for="Nganh" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Điểm GPA tích lũy</label>
                        <input asp-for="DiemTrungBinhTichLuy" type="number" step="0.01" min="0" max="4" class="form-control" required />
                    </div>
                    <div class="col-md-8">
                        <label class="form-label fw-semibold small">Thành tích học tập</label>
                        <input asp-for="ThanhTichHocTap" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Trạng thái</label>
                        <select asp-for="TrangThai" class="form-select">
                            <option value="Đang học">Đang học</option>
                            <option value="Hoạt động">Hoạt động</option>
                            <option value="Bảo lưu">Bảo lưu</option>
                            <option value="Đã tốt nghiệp">Đã tốt nghiệp</option>
                        </select>
                    </div>
                </div>

                <div class="mt-4 d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-light">Hủy</a>
                    <button type="submit" class="btn btn-primary fw-semibold">Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>

