@model QuanLyHocBong_UNETI2_TI17A3HN.Models.SinhVien
@{
    ViewData["Title"] = "Chi tiết sinh viên";
}

<div class="sponsor-page" style="max-width: 860px;">
    <div class="page-hero">
        <div class="page-hero-copy">
            <h2>@Model.HoTen (#@Model.MaSinhVien)</h2>
            <p>Tài khoản: @(Model.TaiKhoan?.TenDangNhap ?? "Chưa gán") · Trạng thái: @Model.TrangThai</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.MaSinhVien" class="btn btn-primary btn-sm">
                <i class="bi bi-pencil me-1"></i> Chỉnh sửa
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Danh sách
            </a>
        </div>
    </div>

    <div class="ui-card">
        <div class="ui-card-head">
            <h5>Thông tin định danh &amp; Học tập</h5>
            <span class="st st-green">GPA: @Model.DiemTrungBinhTichLuy.ToString("0.00") / 4.0</span>
        </div>
        <div class="ui-card-body">
            <div class="info-grid">
                <div>
                    <span class="field-label">Ngày sinh</span>
                    <div class="field-value">@Model.NgaySinh.ToString("dd/MM/yyyy")</div>
                </div>
                <div>
                    <span class="field-label">Giới tính</span>
                    <div class="field-value">@Model.GioiTinh</div>
                </div>
                <div>
                    <span class="field-label">Số điện thoại</span>
                    <div class="field-value">@Model.SoDienThoai</div>
                </div>
                <div>
                    <span class="field-label">Email</span>
                    <div class="field-value">@Model.Email</div>
                </div>
                <div>
                    <span class="field-label">Chuyên ngành</span>
                    <div class="field-value">@Model.Nganh</div>
                </div>
                <div>
                    <span class="field-label">Bậc đào tạo</span>
                    <div class="field-value">@Model.BacDaoTao</div>
                </div>
                <div class="grid-span-2" style="grid-column: 1 / -1;">
                    <span class="field-label">Địa chỉ liên hệ</span>
                    <div class="field-value fw-normal">@(string.IsNullOrWhiteSpace(Model.DiaChi) ? "Chưa cập nhật" : Model.DiaChi)</div>
                </div>
                <div class="grid-span-2" style="grid-column: 1 / -1;">
                    <span class="field-label">Thành tích học tập</span>
                    <div class="field-value fw-normal" style="white-space: pre-line;">@(string.IsNullOrWhiteSpace(Model.ThanhTichHocTap) ? "Chưa cập nhật" : Model.ThanhTichHocTap)</div>
                </div>
            </div>
        </div>
    </div>
</div>
