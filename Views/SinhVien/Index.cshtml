@model IEnumerable<QuanLyHocBong_UNETI2_TI17A3HN.Models.SinhVien>
@{
    ViewData["Title"] = "Quản lý hồ sơ sinh viên";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<div class="page-hero">
    <div class="page-hero-copy">
        <h2>Hồ sơ sinh viên</h2>
        <p>Quản lý dữ liệu học tập, điểm GPA tích lũy và tài khoản đăng nhập sinh viên UNETI.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-person-plus me-1"></i> Thêm sinh viên mới
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<form method="get" class="uneti-filter-card">
    <div class="row g-2 align-items-end">
        <div class="col-md-5">
            <label class="form-label">Từ khóa tìm kiếm</label>
            <input type="text" name="searchString" value="@ViewBag.CurrentSearch" class="form-control" placeholder="Tìm theo họ tên, email, SĐT hoặc mã đăng nhập..." />
        </div>
        <div class="col-md-3">
            <label class="form-label">Chuyên ngành</label>
            <input type="text" name="nganhFilter" value="@ViewBag.CurrentNganh" class="form-control" placeholder="Lọc theo ngành học..." />
        </div>
        <div class="col-md-2">
            <label class="form-label">Bậc đào tạo</label>
            <select name="bacDaoTaoFilter" class="form-select">
                <option value="">Tất cả bậc</option>
                <option value="Đại học" selected="@(ViewBag.CurrentBac == "Đại học")">Đại học</option>
                <option value="Cao đẳng" selected="@(ViewBag.CurrentBac == "Cao đẳng")">Cao đẳng</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100"><i class="bi bi-funnel me-1"></i>Lọc</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Xóa</a>
        </div>
    </div>
</form>

<div class="ui-card">
    <div class="table-responsive border-0">
        <table class="ui-table">
            <thead>
                <tr>
                    <th style="width: 80px;">Mã SV</th>
                    <th style="min-width: 190px;">Họ và tên</th>
                    <th style="width: 110px;">Tài khoản</th>
                    <th style="min-width: 180px;">Chuyên ngành &amp; Bậc</th>
                    <th style="width: 115px;">GPA (Hệ 4)</th>
                    <th style="width: 120px;">Trạng thái</th>
                    <th class="text-end" style="width: 190px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold text-primary text-nowrap" style="font-variant-numeric: tabular-nums;">#@item.MaSinhVien</td>
                        <td class="text-nowrap">
                            <div class="fw-semibold text-dark">@item.HoTen</div>
                            <small class="text-muted">@item.Email · @item.SoDienThoai</small>
                        </td>
                        <td class="text-nowrap"><code>@(item.TaiKhoan?.TenDangNhap ?? "N/A")</code></td>
                        <td class="text-nowrap">
                            <div class="fw-medium">@item.Nganh</div>
                            <small class="text-muted">@item.BacDaoTao</small>
                        </td>
                        <td class="text-nowrap" style="font-variant-numeric: tabular-nums;">
                            <span class="st @(item.DiemTrungBinhTichLuy >= 3.2m ? "st-green" : "st-blue")">@item.DiemTrungBinhTichLuy.ToString("0.00")</span>
                        </td>
                        <td class="text-nowrap"><span class="st st-gray">@item.TrangThai</span></td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@item.MaSinhVien" class="btn btn-sm btn-outline-secondary">Chi tiết</a>
                            <a asp-action="Edit" asp-route-id="@item.MaSinhVien" class="btn btn-sm btn-outline-primary">Sửa</a>
                            <form asp-action="Delete" asp-route-id="@item.MaSinhVien" method="post" class="d-inline" onsubmit="return confirm('Xóa sinh viên này?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (totalPages > 1)
{
    <nav class="mt-4" aria-label="Phân trang danh sách sinh viên">
        <ul class="pagination justify-content-center">
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-searchString="@ViewBag.CurrentSearch" asp-route-nganhFilter="@ViewBag.CurrentNganh" asp-route-bacDaoTaoFilter="@ViewBag.CurrentBac">« Trước</a>
            </li>
            @for (int p = 1; p <= totalPages; p++)
            {
                <li class="page-item @(p == currentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-searchString="@ViewBag.CurrentSearch" asp-route-nganhFilter="@ViewBag.CurrentNganh" asp-route-bacDaoTaoFilter="@ViewBag.CurrentBac">@p</a>
                </li>
            }
            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-searchString="@ViewBag.CurrentSearch" asp-route-nganhFilter="@ViewBag.CurrentNganh" asp-route-bacDaoTaoFilter="@ViewBag.CurrentBac">Sau »</a>
            </li>
        </ul>
    </nav>
}
