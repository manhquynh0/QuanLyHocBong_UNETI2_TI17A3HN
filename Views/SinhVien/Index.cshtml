@model IEnumerable<QuanLyHocBong_UNETI2_TI17A3HN.Models.SinhVien>
@{
    ViewData["Title"] = "Quản lý sinh viên";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold mb-1 text-dark">Danh sách hồ sơ sinh viên</h4>
        <small class="text-muted">Quản lý thông tin học tập, điểm GPA và tài khoản đăng nhập sinh viên</small>
    </div>
    <a asp-action="Create" class="btn btn-primary fw-semibold">
        <i class="bi bi-person-plus-fill me-1"></i> Thêm sinh viên mới
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show small" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show small" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card border-0 shadow-sm rounded-3 mb-3">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <input type="text" name="searchString" value="@ViewBag.CurrentSearch" class="form-control form-control-sm" placeholder="Tìm theo họ tên, email, SĐT hoặc username..." />
            </div>
            <div class="col-md-3">
                <input type="text" name="nganhFilter" value="@ViewBag.CurrentNganh" class="form-control form-control-sm" placeholder="Lọc theo ngành học..." />
            </div>
            <div class="col-md-2">
                <select name="bacDaoTaoFilter" class="form-select form-select-sm">
                    <option value="">-- Bậc đào tạo --</option>
                    <option value="Đại học" selected="@(ViewBag.CurrentBac == "Đại học")">Đại học</option>
                    <option value="Cao đẳng" selected="@(ViewBag.CurrentBac == "Cao đẳng")">Cao đẳng</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-sm btn-primary w-100"><i class="bi bi-search me-1"></i>Lọc</button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Xóa</a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-secondary">
                    <tr>
                        <th class="ps-4">Mã SV</th>
                        <th>Họ và tên</th>
                        <th>Tài khoản</th>
                        <th>Ngành / Bậc</th>
                        <th>GPA (Hệ 4)</th>
                        <th>Trạng thái</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-primary">#@item.MaSinhVien</td>
                            <td>
                                <div class="fw-semibold text-dark">@item.HoTen</div>
                                <small class="text-muted">@item.Email | @item.SoDienThoai</small>
                            </td>
                            <td><code>@(item.TaiKhoan?.TenDangNhap ?? "N/A")</code></td>
                            <td>
                                <div>@item.Nganh</div>
                                <small class="text-muted">@item.BacDaoTao</small>
                            </td>
                            <td><span class="badge bg-success">@item.DiemTrungBinhTichLuy.ToString("0.00")</span></td>
                            <td><span class="badge bg-info-subtle text-info border border-info-subtle">@item.TrangThai</span></td>
                            <td class="text-end pe-4">
                                <div class="d-flex justify-content-end gap-1">
                                    <a asp-action="Details" asp-route-id="@item.MaSinhVien" class="btn btn-sm btn-outline-secondary">Chi tiết</a>
                                    <a asp-action="Edit" asp-route-id="@item.MaSinhVien" class="btn btn-sm btn-outline-primary">Sửa</a>
                                    <form asp-action="Delete" asp-route-id="@item.MaSinhVien" method="post" onsubmit="return confirm('Xóa sinh viên này?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

