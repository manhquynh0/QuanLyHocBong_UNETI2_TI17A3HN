@model QuanLyHocBong_UNETI2_TI17A3HN.Models.ViewModels.SinhVienCreateViewModel
@{
    ViewData["Title"] = "Thêm sinh viên mới";
}

<div class="container-fluid py-2" style="max-width: 820px;">
    <div class="mb-3">
        <a asp-action="Index" class="text-decoration-none small text-secondary">
            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách sinh viên
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white py-3 border-bottom">
            <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-person-plus-fill text-primary me-2"></i>Thêm hồ sơ & tài khoản sinh viên</h5>
        </div>
        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="TenDangNhap" class="form-label fw-semibold small"></label>
                        <input asp-for="TenDangNhap" class="form-control" required />
                        <span asp-validation-for="TenDangNhap" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="MatKhau" class="form-label fw-semibold small"></label>
                        <input asp-for="MatKhau" type="text" class="form-control" required />
                        <span asp-validation-for="MatKhau" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="HoTen" class="form-label fw-semibold small"></label>
                        <input asp-for="HoTen" class="form-control" required />
                        <span asp-validation-for="HoTen" class="text-danger small"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="NgaySinh" class="form-label fw-semibold small"></label>
                        <input asp-for="NgaySinh" type="date" class="form-control" required />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="GioiTinh" class="form-label fw-semibold small"></label>
                        <select asp-for="GioiTinh" class="form-select">
                            <option value="Nam">Nam</option>
                            <option value="Nữ">Nữ</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-semibold small"></label>
                        <input asp-for="Email" type="email" class="form-control" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="SoDienThoai" class="form-label fw-semibold small"></label>
                        <input asp-for="SoDienThoai" class="form-control" required />
                        <span asp-validation-for="SoDienThoai" class="text-danger small"></span>
                    </div>
                    <div class="col-md-12">
                        <label asp-for="DiaChi" class="form-label fw-semibold small"></label>
                        <input asp-for="DiaChi" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="BacDaoTao" class="form-label fw-semibold small"></label>
                        <select asp-for="BacDaoTao" class="form-select">
                            <option value="Đại học">Đại học</option>
                            <option value="Cao đẳng">Cao đẳng</option>
                        </select>
                    </div>
                    <div class="col-md-5">
                        <label asp-for="Nganh" class="form-label fw-semibold small"></label>
                        <input asp-for="Nganh" class="form-control" required />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="DiemTrungBinhTichLuy" class="form-label fw-semibold small"></label>
                        <input asp-for="DiemTrungBinhTichLuy" type="number" step="0.01" min="0" max="4" class="form-control" required />
                    </div>
                    <div class="col-md-12">
                        <label asp-for="ThanhTichHocTap" class="form-label fw-semibold small"></label>
                        <textarea asp-for="ThanhTichHocTap" class="form-control" rows="2"></textarea>
                    </div>
                </div>

                <div class="mt-4 d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-light">Hủy</a>
                    <button type="submit" class="btn btn-primary fw-semibold">Lưu sinh viên</button>
                </div>
            </form>
        </div>
    </div>
</div>

