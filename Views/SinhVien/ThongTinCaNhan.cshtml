@model QuanLyHocBong_UNETI2_TI17A3HN.Models.SinhVien
@{
    ViewData["Title"] = "Thông tin cá nhân sinh viên";
    var avatarUrl = !string.IsNullOrEmpty(Model.AnhDaiDien) ? Model.AnhDaiDien : Context.Session.GetString("AnhDaiDien");
}

<div class="sponsor-page" style="max-width: 840px;">
    <div class="page-hero">
        <div class="page-hero-copy">
            <h2>Thông tin cá nhân sinh viên</h2>
            <p>Cập nhật ảnh đại diện, thông tin liên hệ và kết quả học tập phục vụ xét duyệt học bổng.</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="ui-card">
        <div class="ui-card-body">
            <form asp-action="CapNhatHoSo" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="MaSinhVien" />
                <input type="hidden" asp-for="MaTaiKhoan" />
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="TrangThai" />

                <!-- AVATAR SECTION -->
                <div class="d-flex align-items-center gap-3 pb-3 mb-3 border-bottom">
                    <div class="position-relative">
                        @if (!string.IsNullOrEmpty(avatarUrl))
                        {
                            <img id="avatarPreview" src="@avatarUrl" alt="@Model.HoTen" class="rounded-circle border" style="width: 76px; height: 76px; object-fit: cover;" />
                        }
                        else
                        {
                            <div id="avatarFallback" class="avatar-lg m-0" style="width: 76px; height: 76px; font-size: 26px;">
                                @(string.IsNullOrWhiteSpace(Model.HoTen) ? "SV" : Model.HoTen.Substring(0, 1).ToUpper())
                            </div>
                            <img id="avatarPreview" src="" alt="@Model.HoTen" class="rounded-circle border d-none" style="width: 76px; height: 76px; object-fit: cover;" />
                        }
                    </div>
                    <div class="flex-grow-1">
                        <label class="form-label mb-1">Ảnh đại diện</label>
                        <input type="file" name="AnhDaiDienUpload" id="inputAvatar" class="form-control form-control-sm" accept="image/png, image/jpeg, image/jpg, image/webp" />
                        <small class="text-muted">Định dạng JPG, PNG hoặc WEBP (tối đa 5MB)</small>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Họ và tên</label>
                        <input asp-for="HoTen" class="form-control" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Ngày sinh</label>
                        <input asp-for="NgaySinh" type="date" class="form-control" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Giới tính</label>
                        <select asp-for="GioiTinh" class="form-select">
                            <option value="Nam">Nam</option>
                            <option value="Nữ">Nữ</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Email</label>
                        <input value="@Model.Email" class="form-control bg-light" readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Số điện thoại</label>
                        <input asp-for="SoDienThoai" class="form-control" required />
                    </div>
                    <div class="col-md-12">
                        <label class="form-label">Địa chỉ</label>
                        <input asp-for="DiaChi" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Bậc đào tạo</label>
                        <input asp-for="BacDaoTao" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Chuyên ngành</label>
                        <input asp-for="Nganh" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Điểm GPA tích lũy (Hệ 4)</label>
                        <input asp-for="DiemTrungBinhTichLuy" type="number" step="0.01" min="0" max="4" class="form-control" required />
                    </div>
                    <div class="col-md-12">
                        <label class="form-label">Thành tích học tập &amp; Hoạt động ngoại khóa</label>
                        <textarea asp-for="ThanhTichHocTap" class="form-control" rows="3" required></textarea>
                    </div>
                </div>

                <div class="form-actions mt-4 pt-3 border-top">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check-lg me-1"></i> Lưu thông tin cá nhân
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const inputAvatar = document.getElementById('inputAvatar');
        const preview = document.getElementById('avatarPreview');
        const fallback = document.getElementById('avatarFallback');

        if (inputAvatar) {
            inputAvatar.addEventListener('change', function () {
                const file = this.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        preview.src = e.target.result;
                        preview.classList.remove('d-none');
                        if (fallback) fallback.classList.add('d-none');
                    }
                    reader.readAsDataURL(file);
                }
            });
        }
    </script>
}
