@* Họ và tên: Phan Sỹ Tú
   Mã sinh viên: 23103100145
   Nội dung thực hiện: Module 4 - View chi tiết hồ sơ,
   so sánh điều kiện và hiển thị số suất. *@

@model QuanLyHocBong_UNETI2_TI17A3HN.ViewModels.HoSoChiTietViewModel

@{
    ViewData["Title"] = "Chi tiết hồ sơ #" + Model.MaHoSoHocBong;

    // Tỷ lệ suất đã cấp (0–100)
    double tyLeDaCap = Model.SoSuat > 0
        ? Math.Min(100, Math.Round(Model.SoDaCap * 100.0 / Model.SoSuat))
        : 0;

    // Màu trạng thái (đồng bộ với trang danh sách)
    string StatusClass(string? tt) => tt switch
    {
        "Chờ duyệt" => "status-warning",
        "Đạt xét duyệt sơ bộ" => "status-success",
        "Không đạt xét duyệt sơ bộ" => "status-danger",
        "Đã hủy" => "status-secondary",
        "Được cấp học bổng" => "status-primary",
        _ => "status-info"
    };

    // Hiển thị giá trị trống bằng chữ mờ
    Microsoft.AspNetCore.Html.IHtmlContent Empty(string text) =>
        new Microsoft.AspNetCore.Html.HtmlString($"<span class=\"value-empty\">{text}</span>");
}

@section Styles {
    <link rel="stylesheet" href="~/css/HoSoHocBong/details.css" asp-append-version="true" />
}

<div class="container-fluid py-0 ui-font detail-page">

    <!-- ===== TIÊU ĐỀ TRANG ===== -->
    <div class="page-head">
        <div class="page-head-main">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-action="Index">Danh sách hồ sơ</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Chi tiết</li>
                </ol>
            </nav>
            <div class="page-title-row">
                <h1 class="page-title">@ViewData["Title"]</h1>
                <span class="status-text @StatusClass(Model.TrangThai)">
                    <span class="status-dot"></span>@Model.TrangThai
                </span>
            </div>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>Quay lại
        </a>
    </div>

    <!-- ===== THÔNG BÁO ===== -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible border-start border-success border-4 mb-3">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible border-start border-danger border-4 mb-3">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">

        <!-- ================= CỘT TRÁI ================= -->
        <div class="col-lg-8">

            <!-- Thông tin hồ sơ -->
            <section class="custom-card">
                <header class="custom-card-header">
                    <span class="icon-chip chip-primary"><i class="bi bi-file-earmark-text"></i></span>
                    Thông tin hồ sơ
                </header>
                <div class="data-group">
                    <div class="data-row">
                        <div class="data-label">Mã hồ sơ</div>
                        <div class="data-value fw-semibold">#@Model.MaHoSoHocBong</div>
                    </div>
                    <div class="data-row">
                        <div class="data-label">Ngày nộp</div>
                        <div class="data-value">@Model.NgayNop.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                    <div class="data-row">
                        <div class="data-label">Ngày xử lý</div>
                        <div class="data-value">
                            @if (Model.NgayXuLy.HasValue)
                            {
                                @Model.NgayXuLy.Value.ToString("dd/MM/yyyy HH:mm")
                            }
                            else
                            {
                                @Empty("Chưa xử lý")
                            }
                        </div>
                    </div>
                    <div class="data-row">
                        <div class="data-label">Nhận xét xét duyệt</div>
                        <div class="data-value">
                            @if (!string.IsNullOrWhiteSpace(Model.NhanXetXetDuyet))
                            {
                                @Model.NhanXetXetDuyet
                            }
                            else
                            {
                                @Empty("Chưa có")
                            }
                        </div>
                    </div>
                    <div class="data-row">
                        <div class="data-label">Tài liệu đính kèm</div>
                        <div class="data-value">
                            @if (!string.IsNullOrEmpty(Model.FileMinhChung))
                            {
                                <a href="@Model.FileMinhChung" target="_blank" rel="noopener" class="file-link">
                                    <i class="bi bi-paperclip"></i> Xem tài liệu minh chứng
                                </a>
                            }
                            else
                            {
                                @Empty("Không có tệp đính kèm")
                            }
                        </div>
                    </div>
                </div>
            </section>

            <!-- Thông tin sinh viên -->
            <section class="custom-card">
                <header class="custom-card-header">
                    <span class="icon-chip chip-success"><i class="bi bi-person-vcard"></i></span>
                    Thông tin sinh viên
                </header>
                <div class="data-group">
                    <div class="data-row">
                        <div class="data-label">Họ tên</div>
                        <div class="data-value fw-semibold">@Model.HoTenSinhVien</div>
                    </div>
                    <div class="data-row">
                        <div class="data-label">Ngày sinh / Giới tính</div>
                        <div class="data-value">@Model.NgaySinh.ToString("dd/MM/yyyy") &nbsp;·&nbsp; @Model.GioiTinh
                        </div>
                    </div>
                    <div class="data-row">
                        <div class="data-label">Số điện thoại</div>
                        <div class="data-value">@Model.SoDienThoai</div>
                    </div>
                    <div class="data-row">
                        <div class="data-label">Email</div>
                        <div class="data-value">@Model.EmailSinhVien</div>
                    </div>
                    <div class="data-row">
                        <div class="data-label">Địa chỉ</div>
                        <div class="data-value">
                            @if (!string.IsNullOrWhiteSpace(Model.DiaChi))
                            {
                                @Model.DiaChi
                            }
                            else
                            {

                                @Empty("Không có")
                            }
                        </div>
                    </div>
                    <div class="data-row">
                        <div class="data-label">Bậc đào tạo / Ngành</div>
                        <div class="data-value">@Model.BacDaoTaoSinhVien &nbsp;·&nbsp; @Model.Nganh</div>
                    </div>
                    <div class="data-row">
                        <div class="data-label">Điểm TB tích lũy</div>
                        <div class="data-value">
                            <span class="score-value @(Model.DuDiem ? "text-success" : "text-danger")">
                                @Model.DiemTrungBinhTichLuy.ToString("0.00")
                            </span>
                        </div>
                    </div>
                    <div class="data-row">
                        <div class="data-label">Thành tích</div>
                        <div class="data-value">
                            @if (!string.IsNullOrWhiteSpace(Model.ThanhTichHocTap))
                            {
                                @Model.ThanhTichHocTap
                            }
                            else
                            {
                                @Empty("Không có")
                            }
                        </div>
                    </div>
                </div>
            </section>

            <!-- Thông tin học bổng -->
            <section class="custom-card">
                <header class="custom-card-header">
                    <span class="icon-chip chip-warning"><i class="bi bi-award"></i></span>
                    Thông tin học bổng
                </header>
                <div class="data-group">
                    <div class="data-row">
                        <div class="data-label">Tên học bổng</div>
                        <div class="data-value fw-semibold">@Model.TenHocBong</div>
                    </div>
                    <div class="data-row">
                        <div class="data-label">Đơn vị tài trợ</div>
                        <div class="data-value">@Model.TenDonViTaiTro</div>
                    </div>
                    <div class="data-row">
                        <div class="data-label">Số suất / Bậc đào tạo</div>
                        <div class="data-value">@Model.SoSuat suất &nbsp;·&nbsp; @Model.BacDaoTaoHocBong</div>
                    </div>
                    <div class="data-row">
                        <div class="data-label">Điểm TB tối thiểu</div>
                        <div class="data-value">@Model.DiemTrungBinhToiThieu.ToString("0.00")</div>
                    </div>
                    <div class="data-row">
                        <div class="data-label">Thời gian nhận hồ sơ</div>
                        <div class="data-value">
                            @Model.NgayBatDauNhanHoSo.ToString("dd/MM/yyyy") – @Model.HanNopHoSo.ToString("dd/MM/yyyy")
                        </div>
                    </div>
                    <div class="data-row">
                        <div class="data-label">Điều kiện xét</div>
                        <div class="data-value">
                            @if (!string.IsNullOrWhiteSpace(Model.DieuKienXetHocBong))
                            {
                                @Model.DieuKienXetHocBong
                            }
                            else
                            {

                                @Empty("Không có")
                            }
                        </div>
                    </div>
                </div>
            </section>

            <!-- Nội dung sinh viên gửi -->
            <section class="custom-card">
                <header class="custom-card-header">
                    <span class="icon-chip chip-primary"><i class="bi bi-journal-text"></i></span>
                    Nội dung sinh viên gửi
                </header>
                <div class="content-body">
                    <div class="content-block">
                        <div class="content-label">Thư xin học bổng</div>
                        @if (!string.IsNullOrWhiteSpace(Model.ThuXinHocBong))
                        {
                            <div class="letter-box">@Model.ThuXinHocBong</div>
                        }
                        else
                        {
                            @Empty("Không có")
                        }
                    </div>
                    <div class="content-block">
                        <div class="content-label">Ghi chú</div>
                        @if (!string.IsNullOrWhiteSpace(Model.GhiChu))
                        {
                            <div class="note-text">@Model.GhiChu</div>
                        }
                        else
                        {
                            @Empty("Không có ghi chú")
                        }
                    </div>
                </div>
            </section>
        </div>

        <!-- ================= CỘT PHẢI ================= -->
        <div class="col-lg-4">

            <!-- Thao tác -->
            <section class="custom-card">
                <header class="custom-card-header">
                    <span class="icon-chip chip-primary"><i class="bi bi-lightning-charge"></i></span>
                    Thao tác
                </header>
                <div class="side-body d-grid gap-2">
                    @if (Model.CoTheXetDuyet)
                    {
                        <a asp-action="XetDuyetSoBo" asp-route-id="@Model.MaHoSoHocBong" class="btn btn-success btn-action">
                            <i class="bi bi-check-circle me-2"></i>Xét duyệt sơ bộ
                        </a>
                    }
                    else if (Model.TrangThai == "Đạt xét duyệt sơ bộ")
                    {
                        <a asp-controller="LichPhongVan" asp-action="Create" asp-route-maHoSo="@Model.MaHoSoHocBong"
                           class="btn btn-primary btn-action">
                            <i class="bi bi-calendar-plus me-2"></i>Lập lịch phỏng vấn
                        </a>
                    }
                    else if (Model.TrangThai == "Đã phỏng vấn")
                    {
                        <a asp-controller="KetQuaHocBong" asp-action="NhapKetQua" asp-route-maHoSo="@Model.MaHoSoHocBong"
                           class="btn btn-warning btn-action">
                            <i class="bi bi-award me-2"></i>Nhập kết quả cuối
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-secondary btn-action" disabled>
                            Không có thao tác khả dụng
                        </button>
                    }
                </div>
            </section>

            <!-- Đối chiếu điều kiện -->
            <section class="custom-card">
                <header class="custom-card-header">
                    <span class="icon-chip chip-primary"><i class="bi bi-shield-check"></i></span>
                    Đối chiếu điều kiện
                </header>
                <div class="side-body">
                    <div class="check-row">
                        <span class="check-icon @(Model.DuDiem ? "ok" : "fail")">
                            <i class="bi @(Model.DuDiem ? "bi-check-lg" : "bi-x-lg")"></i>
                        </span>
                        <div class="check-info">
                            <div class="check-title">Điểm TB tích lũy</div>
                            <div class="check-sub">
                                @Model.DiemTrungBinhTichLuy.ToString("0.00") / yêu cầu ≥
                                @Model.DiemTrungBinhToiThieu.ToString("0.00")
                            </div>
                        </div>
                        <span class="check-result @(Model.DuDiem ? "ok" : "fail")">@(Model.DuDiem ? "Đạt" : "Không đạt")</span>
                    </div>

                    <div class="check-row">
                        <span class="check-icon @(Model.DungBacDaoTao ? "ok" : "fail")">
                            <i class="bi @(Model.DungBacDaoTao ? "bi-check-lg" : "bi-x-lg")"></i>
                        </span>
                        <div class="check-info">
                            <div class="check-title">Bậc đào tạo</div>
                            <div class="check-sub">@Model.BacDaoTaoSinhVien / yêu cầu @Model.BacDaoTaoHocBong</div>
                        </div>
                        <span class="check-result @(Model.DungBacDaoTao ? "ok" : "fail")">@(Model.DungBacDaoTao ? "Khớp"            : "Sai bậc")</span>
                    </div>

                    <div class="note-box">
                        Việc đạt hay không do cán bộ học bổng quyết định. Hệ thống không tự suy diễn kết quả.
                    </div>
                </div>
            </section>

            <!-- Tiến độ cấp suất -->
            <section class="custom-card">
                <header class="custom-card-header">
                    <span class="icon-chip chip-primary"><i class="bi bi-pie-chart"></i></span>
                    Tiến độ cấp suất
                </header>
                <div class="side-body">
                    <div class="quota-grid">
                        <div class="quota-item">
                            <div class="quota-label">Tổng</div>
                            <div class="quota-number">@Model.SoSuat</div>
                        </div>
                        <div class="quota-item">
                            <div class="quota-label">Đã cấp</div>
                            <div class="quota-number text-primary">@Model.SoDaCap</div>
                        </div>
                        <div class="quota-item">
                            <div class="quota-label">Còn lại</div>
                            <div class="quota-number @(Model.SoSuatConLai > 0 ? "text-success" : "text-danger")">
                                @Model.SoSuatConLai</div>
                            </div>
                        </div>

                        <div class="quota-bar" role="progressbar" aria-valuenow="@tyLeDaCap" aria-valuemin="0"
                             aria-valuemax="100">
                            <div class="quota-bar-fill @(Model.DaDatSuat ? "is-full" : "")"
                                 style="width: @(tyLeDaCap.ToString("0", System.Globalization.CultureInfo.InvariantCulture))%">
                            </div>
                        </div>
                        <div class="quota-caption">Đã cấp @tyLeDaCap.ToString("0")% số suất</div>

                        @if (Model.DaDatSuat)
                        {
                            <div class="alert alert-danger border-start border-danger border-4 mb-0 mt-3">
                                <strong>Cảnh báo:</strong> học bổng đã đạt số suất tối đa.
                            </div>
                        }
                    </div>
                </section>
            </div>
        </div>
    </div>
