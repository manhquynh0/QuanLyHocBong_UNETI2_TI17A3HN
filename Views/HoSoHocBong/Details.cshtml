@* Họ và tên: Phan Sỹ Tú
   Mã sinh viên: 23103100145
   Nội dung thực hiện: Module 4 - View chi tiết hồ sơ,
   so sánh điều kiện và hiển thị số suất. *@

@model QuanLyHocBong_UNETI2_TI17A3HN.ViewModels.HoSoChiTietViewModel

@{
    ViewData["Title"] = "Chi tiết hồ sơ #" + Model.MaHoSoHocBong;
}

<h2 class="mb-3">@ViewData["Title"]</h2>

@* Thông báo *@
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    @* Cột trái: Thông tin hồ sơ + sinh viên + học bổng *@
    <div class="col-md-8">
        @* Thông tin hồ sơ *@
        <div class="card mb-3">
            <div class="card-header bg-primary text-white">
                <strong>Thông tin hồ sơ</strong>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Mã hồ sơ</dt>
                    <dd class="col-sm-8">@Model.MaHoSoHocBong</dd>

                    <dt class="col-sm-4">Ngày nộp</dt>
                    <dd class="col-sm-8">@Model.NgayNop.ToString("dd/MM/yyyy HH:mm")</dd>

                    <dt class="col-sm-4">Trạng thái</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-info text-dark">@Model.TrangThai</span>
                    </dd>

                    <dt class="col-sm-4">Ngày xử lý</dt>
                    <dd class="col-sm-8">
                        @(Model.NgayXuLy?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa xử lý")
                    </dd>

                    <dt class="col-sm-4">Nhận xét xét duyệt</dt>
                    <dd class="col-sm-8">@(Model.NhanXetXetDuyet ?? "Chưa có")</dd>

                    <dt class="col-sm-4">Thư xin học bổng</dt>
                    <dd class="col-sm-8">
                        @if (!string.IsNullOrEmpty(Model.ThuXinHocBong))
                        {
                            <div class="border p-2 bg-light">@Model.ThuXinHocBong</div>
                        }
                        else
                        {
                            <span class="text-muted">Không có</span>
                        }
                    </dd>

                    <dt class="col-sm-4">Ghi chú</dt>
                    <dd class="col-sm-8">@(Model.GhiChu ?? "Không có")</dd>
                </dl>
            </div>
        </div>

        @* Thông tin sinh viên *@
        <div class="card mb-3">
            <div class="card-header bg-success text-white">
                <strong>Thông tin sinh viên</strong>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Họ tên</dt>
                    <dd class="col-sm-8">@Model.HoTenSinhVien</dd>

                    <dt class="col-sm-4">Ngày sinh</dt>
                    <dd class="col-sm-8">@Model.NgaySinh.ToString("dd/MM/yyyy")</dd>

                    <dt class="col-sm-4">Giới tính</dt>
                    <dd class="col-sm-8">@Model.GioiTinh</dd>

                    <dt class="col-sm-4">SĐT</dt>
                    <dd class="col-sm-8">@Model.SoDienThoai</dd>

                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">@Model.EmailSinhVien</dd>

                    <dt class="col-sm-4">Địa chỉ</dt>
                    <dd class="col-sm-8">@(Model.DiaChi ?? "Không có")</dd>

                    <dt class="col-sm-4">Bậc đào tạo</dt>
                    <dd class="col-sm-8">@Model.BacDaoTaoSinhVien</dd>

                    <dt class="col-sm-4">Ngành</dt>
                    <dd class="col-sm-8">@Model.Nganh</dd>

                    <dt class="col-sm-4">Điểm TB tích lũy</dt>
                    <dd class="col-sm-8">
                        <strong>@Model.DiemTrungBinhTichLuy.ToString("0.00")</strong>
                    </dd>

                    <dt class="col-sm-4">Thành tích</dt>
                    <dd class="col-sm-8">@(Model.ThanhTichHocTap ?? "Không có")</dd>
                </dl>
            </div>
        </div>

        @* Thông tin học bổng *@
        <div class="card mb-3">
            <div class="card-header bg-warning text-dark">
                <strong>Thông tin học bổng</strong>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Tên học bổng</dt>
                    <dd class="col-sm-8">@Model.TenHocBong</dd>

                    <dt class="col-sm-4">Đơn vị tài trợ</dt>
                    <dd class="col-sm-8">@Model.TenDonViTaiTro</dd>

                    <dt class="col-sm-4">Số suất</dt>
                    <dd class="col-sm-8">@Model.SoSuat</dd>

                    <dt class="col-sm-4">Bậc đào tạo</dt>
                    <dd class="col-sm-8">@Model.BacDaoTaoHocBong</dd>

                    <dt class="col-sm-4">Điểm TB tối thiểu</dt>
                    <dd class="col-sm-8">@Model.DiemTrungBinhToiThieu.ToString("0.00")</dd>

                    <dt class="col-sm-4">Ngày bắt đầu nhận</dt>
                    <dd class="col-sm-8">@Model.NgayBatDauNhanHoSo.ToString("dd/MM/yyyy")</dd>

                    <dt class="col-sm-4">Hạn nộp</dt>
                    <dd class="col-sm-8">@Model.HanNopHoSo.ToString("dd/MM/yyyy")</dd>

                    <dt class="col-sm-4">Điều kiện xét</dt>
                    <dd class="col-sm-8">@(Model.DieuKienXetHocBong ?? "Không có")</dd>
                </dl>
            </div>
        </div>
    </div>

    @* Cột phải: So sánh điều kiện + số suất + thao tác *@
    <div class="col-md-4">
        @* So sánh điều kiện *@
        <div class="card mb-3">
            <div class="card-header">
                <strong>Kiểm tra điều kiện</strong>
            </div>
            <div class="card-body">
                <p>
                    <strong>Điểm TB:</strong>
                    @if (Model.DuDiem)
                    {
                        <span class="badge bg-success">Đủ</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Không đủ</span>
                    }
                    <br />
                    <small class="text-muted">
                        SV: @Model.DiemTrungBinhTichLuy.ToString("0.00") /
                        Yêu cầu: @Model.DiemTrungBinhToiThieu.ToString("0.00")
                    </small>
                </p>
                <p>
                    <strong>Bậc đào tạo:</strong>
                    @if (Model.DungBacDaoTao)
                    {
                        <span class="badge bg-success">Khớp</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Không khớp</span>
                    }
                    <br />
                    <small class="text-muted">
                        SV: @Model.BacDaoTaoSinhVien / HB: @Model.BacDaoTaoHocBong
                    </small>
                </p>
                <div class="alert alert-info mb-0">
                    <small>
                        <strong>Lưu ý:</strong> Việc đạt hay không do Cán bộ học bổng quyết định.
                        Hệ thống không tự suy diễn kết quả.
                    </small>
                </div>
            </div>
        </div>

        @* Số suất *@
        <div class="card mb-3">
            <div class="card-header">
                <strong>Số suất học bổng</strong>
            </div>
            <div class="card-body">
                <p><strong>Tổng số suất:</strong> @Model.SoSuat</p>
                <p><strong>Đã cấp:</strong> @Model.SoDaCap</p>
                <p>
                    <strong>Còn lại:</strong>
                    <span class="badge @(Model.SoSuatConLai > 0 ? "bg-success" : "bg-danger")">
                        @Model.SoSuatConLai
                    </span>
                </p>
                @if (Model.DaDatSuat)
                {
                    <div class="alert alert-warning mb-0">
                        <strong>Cảnh báo:</strong> Học bổng đã đạt số suất tối đa!
                    </div>
                }
            </div>
        </div>

        @* Thao tác *@
        <div class="card">
            <div class="card-header">
                <strong>Thao tác</strong>
            </div>
            <div class="card-body d-grid gap-2">
                @if (Model.CoTheXetDuyet)
                {
                    <a asp-action="XetDuyetSoBo" asp-route-id="@Model.MaHoSoHocBong" class="btn btn-success">
                        <i class="bi bi-check-circle"></i> Xét duyệt sơ bộ
                    </a>
                }
                else if (Model.TrangThai == "Đạt xét duyệt sơ bộ") { <a asp-controller="LichPhongVan" asp-action="Create" asp-route-maHoSo="@Model.MaHoSoHocBong" class="btn btn-primary"><i class="bi bi-calendar-plus"></i> Lập lịch phỏng vấn</a> } else if (Model.TrangThai == "Đã phỏng vấn") { <a asp-controller="KetQuaHocBong" asp-action="NhapKetQua" asp-route-maHoSo="@Model.MaHoSoHocBong" class="btn btn-warning"><i class="bi bi-award"></i> Nhập kết quả cuối cùng</a> } else {
                    <button class="btn btn-secondary" disabled>
                        Không thể xét duyệt (trạng thái: @Model.TrangThai)
                    </button>
                }

                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Quay lại danh sách
                </a>
            </div>
        </div>
    </div>
</div>