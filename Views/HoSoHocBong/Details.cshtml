@* Họ và tên: Phan Sỹ Tú
   Mã sinh viên: 23103100145
   Nội dung thực hiện: Module 4 - View chi tiết hồ sơ,
   so sánh điều kiện và hiển thị số suất. *@

@model QuanLyHocBong_UNETI2_TI17A3HN.ViewModels.HoSoChiTietViewModel

@{
    ViewData["Title"] = "Chi tiết hồ sơ #" + Model.MaHoSoHocBong;
}

<div class="page-hero">
    <div class="page-hero-copy">
        <h2>Hồ sơ ứng tuyển #@Model.MaHoSoHocBong</h2>
        <p>@Model.HoTenSinhVien · @Model.TenHocBong</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <partial name="_TrangThaiBadge" model="@Model.TrangThai" />
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Danh sách hồ sơ
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-3">
    <!-- Cột trái: Thông tin hồ sơ + sinh viên + học bổng -->
    <div class="col-lg-8">
        <!-- Thông tin hồ sơ -->
        <div class="ui-card mb-3">
            <div class="ui-card-head">
                <h5>Thông tin hồ sơ ứng tuyển</h5>
                <span class="text-muted small">Nộp lúc @Model.NgayNop.ToString("dd/MM/yyyy HH:mm")</span>
            </div>
            <div class="ui-card-body">
                <div class="info-grid mb-3">
                    <div>
                        <span class="field-label">Mã hồ sơ</span>
                        <div class="field-value">#@Model.MaHoSoHocBong</div>
                    </div>
                    <div>
                        <span class="field-label">Ngày xử lý</span>
                        <div class="field-value">@(Model.NgayXuLy?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa xử lý")</div>
                    </div>
                    <div>
                        <span class="field-label">Nhận xét sơ duyệt</span>
                        <div class="field-value">@(Model.NhanXetXetDuyet ?? "Chưa có")</div>
                    </div>
                </div>

                <div class="mb-3">
                    <span class="field-label">Thư xin học bổng</span>
                    @if (!string.IsNullOrEmpty(Model.ThuXinHocBong))
                    {
                        <div class="p-3 rounded-3 border bg-light mt-1" style="white-space: pre-line;">@Model.ThuXinHocBong</div>
                    }
                    else
                    {
                        <div class="text-muted small">Không có</div>
                    }
                </div>

                <div class="mb-3">
                    <span class="field-label">Ghi chú bổ sung</span>
                    <div class="field-value fw-normal">@(Model.GhiChu ?? "Không có")</div>
                </div>

                <div>
                    <span class="field-label mb-2">Tài liệu minh chứng đính kèm</span>
                    @if (Model.TaiLieus != null && Model.TaiLieus.Any())
                    {
                        <div class="d-flex flex-column gap-2">
                            @foreach (var t in Model.TaiLieus)
                            {
                                <div class="d-flex justify-content-between align-items-center p-2 px-3 rounded-3 border bg-white">
                                    <div>
                                        <i class="bi @(t.LaPdf ? "bi-file-earmark-pdf text-danger" : "bi-file-earmark-image text-primary") me-1"></i>
                                        <strong style="word-break:break-all;">@t.TenFileGoc</strong>
                                        <div class="small text-muted">
                                            @t.LoaiTaiLieu · @t.DungLuongHienThi · @t.NgayTai.ToString("dd/MM/yyyy HH:mm")
                                        </div>
                                    </div>
                                    <div class="text-nowrap ms-2">
                                        <a asp-controller="TaiLieuHoSo" asp-action="Xem" asp-route-id="@t.MaTaiLieu" target="_blank" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-eye me-1"></i>Xem
                                        </a>
                                        <a asp-controller="TaiLieuHoSo" asp-action="Tai" asp-route-id="@t.MaTaiLieu" class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-download me-1"></i>Tải
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(Model.FileMinhChung))
                    {
                        <a href="@Model.FileMinhChung" target="_blank" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-file-earmark-arrow-down me-1"></i> Xem tài liệu minh chứng
                        </a>
                    }
                    else
                    {
                        <span class="text-muted small">Không có tệp đính kèm</span>
                    }
                </div>
            </div>
        </div>

        <!-- Thông tin sinh viên -->
        <div class="ui-card mb-3">
            <div class="ui-card-head">
                <h5>Hồ sơ học tập của ứng viên</h5>
            </div>
            <div class="ui-card-body">
                <div class="info-grid">
                    <div>
                        <span class="field-label">Họ và tên</span>
                        <div class="field-value">@Model.HoTenSinhVien</div>
                    </div>
                    <div>
                        <span class="field-label">Ngày sinh & Giới tính</span>
                        <div class="field-value">@Model.NgaySinh.ToString("dd/MM/yyyy") · @Model.GioiTinh</div>
                    </div>
                    <div>
                        <span class="field-label">Số điện thoại</span>
                        <div class="field-value">@Model.SoDienThoai</div>
                    </div>
                    <div>
                        <span class="field-label">Email</span>
                        <div class="field-value">@Model.EmailSinhVien</div>
                    </div>
                    <div>
                        <span class="field-label">Chuyên ngành & Bậc</span>
                        <div class="field-value">@Model.Nganh (@Model.BacDaoTaoSinhVien)</div>
                    </div>
                    <div>
                        <span class="field-label">GPA tích lũy</span>
                        <div class="field-value accent">@Model.DiemTrungBinhTichLuy.ToString("0.00") / 4.0</div>
                    </div>
                    <div class="grid-span-2" style="grid-column: 1 / -1;">
                        <span class="field-label">Địa chỉ</span>
                        <div class="field-value fw-normal">@(Model.DiaChi ?? "Không có")</div>
                    </div>
                    <div class="grid-span-2" style="grid-column: 1 / -1;">
                        <span class="field-label">Thành tích học tập</span>
                        <div class="field-value fw-normal">@(Model.ThanhTichHocTap ?? "Không có")</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Thông tin học bổng -->
        <div class="ui-card">
            <div class="ui-card-head">
                <h5>Chương trình học bổng đăng ký</h5>
            </div>
            <div class="ui-card-body">
                <div class="info-grid">
                    <div class="grid-span-2">
                        <span class="field-label">Tên học bổng</span>
                        <div class="field-value">@Model.TenHocBong</div>
                    </div>
                    <div>
                        <span class="field-label">Đơn vị tài trợ</span>
                        <div class="field-value">@Model.TenDonViTaiTro</div>
                    </div>
                    <div>
                        <span class="field-label">Bậc đào tạo yêu cầu</span>
                        <div class="field-value">@Model.BacDaoTaoHocBong</div>
                    </div>
                    <div>
                        <span class="field-label">GPA tối thiểu</span>
                        <div class="field-value">@Model.DiemTrungBinhToiThieu.ToString("0.00") / 4.0</div>
                    </div>
                    <div>
                        <span class="field-label">Thời hạn nhận hồ sơ</span>
                        <div class="field-value">@Model.NgayBatDauNhanHoSo.ToString("dd/MM/yyyy") – @Model.HanNopHoSo.ToString("dd/MM/yyyy")</div>
                    </div>
                    <div class="grid-span-2" style="grid-column: 1 / -1;">
                        <span class="field-label">Điều kiện xét học bổng</span>
                        <div class="field-value fw-normal" style="white-space: pre-line;">@(Model.DieuKienXetHocBong ?? "Không có")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Cột phải: Đối chiếu điều kiện + Chỉ tiêu + Thao tác -->
    <div class="col-lg-4">
        <div class="ui-card mb-3">
            <div class="ui-card-head">
                <h5>Đối chiếu tiêu chí</h5>
            </div>
            <div class="ui-card-body">
                <div class="d-flex justify-content-between align-items-center pb-3 mb-3 border-bottom">
                    <div>
                        <div class="fw-semibold text-dark">Điểm trung bình tích lũy</div>
                        <small class="text-muted">Ứng viên: @Model.DiemTrungBinhTichLuy.ToString("0.00") / Chuẩn: @Model.DiemTrungBinhToiThieu.ToString("0.00")</small>
                    </div>
                    <span class="st @(Model.DuDiem ? "st-green" : "st-red")">
                        @(Model.DuDiem ? "Đạt chuẩn" : "Chưa đạt")
                    </span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <div class="fw-semibold text-dark">Bậc đào tạo</div>
                        <small class="text-muted">Ứng viên: @Model.BacDaoTaoSinhVien / Chuẩn: @Model.BacDaoTaoHocBong</small>
                    </div>
                    <span class="st @(Model.DungBacDaoTao ? "st-green" : "st-red")">
                        @(Model.DungBacDaoTao ? "Phù hợp" : "Lệch bậc")
                    </span>
                </div>

                <div class="alert alert-info mb-0 py-2 px-3 small">
                    <strong>Lưu ý nghiệp vụ:</strong> Kết quả thẩm định sơ bộ do Cán bộ học bổng quyết định dựa trên hồ sơ và minh chứng thực tế.
                </div>
            </div>
        </div>

        <div class="ui-card mb-3">
            <div class="ui-card-head">
                <h5>Chỉ tiêu học bổng</h5>
            </div>
            <div class="ui-card-body">
                <div class="info-grid">
                    <div>
                        <span class="field-label">Tổng suất</span>
                        <div class="field-value">@Model.SoSuat</div>
                    </div>
                    <div>
                        <span class="field-label">Đã cấp</span>
                        <div class="field-value">@Model.SoDaCap</div>
                    </div>
                    <div>
                        <span class="field-label">Còn lại</span>
                        <div class="field-value @(Model.SoSuatConLai > 0 ? "text-success" : "text-danger")">@Model.SoSuatConLai</div>
                    </div>
                </div>
                @if (Model.DaDatSuat)
                {
                    <div class="alert alert-warning mt-3 mb-0 py-2 px-3 small">
                        <strong>Cảnh báo:</strong> Chương trình đã đạt đủ chỉ tiêu số suất!
                    </div>
                }
            </div>
        </div>

        <div class="ui-card">
            <div class="ui-card-head">
                <h5>Quyết định điều hành</h5>
            </div>
            <div class="ui-card-body d-grid gap-2">
                @if (Model.CoTheXetDuyet)
                {
                    <a asp-action="XetDuyetSoBo" asp-route-id="@Model.MaHoSoHocBong" class="btn btn-primary">
                        <i class="bi bi-check2-circle me-1"></i> Thẩm định sơ bộ hồ sơ
                    </a>
                }
                else if (Model.TrangThai == "Đạt xét duyệt sơ bộ")
                {
                    <a asp-controller="LichPhongVan" asp-action="Create" asp-route-maHoSo="@Model.MaHoSoHocBong" class="btn btn-primary">
                        <i class="bi bi-calendar-plus me-1"></i> Lập lịch phỏng vấn
                    </a>
                }
                else if (Model.TrangThai == "Đã phỏng vấn")
                {
                    <a asp-controller="KetQuaHocBong" asp-action="NhapKetQua" asp-route-maHoSo="@Model.MaHoSoHocBong" class="btn btn-primary">
                        <i class="bi bi-award me-1"></i> Công bố kết quả cuối cùng
                    </a>
                }
                else
                {
                    <button class="btn btn-outline-secondary" disabled>
                        Trạng thái hiện tại: @Model.TrangThai
                    </button>
                }

                <a asp-action="Index" class="btn btn-outline-secondary">
                    Quay lại danh sách hồ sơ
                </a>
            </div>
        </div>
    </div>
</div>
