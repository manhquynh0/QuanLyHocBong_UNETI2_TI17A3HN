@model IEnumerable<QuanLyHocBong_UNETI2_TI17A3HN.Models.HoSoHocBong>
@{
    ViewData["Title"] = "Hồ sơ xét học bổng của tôi";
}

<div class="page-hero">
    <div class="page-hero-copy">
        <h2>Hồ sơ học bổng đã nộp</h2>
        <p>Theo dõi tiến độ xét duyệt sơ bộ, lịch phỏng vấn và kết quả học bổng.</p>
    </div>
    <a asp-controller="HocBongSinhVien" asp-action="Index" class="btn btn-primary">
        <i class="bi bi-award me-1"></i> Tìm chương trình học bổng
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="ui-card">
    <div class="table-responsive border-0">
        <table class="ui-table">
            <thead>
                <tr>
                    <th>Mã HS</th>
                    <th>Chương trình học bổng</th>
                    <th>Ngày nộp</th>
                    <th>Trạng thái</th>
                    <th>Lịch phỏng vấn</th>
                    <th>Kết quả</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="empty-state">
                            Bạn chưa nộp hồ sơ học bổng nào.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        var pv = item.LichPhongVans?.OrderByDescending(l => l.ThoiGianBatDau).FirstOrDefault();
                        <tr>
                            <td class="fw-bold text-primary" style="font-variant-numeric: tabular-nums;">#@item.MaHoSoHocBong</td>
                            <td>
                                <div class="fw-semibold text-dark">@item.HocBong?.TenHocBong</div>
                                <small class="text-muted">@item.HocBong?.DonViTaiTro?.TenDonViTaiTro</small>
                            </td>
                            <td class="small text-muted" style="font-variant-numeric: tabular-nums;">@item.NgayNop.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <partial name="_TrangThaiBadge" model="@item.TrangThai" />
                            </td>
                            <td class="small">
                                @if (pv != null)
                                {
                                    <div><strong>@pv.ThoiGianBatDau.ToString("dd/MM/yyyy HH:mm")</strong></div>
                                    <span class="text-muted">@pv.DiaDiemHoacLienKet</span>
                                }
                                else
                                {
                                    <span class="text-muted">Chưa xếp lịch</span>
                                }
                            </td>
                            <td>
                                @if (item.KetQuaHocBong != null)
                                {
                                    <span class="fw-semibold @(item.KetQuaHocBong.KetQua == "Được cấp học bổng" ? "text-success" : "text-danger")">
                                        @item.KetQuaHocBong.KetQua (@item.KetQuaHocBong.DiemDanhGia đ)
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted small">Chưa công bố</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                @if (!string.IsNullOrEmpty(item.FileMinhChung))
                                {
                                    <a href="@item.FileMinhChung" target="_blank" class="btn btn-sm btn-outline-secondary" title="Xem file minh chứng">
                                        <i class="bi bi-paperclip"></i>
                                    </a>
                                }
                                <a asp-controller="HoSoCuaToi" asp-action="Details" asp-route-id="@item.MaHoSoHocBong" class="btn btn-sm btn-outline-secondary">
                                    Chi tiết
                                </a>
                                @if (item.TrangThai == "Chờ duyệt")
                                {
                                    <form asp-action="HuyHoSo" asp-route-id="@item.MaHoSoHocBong" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn hủy hồ sơ này?');" class="d-inline m-0">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Hủy</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
