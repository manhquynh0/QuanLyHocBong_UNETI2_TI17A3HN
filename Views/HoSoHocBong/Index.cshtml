@* Họ và tên: Phan Sỹ Tú
   Mã sinh viên: 23103100145
   Nội dung thực hiện: Module 4 - View danh sách hồ sơ,
   tìm kiếm, lọc, sắp xếp và phân trang. *@

@model QuanLyHocBong_UNETI2_TI17A3HN.ViewModels.HoSoFilterViewModel

@{
    ViewData["Title"] = "Xét duyệt hồ sơ học bổng";
    var danhSachTrangThai = QuanLyHocBong_UNETI2_TI17A3HN.Constants.TrangThaiHoSo.TatCa;
}

<div class="page-hero">
    <div class="page-hero-copy">
        <h2>Xét duyệt hồ sơ học bổng</h2>
        <p>Tra cứu, đối chiếu tiêu chí học thuật và thẩm định sơ bộ hồ sơ sinh viên gửi lên hệ thống.</p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Bộ lọc tìm kiếm -->
<form method="get" asp-action="Index" class="uneti-filter-card">
    <div class="row g-2 align-items-end">
        <div class="col-lg-3 col-md-6">
            <label class="form-label">Từ khóa</label>
            <input type="text" name="TuKhoa" value="@Model.TuKhoa" class="form-control"
                   placeholder="Tên sinh viên hoặc học bổng..." />
        </div>
        <div class="col-lg-2 col-md-6">
            <label class="form-label">Đơn vị tài trợ</label>
            <select name="MaDonViTaiTro" class="form-select"
                    asp-items="@(ViewBag.DonViTaiTro as Microsoft.AspNetCore.Mvc.Rendering.SelectList)">
                <option value="">Tất cả đơn vị</option>
            </select>
        </div>
        <div class="col-lg-2 col-md-4">
            <label class="form-label">Trạng thái</label>
            <select name="TrangThai" class="form-select">
                <option value="">Tất cả trạng thái</option>
                @foreach (var tt in danhSachTrangThai)
                {
                    <option value="@tt" selected="@(Model.TrangThai == tt)">@tt</option>
                }
            </select>
        </div>
        <div class="col-lg-2 col-md-4">
            <label class="form-label">Từ ngày nộp</label>
            <input type="date" name="TuNgay" value="@(Model.TuNgay?.ToString("yyyy-MM-dd"))" class="form-control" />
        </div>
        <div class="col-lg-2 col-md-4">
            <label class="form-label">Đến ngày nộp</label>
            <input type="date" name="DenNgay" value="@(Model.DenNgay?.ToString("yyyy-MM-dd"))" class="form-control" />
        </div>
        <div class="col-lg-1 col-md-12">
            <label class="form-label">Sắp xếp</label>
            <select name="SapXep" class="form-select">
                <option value="">Mới nhất</option>
                <option value="ngay_nop_asc" selected="@(Model.SapXep == "ngay_nop_asc")">Cũ nhất</option>
                <option value="ngay_nop_desc" selected="@(Model.SapXep == "ngay_nop_desc")">Mới nhất</option>
                <option value="ten_sv_asc" selected="@(Model.SapXep == "ten_sv_asc")">Tên A-Z</option>
                <option value="ten_sv_desc" selected="@(Model.SapXep == "ten_sv_desc")">Tên Z-A</option>
            </select>
        </div>
    </div>
    <div class="d-flex justify-content-end gap-2 mt-3 pt-2 border-top">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Đặt lại</a>
        <button type="submit" class="btn btn-sm btn-primary px-3">
            <i class="bi bi-funnel me-1"></i> Áp dụng bộ lọc
        </button>
    </div>
</form>

<!-- Bảng danh sách hồ sơ -->
<div class="ui-card">
    <div class="ui-card-head">
        <h5>Danh sách hồ sơ tiếp nhận</h5>
        <span class="text-muted small">Tổng cộng <strong>@Model.TongSoBanGhi</strong> hồ sơ</span>
    </div>
    <div class="p-0">
        @if (Model.DanhSach == null || !Model.DanhSach.Any())
        {
            <div class="empty-state">Không tìm thấy hồ sơ nào phù hợp với điều kiện lọc.</div>
        }
        else
        {
            <div class="table-responsive border-0">
                <table class="ui-table">
                    <thead>
                        <tr>
                            <th style="width: 72px;">Mã HS</th>
                            <th style="min-width: 150px;">Sinh viên</th>
                            <th style="min-width: 240px;">Chương trình học bổng</th>
                            <th style="width: 135px;">Ngày nộp</th>
                            <th style="width: 160px;">GPA tích lũy</th>
                            <th style="width: 110px;">Minh chứng</th>
                            <th style="width: 190px;">Trạng thái</th>
                            <th class="text-end" style="width: 165px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.DanhSach)
                        {
                            <tr>
                                <td class="fw-bold text-primary text-nowrap" style="font-variant-numeric: tabular-nums;">#@item.MaHoSoHocBong</td>
                                <td class="fw-semibold text-dark text-nowrap">@item.TenSinhVien</td>
                                <td>
                                    <div class="fw-semibold text-dark">@item.TenHocBong</div>
                                    <div class="text-muted small">@item.TenDonViTaiTro</div>
                                </td>
                                <td class="small text-muted text-nowrap" style="font-variant-numeric: tabular-nums;">
                                    @item.NgayNop.ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td class="text-nowrap" style="font-variant-numeric: tabular-nums;">
                                    <div class="d-inline-flex align-items-center gap-2">
                                        <strong class="@(item.DuDiem ? "text-success" : "text-danger")">@item.DiemTrungBinh.ToString("0.00")</strong>
                                        @if (item.DuDiem)
                                        {
                                            <span class="st st-green">Đạt chuẩn</span>
                                        }
                                        else
                                        {
                                            <span class="st st-yellow" title="Chưa đạt GPA yêu cầu (@item.DiemYeuCau.ToString("0.00"))">Dưới chuẩn</span>
                                        }
                                    </div>
                                </td>
                                <td class="text-nowrap">
                                    @if (item.SoTaiLieu > 0)
                                    {
                                        <a asp-controller="TaiLieuHoSo" asp-action="DanhSach" asp-route-id="@item.MaHoSoHocBong"
                                           class="st st-blue text-decoration-none" title="Xem danh sách tệp đính kèm">
                                            <i class="bi bi-paperclip"></i> @item.SoTaiLieu tệp
                                        </a>
                                    }
                                    else if (!string.IsNullOrEmpty(item.FileMinhChung))
                                    {
                                        <a href="@item.FileMinhChung" target="_blank" class="st st-blue text-decoration-none">
                                            <i class="bi bi-paperclip"></i> 1 tệp
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Không có</span>
                                    }
                                </td>
                                <td class="text-nowrap">
                                    <partial name="_TrangThaiBadge" model="@item.TrangThai" />
                                </td>
                                <td class="text-end text-nowrap">
                                    <a asp-action="Details" asp-route-id="@item.MaHoSoHocBong"
                                       class="btn btn-sm btn-outline-secondary">Chi tiết</a>

                                    @if (item.CoTheXetDuyet)
                                    {
                                        <a asp-action="XetDuyetSoBo" asp-route-id="@item.MaHoSoHocBong"
                                           class="btn btn-sm btn-primary ms-1">Xét duyệt</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (Model.TongSoTrang > 1)
{
    <nav class="mt-4" aria-label="Phân trang danh sách hồ sơ">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.CoTrangTruoc ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-Trang="@(Model.Trang - 1)"
                   asp-route-TuKhoa="@Model.TuKhoa" asp-route-MaDonViTaiTro="@Model.MaDonViTaiTro"
                   asp-route-TrangThai="@Model.TrangThai" asp-route-TuNgay="@Model.TuNgay?.ToString("yyyy-MM-dd")"
                   asp-route-DenNgay="@Model.DenNgay?.ToString("yyyy-MM-dd")" asp-route-SapXep="@Model.SapXep">« Trước</a>
            </li>

            @for (int i = 1; i <= Model.TongSoTrang; i++)
            {
                <li class="page-item @(i == Model.Trang ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-Trang="@i" asp-route-TuKhoa="@Model.TuKhoa"
                       asp-route-MaDonViTaiTro="@Model.MaDonViTaiTro" asp-route-TrangThai="@Model.TrangThai"
                       asp-route-TuNgay="@Model.TuNgay?.ToString("yyyy-MM-dd")"
                       asp-route-DenNgay="@Model.DenNgay?.ToString("yyyy-MM-dd")" asp-route-SapXep="@Model.SapXep">@i</a>
                </li>
            }

            <li class="page-item @(Model.CoTrangSau ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-Trang="@(Model.Trang + 1)"
                   asp-route-TuKhoa="@Model.TuKhoa" asp-route-MaDonViTaiTro="@Model.MaDonViTaiTro"
                   asp-route-TrangThai="@Model.TrangThai" asp-route-TuNgay="@Model.TuNgay?.ToString("yyyy-MM-dd")"
                   asp-route-DenNgay="@Model.DenNgay?.ToString("yyyy-MM-dd")" asp-route-SapXep="@Model.SapXep">Sau »</a>
            </li>
        </ul>
        <p class="text-center text-muted small mb-0">
            Trang @Model.Trang / @Model.TongSoTrang
        </p>
    </nav>
}
