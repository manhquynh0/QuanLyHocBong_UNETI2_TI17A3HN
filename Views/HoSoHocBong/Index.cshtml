@* Họ và tên: Phan Sỹ Tú
   Mã sinh viên: 23103100145
   Nội dung thực hiện: Module 4 - View danh sách hồ sơ,
   tìm kiếm, lọc, sắp xếp và phân trang. *@

@model QuanLyHocBong_UNETI2_TI17A3HN.ViewModels.HoSoFilterViewModel

@{
    ViewData["Title"] = "Danh sách hồ sơ học bổng";
    var danhSachTrangThai = QuanLyHocBong_UNETI2_TI17A3HN.Constants.TrangThaiHoSo.TatCa;
}

<h2 class="mb-3">@ViewData["Title"]</h2>

@* Thông báo thành công / lỗi *@
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@* Form tìm kiếm + lọc *@
<div class="card mb-3">
    <div class="card-header">
        <strong>Tìm kiếm &amp; Lọc</strong>
    </div>
    <div class="card-body">
        <form method="get" asp-action="Index">
            <div class="row g-2">
                <div class="col-md-3">
                    <label class="form-label">Từ khóa</label>
                    <input type="text" name="TuKhoa" value="@Model.TuKhoa" class="form-control"
                           placeholder="Tên SV hoặc tên học bổng" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Đơn vị tài trợ</label>
                    <select name="MaDonViTaiTro" class="form-select"
                            asp-items="@(ViewBag.DonViTaiTro as Microsoft.AspNetCore.Mvc.Rendering.SelectList)">
                        <option value="">-- Tất cả --</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Trạng thái</label>
                    <select name="TrangThai" class="form-select">
                        <option value="">-- Tất cả --</option>
                        @foreach (var tt in danhSachTrangThai)
                        {
                            if (Model.TrangThai == tt)
                            {
                                <option value="@tt" selected>@tt</option>
                            }
                            else
                            {
                                <option value="@tt">@tt</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Từ ngày nộp</label>
                    <input type="date" name="TuNgay" value="@(Model.TuNgay?.ToString("yyyy-MM-dd"))"
                           class="form-control" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Đến ngày nộp</label>
                    <input type="date" name="DenNgay" value="@(Model.DenNgay?.ToString("yyyy-MM-dd"))"
                           class="form-control" />
                </div>
                <div class="col-md-1">
                    <label class="form-label">Sắp xếp</label>
                    <select name="SapXep" class="form-select">
                        <option value="">Mặc định</option>
                        <option value="ngay_nop_asc" selected="@(Model.SapXep == "ngay_nop_asc")">Ngày nộp ↑</option>
                        <option value="ngay_nop_desc" selected="@(Model.SapXep == "ngay_nop_desc")">Ngày nộp ↓</option>
                        <option value="ten_sv_asc" selected="@(Model.SapXep == "ten_sv_asc")">Tên SV A→Z</option>
                        <option value="ten_sv_desc" selected="@(Model.SapXep == "ten_sv_desc")">Tên SV Z→A</option>
                    </select>
                </div>
            </div>
            <div class="mt-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search"></i> Tìm kiếm
                </button>
                <a asp-action="Index" class="btn btn-secondary">Xóa lọc</a>
            </div>
        </form>
    </div>
</div>

@* Bảng danh sách hồ sơ *@
<div class="card">
    <div class="card-header d-flex justify-content-between">
        <strong>Danh sách hồ sơ</strong>
        <span>Tổng: <strong>@Model.TongSoBanGhi</strong> hồ sơ</span>
    </div>
    <div class="card-body p-0">
        @if (Model.DanhSach == null || !Model.DanhSach.Any())
        {
            <div class="p-3 text-center text-muted">Không có hồ sơ nào.</div>
        }
        else
        {
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Mã HS</th>
                        <th>Sinh viên</th>
                        <th>Học bổng</th>
                        <th>Đơn vị tài trợ</th>
                        <th>Ngày nộp</th>
                        <th>Điểm TB</th>
                        <th>Đính kèm</th>
                        <th>Trạng thái</th>
                        <th style="width: 200px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.DanhSach)
                    {
                        <tr>
                            <td>@item.MaHoSoHocBong</td>
                            <td>@item.TenSinhVien</td>
                            <td>@item.TenHocBong</td>
                            <td>@item.TenDonViTaiTro</td>
                            <td>@item.NgayNop.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                @item.DiemTrungBinh.ToString("0.00")
                                @if (!item.DuDiem)
                                {
                                    <span class="badge bg-warning text-dark" title="Không đủ điểm yêu cầu (@item.DiemYeuCau)">
                                        !
                                    </span>
                                }
                            </td>
                            <td>
                                @if (item.SoTaiLieu > 0)
                                {
                                    <a asp-controller="TaiLieuHoSo" asp-action="DanhSach" asp-route-id="@item.MaHoSoHocBong"
                                       class="badge bg-primary text-decoration-none" title="Xem danh sách tệp đính kèm">
                                        <i class="bi bi-paperclip"></i> @item.SoTaiLieu tệp
                                    </a>
                                }
                                else if (!string.IsNullOrEmpty(item.FileMinhChung))
                                {
                                    <a href="@item.FileMinhChung" target="_blank" class="badge bg-primary text-decoration-none">
                                        <i class="bi bi-paperclip"></i> 1 tệp
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted small">Không có</span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-info text-dark">@item.TrangThai</span>
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.MaHoSoHocBong"
                                   class="btn btn-sm btn-outline-primary">Chi tiết</a>

                                @if (item.CoTheXetDuyet)
                                {
                                    <a asp-action="XetDuyetSoBo" asp-route-id="@item.MaHoSoHocBong"
                                       class="btn btn-sm btn-outline-success">Xét duyệt</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@* Phân trang *@
@if (Model.TongSoTrang > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @* Nút Trang trước *@
            <li class="page-item @(Model.CoTrangTruoc ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-Trang="@(Model.Trang - 1)"
                   asp-route-TuKhoa="@Model.TuKhoa" asp-route-MaDonViTaiTro="@Model.MaDonViTaiTro"
                   asp-route-TrangThai="@Model.TrangThai" asp-route-TuNgay="@Model.TuNgay?.ToString("yyyy-MM-dd")"
                   asp-route-DenNgay="@Model.DenNgay?.ToString("yyyy-MM-dd")" asp-route-SapXep="@Model.SapXep">« Trước</a>
            </li>

            @* Số trang *@
            @for (int i = 1; i <= Model.TongSoTrang; i++)
            {
                <li class="page-item @(i == Model.Trang ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-Trang="@i" asp-route-TuKhoa="@Model.TuKhoa"
                       asp-route-MaDonViTaiTro="@Model.MaDonViTaiTro" asp-route-TrangThai="@Model.TrangThai"
                       asp-route-TuNgay="@Model.TuNgay?.ToString("yyyy-MM-dd")"
                       asp-route-DenNgay="@Model.DenNgay?.ToString("yyyy-MM-dd")" asp-route-SapXep="@Model.SapXep">@i</a>
                </li>
            }

            @* Nút Trang sau *@
            <li class="page-item @(Model.CoTrangSau ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-Trang="@(Model.Trang + 1)"
                   asp-route-TuKhoa="@Model.TuKhoa" asp-route-MaDonViTaiTro="@Model.MaDonViTaiTro"
                   asp-route-TrangThai="@Model.TrangThai" asp-route-TuNgay="@Model.TuNgay?.ToString("yyyy-MM-dd")"
                   asp-route-DenNgay="@Model.DenNgay?.ToString("yyyy-MM-dd")" asp-route-SapXep="@Model.SapXep">Sau »</a>
            </li>
        </ul>
    </nav>

    <p class="text-center text-muted">
        Trang @Model.Trang / @Model.TongSoTrang
    </p>
}
