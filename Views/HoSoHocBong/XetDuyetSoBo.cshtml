@* Họ và tên: Phan Sỹ Tú
   Mã sinh viên: 23103100145
   Nội dung thực hiện: Module 4 - View form xét duyệt sơ bộ hồ sơ. *@

@model QuanLyHocBong_UNETI2_TI17A3HN.ViewModels.XetDuyetSoBoViewModel

@{
    ViewData["Title"] = "Xét duyệt sơ bộ hồ sơ #" + Model.MaHoSoHocBong;
}

<div class="page-hero">
    <div class="page-hero-copy">
        <h2>Thẩm định sơ bộ hồ sơ #@Model.MaHoSoHocBong</h2>
        <p>@Model.TenSinhVien · @Model.TenHocBong</p>
    </div>
    <a asp-action="Details" asp-route-id="@Model.MaHoSoHocBong" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Chi tiết hồ sơ
    </a>
</div>

<div class="row g-3">
    <!-- Cột trái: Thông tin đối chiếu (readonly) -->
    <div class="col-lg-7">
        <div class="ui-card mb-3">
            <div class="ui-card-head">
                <h5>Thông tin ứng tuyển & Minh chứng</h5>
                <span class="text-muted small">Nộp ngày @Model.NgayNop.ToString("dd/MM/yyyy HH:mm")</span>
            </div>
            <div class="ui-card-body">
                <div class="info-grid mb-3">
                    <div>
                        <span class="field-label">Sinh viên</span>
                        <div class="field-value">@Model.TenSinhVien</div>
                    </div>
                    <div>
                        <span class="field-label">Chương trình học bổng</span>
                        <div class="field-value">@Model.TenHocBong</div>
                    </div>
                    <div>
                        <span class="field-label">Đơn vị tài trợ</span>
                        <div class="field-value">@Model.TenDonViTaiTro</div>
                    </div>
                </div>

                <div>
                    <span class="field-label mb-2">Tài liệu minh chứng đính kèm</span>
                    @if (Model.TaiLieus != null && Model.TaiLieus.Any())
                    {
                        <div class="d-flex flex-column gap-2">
                            @foreach (var t in Model.TaiLieus)
                            {
                                <div class="d-flex justify-content-between align-items-center p-2 px-3 rounded-3 border bg-white">
                                    <div>
                                        <i class="bi @(t.LaPdf ? "bi-file-earmark-pdf text-danger" : "bi-file-earmark-image text-primary") me-1"></i>
                                        <strong style="word-break:break-all;">@t.TenFileGoc</strong>
                                        <div class="small text-muted">
                                            @t.LoaiTaiLieu · @t.DungLuongHienThi
                                        </div>
                                    </div>
                                    <div class="text-nowrap ms-2">
                                        <a asp-controller="TaiLieuHoSo" asp-action="Xem" asp-route-id="@t.MaTaiLieu" target="_blank" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-eye me-1"></i>Xem
                                        </a>
                                        <a asp-controller="TaiLieuHoSo" asp-action="Tai" asp-route-id="@t.MaTaiLieu" class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-download me-1"></i>Tải
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(Model.FileMinhChung))
                    {
                        <a href="@Model.FileMinhChung" target="_blank" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-file-earmark-arrow-down me-1"></i> Xem file minh chứng
                        </a>
                    }
                    else
                    {
                        <span class="text-muted small">Không có file đính kèm</span>
                    }
                </div>
            </div>
        </div>

        <div class="ui-card mb-3">
            <div class="ui-card-head">
                <h5>Đối chiếu tiêu chí tự động</h5>
            </div>
            <div class="ui-card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="p-3 rounded-3 border bg-light">
                            <span class="field-label">Điểm TB tích lũy</span>
                            <div class="d-flex align-items-center justify-content-between mt-1">
                                <strong class="fs-5">@Model.DiemTrungBinh.ToString("0.00") <small class="text-muted fw-normal">/ Chuẩn @Model.DiemYeuCau.ToString("0.00")</small></strong>
                                <span class="st @(Model.DuDiem ? "st-green" : "st-red")">@(Model.DuDiem ? "Đủ điểm" : "Chưa đạt")</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 rounded-3 border bg-light">
                            <span class="field-label">Bậc đào tạo</span>
                            <div class="d-flex align-items-center justify-content-between mt-1">
                                <strong class="fs-6">@Model.BacDaoTaoSinhVien <small class="text-muted fw-normal">/ @Model.BacDaoTaoHocBong</small></strong>
                                <span class="st @(Model.DungBacDaoTao ? "st-green" : "st-red")">@(Model.DungBacDaoTao ? "Khớp bậc" : "Không khớp")</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="ui-card">
            <div class="ui-card-head">
                <h5>Thư xin học bổng &amp; Thành tích học tập</h5>
            </div>
            <div class="ui-card-body">
                <div class="mb-3">
                    <span class="field-label">Thư xin học bổng</span>
                    @if (!string.IsNullOrEmpty(Model.ThuXinHocBong))
                    {
                        <div class="p-3 rounded-3 border bg-light mt-1" style="white-space: pre-line;">@Model.ThuXinHocBong</div>
                    }
                    else
                    {
                        <p class="text-muted small mb-0">Không có</p>
                    }
                </div>

                <div>
                    <span class="field-label">Thành tích học tập</span>
                    @if (!string.IsNullOrEmpty(Model.ThanhTichHocTap))
                    {
                        <div class="p-3 rounded-3 border bg-light mt-1" style="white-space: pre-line;">@Model.ThanhTichHocTap</div>
                    }
                    else
                    {
                        <p class="text-muted small mb-0">Không có</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Cột phải: Form kết luận sơ duyệt -->
    <div class="col-lg-5">
        <div class="ui-card">
            <div class="ui-card-head">
                <h5>Quyết định xét duyệt sơ bộ</h5>
            </div>
            <div class="ui-card-body">
                <form asp-action="XetDuyetSoBo" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="MaHoSoHocBong" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label class="form-label">Kết luận thẩm định sơ bộ <span class="text-danger">*</span></label>
                        <div class="d-flex flex-column gap-2 p-3 rounded-3 border bg-light">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" asp-for="KetQua" value="Dat" id="kqDat" />
                                <label class="form-check-label text-success fw-bold" for="kqDat">
                                    Đạt xét duyệt sơ bộ (Đủ điều kiện vào vòng phỏng vấn)
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" asp-for="KetQua" value="KhongDat" id="kqKhongDat" />
                                <label class="form-check-label text-danger fw-bold" for="kqKhongDat">
                                    Không đạt xét duyệt sơ bộ
                                </label>
                            </div>
                        </div>
                        <span asp-validation-for="KetQua" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="NhanXetXetDuyet" class="form-label">
                            Nhận xét của cán bộ thẩm định <span class="text-danger">*</span>
                        </label>
                        <textarea asp-for="NhanXetXetDuyet" class="form-control" rows="5"
                                  placeholder="Ghi rõ đánh giá về hồ sơ, minh chứng và lý do đạt / không đạt sơ duyệt..."></textarea>
                        <span asp-validation-for="NhanXetXetDuyet" class="text-danger small"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary"
                                onclick="return confirm('Xác nhận lưu kết quả xét duyệt sơ bộ cho hồ sơ này?');">
                            <i class="bi bi-check2-circle me-1"></i> Lưu kết quả xét duyệt
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.MaHoSoHocBong" class="btn btn-outline-secondary">
                            Hủy và quay lại
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
