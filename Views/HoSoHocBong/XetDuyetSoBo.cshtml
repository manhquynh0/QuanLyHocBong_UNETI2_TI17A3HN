@* Họ và tên: Phan Sỹ Tú
   Mã sinh viên: 23103100145
   Nội dung thực hiện: Module 4 - View form xét duyệt sơ bộ hồ sơ. *@

@model QuanLyHocBong_UNETI2_TI17A3HN.ViewModels.XetDuyetSoBoViewModel

@{
    ViewData["Title"] = "Xét duyệt hồ sơ #" + Model.MaHoSoHocBong;
}

@section Styles {
    <link rel="stylesheet" href="~/css/HoSoHocBong/xetduyetsobo.css" asp-append-version="true" />
}

<div class="container-fluid py-0 ui-font detail-page">

    <!-- ===== TIÊU ĐỀ TRANG ===== -->
    <div class="page-head">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-action="Index">Danh sách hồ sơ</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Xét duyệt</li>
                </ol>
            </nav>
            <h1 class="page-title">@ViewData["Title"]</h1>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>Quay lại
        </a>
    </div>

    <div class="row g-4">

        <!-- ================= CỘT TRÁI ================= -->
        <div class="col-lg-7">

            <!-- Thông tin hồ sơ & sinh viên -->
            <section class="custom-card">
                <header class="custom-card-header">
                    <span class="icon-chip chip-primary"><i class="bi bi-person-lines-fill"></i></span>
                    Thông tin hồ sơ và sinh viên
                </header>
                <div class="data-group">
                    <div class="data-row">
                        <div class="data-label">Sinh viên nộp</div>
                        <div class="data-value fw-semibold">@Model.TenSinhVien</div>
                    </div>
                    <div class="data-row">
                        <div class="data-label">Học bổng đăng ký</div>
                        <div class="data-value">@Model.TenHocBong</div>
                    </div>
                    <div class="data-row">
                        <div class="data-label">Đơn vị tài trợ</div>
                        <div class="data-value">@Model.TenDonViTaiTro</div>
                    </div>
                    <div class="data-row">
                        <div class="data-label">Ngày nộp hồ sơ</div>
                        <div class="data-value">@Model.NgayNop.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                    <div class="data-row">
                        <div class="data-label">Tài liệu đính kèm</div>
                        <div class="data-value">
                            @if (!string.IsNullOrEmpty(Model.FileMinhChung))
                            {
                                <a href="@Model.FileMinhChung" target="_blank" rel="noopener" class="file-link">
                                    <i class="bi bi-paperclip"></i> Xem file minh chứng
                                </a>
                            }
                            else
                            {
                                <span class="value-empty">Không có file</span>
                            }
                        </div>
                    </div>
                </div>
            </section>

            <!-- Đối chiếu điều kiện -->
            <section class="custom-card">
                <header class="custom-card-header">
                    <span class="icon-chip chip-primary"><i class="bi bi-shield-check"></i></span>
                    Đối chiếu điều kiện
                </header>
                <div class="side-body">
                    <div class="check-row">
                        <span class="check-icon @(Model.DuDiem ? "ok" : "fail")">
                            <i class="bi @(Model.DuDiem ? "bi-check-lg" : "bi-x-lg")"></i>
                        </span>
                        <div class="check-info">
                            <div class="check-title">Điểm TB tích lũy</div>
                            <div class="check-sub">
                                <strong
                                class="@(Model.DuDiem ? "text-success" : "text-danger")">@Model.DiemTrungBinh.ToString("0.00")</strong>
                                / yêu cầu ≥ @Model.DiemYeuCau.ToString("0.00")
                            </div>
                        </div>
                        <span class="check-result @(Model.DuDiem ? "ok" : "fail")">@(Model.DuDiem ? "Đạt" : "Không đạt")</span>
                    </div>

                    <div class="check-row">
                        <span class="check-icon @(Model.DungBacDaoTao ? "ok" : "fail")">
                            <i class="bi @(Model.DungBacDaoTao ? "bi-check-lg" : "bi-x-lg")"></i>
                        </span>
                        <div class="check-info">
                            <div class="check-title">Bậc đào tạo</div>
                            <div class="check-sub">
                                <strong
                                class="@(Model.DungBacDaoTao ? "text-success" : "text-danger")">@Model.BacDaoTaoSinhVien</strong>
                                / yêu cầu @Model.BacDaoTaoHocBong
                            </div>
                        </div>
                        <span class="check-result @(Model.DungBacDaoTao ? "ok" : "fail")">@(Model.DungBacDaoTao ? "Khớp"                       : "Sai bậc")</span>
                    </div>
                </div>
            </section>

            <!-- Nội dung sinh viên gửi -->
            <section class="custom-card">
                <header class="custom-card-header">
                    <span class="icon-chip chip-primary"><i class="bi bi-journal-text"></i></span>
                    Nội dung sinh viên gửi
                </header>
                <div class="content-body">
                    <div class="content-block">
                        <div class="content-label">Thư xin học bổng</div>
                        @if (!string.IsNullOrWhiteSpace(Model.ThuXinHocBong))
                        {
                            <div class="letter-box">@Model.ThuXinHocBong</div>
                        }
                        else
                        {
                            <span class="value-empty">Không có</span>
                        }
                    </div>
                    <div class="content-block">
                        <div class="content-label">Thành tích học tập</div>
                        @if (!string.IsNullOrWhiteSpace(Model.ThanhTichHocTap))
                        {
                            <div class="letter-box letter-warning">@Model.ThanhTichHocTap</div>
                        }
                        else
                        {
                            <span class="value-empty">Không có</span>
                        }
                    </div>
                </div>
            </section>
        </div>

        <!-- ================= CỘT PHẢI ================= -->
        <div class="col-lg-5">

            <!-- Tiến độ cấp học bổng (nạp bằng AJAX) -->
            <section class="custom-card">
                <header class="custom-card-header">
                    <span class="icon-chip chip-primary"><i class="bi bi-pie-chart"></i></span>
                    Tiến độ cấp học bổng
                </header>
                <div class="side-body" id="noiDungSoSuat" data-ma-hoc-bong="@Model.MaHocBong">
                    <div class="quota-loading">
                        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                        <span>Đang tải dữ liệu suất...</span>
                    </div>
                </div>
            </section>

            <!-- Quyết định xét duyệt -->
            <section class="custom-card">
                <header class="custom-card-header header-success">
                    <span class="icon-chip chip-success"><i class="bi bi-pencil-square"></i></span>
                    Quyết định xét duyệt
                </header>
                <div class="side-body">
                    <form asp-action="XetDuyetSoBo" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="MaHoSoHocBong" />
                        <input type="hidden" asp-for="MaHocBong" />

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

                        <div class="form-section">
                            <div class="form-section-label">Kết quả</div>

                            <label class="choice-card choice-success">
                                <input class="form-check-input" type="radio" asp-for="KetQua" value="Dat" />
                                <span class="choice-text">
                                    <span class="choice-title">Đạt xét duyệt sơ bộ</span>
                                    <span class="choice-desc">Hồ sơ đáp ứng điều kiện, chuyển sang bước phỏng
                                        vấn.</span>
                                    </span>
                                </label>

                                <label class="choice-card choice-danger">
                                    <input class="form-check-input" type="radio" asp-for="KetQua" value="KhongDat" />
                                    <span class="choice-text">
                                        <span class="choice-title">Không đạt xét duyệt</span>
                                        <span class="choice-desc">Hồ sơ bị loại do không đáp ứng yêu cầu.</span>
                                    </span>
                                </label>

                                <span asp-validation-for="KetQua" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="form-section">
                                <label asp-for="NhanXetXetDuyet" class="form-section-label">
                                    Nhận xét chi tiết <span class="text-danger">*</span>
                                </label>
                                <textarea asp-for="NhanXetXetDuyet" class="form-control" rows="5"
                                          placeholder="Nhập lý do hoặc nhận xét đánh giá hồ sơ..."></textarea>
                                <span asp-validation-for="NhanXetXetDuyet" class="text-danger small"></span>
                            </div>

                            <div class="d-grid">
                                <button type="submit" class="btn btn-primary btn-action"
                                        onclick="return confirm('Bạn có chắc chắn muốn lưu quyết định xét duyệt này?');">
                                    <i class="bi bi-save me-2"></i>Lưu quyết định
                                </button>
                            </div>
                        </form>
                    </div>
                </section>
            </div>
        </div>
    </div>

    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
        <script>
            $(function () {
                var $box = $('#noiDungSoSuat');
                var maHocBong = parseInt($box.data('ma-hoc-bong'), 10);

                function showError(message) {
                    $box.html('<div class="alert alert-warning mb-0">' + message + '</div>');
                }

                if (!maHocBong) {
                    showError('Không xác định được mã học bổng để tải số suất.');
                    return;
                }

                $.ajax({
                    url: '@Url.Action("KiemTraSoSuat", "HoSoHocBong")',
                    type: 'GET',
                    cache: false,
                    data: { maHocBong: maHocBong },
                    success: function (data) {
                        var soSuat = Number(data.soSuat) || 0;
                        var soDaCap = Number(data.soDaCap) || 0;
                        var conLai = (data.conLai !== undefined) ? Number(data.conLai) : Math.max(soSuat - soDaCap, 0);
                        var tyLe = soSuat > 0 ? Math.min(100, Math.round(soDaCap * 100 / soSuat)) : 0;
                        var daDay = (data.daDatSuat !== undefined) ? !!data.daDatSuat : conLai <= 0;

                        var html =
                            '<div class="quota-grid">' +
                            '<div class="quota-item"><div class="quota-label">Tổng</div><div class="quota-number">' + soSuat + '</div></div>' +
                            '<div class="quota-item"><div class="quota-label">Đã cấp</div><div class="quota-number text-primary">' + soDaCap + '</div></div>' +
                            '<div class="quota-item"><div class="quota-label">Còn lại</div><div class="quota-number ' + (conLai > 0 ? 'text-success' : 'text-danger') + '">' + conLai + '</div></div>' +
                            '</div>' +
                            '<div class="quota-bar"><div class="quota-bar-fill' + (daDay ? ' is-full' : '') + '" style="width:' + tyLe + '%"></div></div>' +
                            '<div class="quota-caption">Đã cấp ' + tyLe + '% số suất</div>';

                        if (daDay) {
                            html += '<div class="alert alert-danger border-start border-danger border-4 mb-0 mt-3">' +
                                '<strong>Cảnh báo:</strong> học bổng đã cấp đủ số suất quy định. Hãy cân nhắc khi duyệt thêm.</div>';
                        } else {
                            html += '<div class="alert alert-success border-start border-success border-4 mb-0 mt-3">' +
                                'Học bổng còn <strong>' + conLai + '</strong> suất, có thể tiếp tục duyệt hồ sơ này.</div>';
                        }

                        $box.html(html);
                    },
                    error: function () {
                        showError('Không thể kết nối đến máy chủ để tải dữ liệu suất.');
                    }
                });
            });
        </script>
    }
