@model QuanLyHocBong_UNETI2_TI17A3HN.Models.HoSoHocBong
@{
    ViewData["Title"] = "Nộp hồ sơ xin học bổng";
    var hocBong = ViewBag.HocBong as QuanLyHocBong_UNETI2_TI17A3HN.Models.HocBong;
    var sinhVien = ViewBag.SinhVien as QuanLyHocBong_UNETI2_TI17A3HN.Models.SinhVien;
}

<div class="sponsor-page" style="max-width: 860px;">
    <div class="page-hero">
        <div class="page-hero-copy">
            <h2>Đăng ký xét học bổng</h2>
            <p>@hocBong?.TenHocBong · Hạn nộp: @hocBong?.HanNopHoSo.ToString("dd/MM/yyyy")</p>
        </div>
        <a asp-controller="HocBongSinhVien" asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Danh sách học bổng
        </a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="ui-card mb-3">
        <div class="ui-card-head">
            <h5>Thông tin trích xuất từ hồ sơ sinh viên</h5>
        </div>
        <div class="ui-card-body">
            <div class="info-grid">
                <div>
                    <span class="field-label">Họ và tên sinh viên</span>
                    <div class="field-value">@(sinhVien?.HoTen ?? Context.Session.GetString("HoTen"))</div>
                </div>
                <div>
                    <span class="field-label">Chuyên ngành & Bậc</span>
                    <div class="field-value">@(sinhVien?.Nganh) (@(sinhVien?.BacDaoTao))</div>
                </div>
                <div>
                    <span class="field-label">GPA tích lũy</span>
                    <div class="field-value accent">@(sinhVien?.DiemTrungBinhTichLuy) / 4.0 <small class="text-muted fw-normal">(Chuẩn: @(hocBong?.DiemTrungBinhToiThieu))</small></div>
                </div>
            </div>
        </div>
    </div>

    <div class="ui-card">
        <div class="ui-card-head">
            <h5>Nội dung hồ sơ ứng tuyển</h5>
        </div>
        <div class="ui-card-body">
            <form asp-action="NopHoSo" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="MaHocBong" value="@Model.MaHocBong" />

                <div class="mb-3">
                    <label class="form-label">Thư xin học bổng / Nguyện vọng &amp; Cam kết học tập <span class="text-danger">*</span></label>
                    <textarea name="ThuXinHocBong" class="form-control" rows="6" placeholder="Trình bày lý do bạn xứng đáng nhận học bổng này, mục tiêu học tập và định hướng phát triển..." required>@Model.ThuXinHocBong</textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label">Tài liệu minh chứng đính kèm (PDF, JPG, PNG)</label>
                    <input type="file" name="FileMinhChungUpload" class="form-control" accept=".pdf,.png,.jpg,.jpeg,.doc,.docx" />
                    <small class="text-muted d-block mt-1">Đính kèm bản scan bảng điểm hoặc minh chứng thành tích học tập, giấy khen (tối đa 20MB).</small>
                </div>

                <div class="mb-3">
                    <label class="form-label">Ghi chú bổ sung</label>
                    <input name="GhiChu" value="@Model.GhiChu" class="form-control" placeholder="Ví dụ: Đã nộp kèm chứng nhận nghiên cứu khoa học..." />
                </div>

                <div class="form-actions mt-4 pt-3 border-top">
                    <a asp-controller="HocBongSinhVien" asp-action="Details" asp-route-id="@Model.MaHocBong" class="btn btn-outline-secondary px-4">Hủy</a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-send me-1"></i> Gửi hồ sơ ứng tuyển
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
