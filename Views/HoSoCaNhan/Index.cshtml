@* Họ và tên: Nguyễn Phi Hùng - Mã sinh viên: 23103100148
   Nội dung thực hiện: Module 3 - trang hồ sơ cá nhân của sinh viên. *@
@model SinhVien
@{
    ViewData["Title"] = "Thông tin cá nhân";
    var thieu = (List<string>)ViewBag.ThongTinThieu;
    int soHoSo = (int)ViewBag.SoHoSo;
}

<div class="d-flex justify-content-between align-items-center mt-3 mb-3">
    <h2 class="mb-0">Thông tin cá nhân</h2>
    <a asp-action="Edit" class="btn btn-primary">Chỉnh sửa thông tin</a>
</div>

@if (TempData["ThongBao"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["ThongBao"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (thieu.Any())
{
    <div class="alert alert-warning">
        Hồ sơ cá nhân còn thiếu: <strong>@string.Join(", ", thieu)</strong>.
        Bạn cần bổ sung trước khi nộp hồ sơ xin học bổng.
        <a asp-action="Edit" class="alert-link">Cập nhật ngay</a>
    </div>
}

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header fw-semibold">Thông tin chung</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Mã sinh viên</dt>
                    <dd class="col-sm-8">@Model.MaSinhVien</dd>
                    <dt class="col-sm-4">Họ và tên</dt>
                    <dd class="col-sm-8">@Model.HoTen</dd>
                    <dt class="col-sm-4">Ngày sinh</dt>
                    <dd class="col-sm-8">@Model.NgaySinh.ToString("dd/MM/yyyy")</dd>
                    <dt class="col-sm-4">Giới tính</dt>
                    <dd class="col-sm-8">@Model.GioiTinh</dd>
                    <dt class="col-sm-4">Số điện thoại</dt>
                    <dd class="col-sm-8">@Model.SoDienThoai</dd>
                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">@Model.Email</dd>
                    <dt class="col-sm-4">Địa chỉ</dt>
                    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.DiaChi) ? "—" : Model.DiaChi)</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-header fw-semibold">Học tập</div>
            <div class="card-body">
                <dl class="mb-0">
                    <dt>Bậc đào tạo</dt>
                    <dd>@Model.BacDaoTao</dd>
                    <dt>Ngành</dt>
                    <dd>@Model.Nganh</dd>
                    <dt>Điểm trung bình tích lũy</dt>
                    <dd class="fs-5 fw-semibold">@Model.DiemTrungBinhTichLuy.ToString("0.00") <small class="text-muted fw-normal">/ 4.00</small></dd>
                    <dt>Trạng thái</dt>
                    <dd class="mb-0"><span class="badge text-bg-success">@Model.TrangThai</span></dd>
                </dl>
            </div>
        </div>
        <a asp-controller="HoSoCuaToi" asp-action="Index" class="btn btn-outline-secondary w-100">
            Xem hồ sơ đã nộp (@soHoSo)
        </a>
    </div>
    <div class="col-12">
        <div class="card">
            <div class="card-header fw-semibold">Thành tích học tập</div>
            <div class="card-body" style="white-space: pre-line;">@(string.IsNullOrWhiteSpace(Model.ThanhTichHocTap) ? "Chưa cập nhật." : Model.ThanhTichHocTap)</div>
        </div>
    </div>
</div>
