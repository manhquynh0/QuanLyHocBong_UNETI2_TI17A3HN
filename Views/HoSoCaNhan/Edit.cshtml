@* Họ và tên: Nguyễn Phi Hùng - Mã sinh viên: 23103100148
   Nội dung thực hiện: Module 3 - form cập nhật hồ sơ cá nhân (validation hiển thị trên View). *@
@using Microsoft.AspNetCore.Http
@using QuanLyHocBong_UNETI2_TI17A3HN.ViewModels
@model HoSoCaNhanViewModel
@{
    ViewData["Title"] = "Chỉnh sửa thông tin cá nhân";
    ViewData["Nav"] = "TaiKhoan";
    var huyUrl = !string.IsNullOrEmpty(Model.ReturnUrl) ? Model.ReturnUrl : Url.Action("Index", "HoSoCaNhan");
    var hoTen = ViewBag.HoTenHoSo as string ?? Model.HoTen;
    var chuCai = (hoTen ?? "S").Split(' ', StringSplitOptions.RemoveEmptyEntries).Last()[0].ToString().ToUpperInvariant();
    var avatarUrl = ViewBag.AnhDaiDien as string ?? Context.Session.GetString("AnhDaiDien");
}

<div class="page-hero">
    <div class="page-hero-copy">
        <h2>Cập nhật hồ sơ sinh viên</h2>
        <p>Thông tin và ảnh đại diện được đồng bộ trực tiếp với hồ sơ sinh viên UNETI.</p>
    </div>
</div>

<form asp-action="Edit" method="post" enctype="multipart/form-data" novalidate data-loading>
    <input type="hidden" asp-for="ReturnUrl" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="profile-layout">
        <div class="ui-card profile-side">
            @if (!string.IsNullOrEmpty(avatarUrl))
            {
                <div class="avatar-lg p-0">
                    <img id="avatarPreview" src="@avatarUrl" alt="@hoTen" style="width: 100%; height: 100%; object-fit: cover;" />
                </div>
            }
            else
            {
                <div id="avatarFallback" class="avatar-lg">@chuCai</div>
                <div id="avatarPreviewWrap" class="avatar-lg p-0 d-none">
                    <img id="avatarPreview" src="" alt="@hoTen" style="width: 100%; height: 100%; object-fit: cover;" />
                </div>
            }
            <h3>@hoTen</h3>
            <div class="profile-meta">#@ViewBag.MaSinhVien · @Model.Nganh</div>
            <div class="mb-3">
                <span class="badge-verified"><i class="bi bi-patch-check-fill"></i> Hồ sơ đã xác thực</span>
            </div>

            <div class="pt-3 border-top text-start">
                <label for="inputAvatar" class="form-label small mb-1">Ảnh đại diện mới</label>
                <input type="file" name="AnhDaiDienUpload" id="inputAvatar" class="form-control form-control-sm" accept="image/png, image/jpeg, image/jpg, image/webp" />
                <small class="text-muted d-block mt-1" style="font-size: 11px;">JPG, PNG hoặc WEBP (tối đa 5MB)</small>
            </div>
        </div>

        <div class="info-stack">
            <div class="ui-card">
                <div class="ui-card-body">
                    <h3 class="ui-card-title">Thông tin cơ bản</h3>
                    <p class="ui-card-sub">Dữ liệu định danh và liên hệ</p>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="HoTen" class="form-label">Họ và tên <span class="text-danger">*</span></label>
                            <input asp-for="HoTen" class="form-control" maxlength="100" autocomplete="name" />
                            <span asp-validation-for="HoTen" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="NgaySinh" class="form-label"></label>
                            <input asp-for="NgaySinh" type="date" class="form-control" autocomplete="bday" />
                            <span asp-validation-for="NgaySinh" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" type="email" maxlength="100" class="form-control" autocomplete="email" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="SoDienThoai" class="form-label"></label>
                            <input asp-for="SoDienThoai" type="tel" inputmode="tel" maxlength="12" class="form-control" autocomplete="tel" />
                            <span asp-validation-for="SoDienThoai" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="GioiTinh" class="form-label d-block"></label>
                            <div class="form-check form-check-inline">
                                <input asp-for="GioiTinh" type="radio" value="Nam" id="gt_nam" class="form-check-input" />
                                <label class="form-check-label" for="gt_nam">Nam</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input asp-for="GioiTinh" type="radio" value="Nữ" id="gt_nu" class="form-check-input" />
                                <label class="form-check-label" for="gt_nu">Nữ</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input asp-for="GioiTinh" type="radio" value="Khác" id="gt_khac" class="form-check-input" />
                                <label class="form-check-label" for="gt_khac">Khác</label>
                            </div>
                            <div><span asp-validation-for="GioiTinh" class="text-danger"></span></div>
                        </div>
                        <div class="col-12">
                            <label asp-for="DiaChi" class="form-label">Địa chỉ liên hệ</label>
                            <input asp-for="DiaChi" maxlength="500" class="form-control" autocomplete="street-address" />
                            <span asp-validation-for="DiaChi" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="ui-card">
                <div class="ui-card-body">
                    <h3 class="ui-card-title">Thông tin học tập</h3>
                    <p class="ui-card-sub">Kết quả gần nhất từ hệ thống đào tạo</p>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="BacDaoTao" class="form-label"></label>
                            <select asp-for="BacDaoTao" class="form-select">
                                <option value="">-- Chọn bậc đào tạo --</option>
                                <option value="Cao đẳng">Cao đẳng</option>
                                <option value="Đại học">Đại học</option>
                                <option value="Thạc sĩ">Thạc sĩ</option>
                            </select>
                            <span asp-validation-for="BacDaoTao" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Nganh" class="form-label">Chuyên ngành</label>
                            <input asp-for="Nganh" maxlength="100" class="form-control" />
                            <span asp-validation-for="Nganh" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="DiemTrungBinhTichLuy" class="form-label">GPA tích lũy</label>
                            <input asp-for="DiemTrungBinhTichLuy" type="number" step="0.01" class="form-control" />
                            <span asp-validation-for="DiemTrungBinhTichLuy" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="ThanhTichHocTap" class="form-label"></label>
                            <textarea asp-for="ThanhTichHocTap" rows="3" maxlength="1000" class="form-control"
                                      placeholder="Giải thưởng, chứng chỉ, hoạt động nổi bật..."></textarea>
                            <span asp-validation-for="ThanhTichHocTap" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="form-actions">
        <a href="@huyUrl" class="btn btn-outline-secondary px-4">Hủy</a>
        <button type="submit" class="btn btn-primary px-4">
            <i class="bi bi-save me-1"></i> Lưu thay đổi
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/validation-vi.js" asp-append-version="true"></script>
    <script>
        document.querySelectorAll('form input[type=text], form input[type=email], form input[type=tel]').forEach(function (el) {
            el.addEventListener('blur', function () { el.value = el.value.trim(); });
        });

        const inputAvatar = document.getElementById('inputAvatar');
        const preview = document.getElementById('avatarPreview');
        const previewWrap = document.getElementById('avatarPreviewWrap');
        const fallback = document.getElementById('avatarFallback');

        if (inputAvatar && preview) {
            inputAvatar.addEventListener('change', function () {
                const file = this.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        preview.src = e.target.result;
                        if (previewWrap) previewWrap.classList.remove('d-none');
                        if (fallback) fallback.classList.add('d-none');
                    };
                    reader.readAsDataURL(file);
                }
            });
        }
    </script>
}
