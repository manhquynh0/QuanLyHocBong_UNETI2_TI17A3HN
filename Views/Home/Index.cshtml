@model QuanLyHocBong_UNETI2_TI17A3HN.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Trang tổng quan hệ thống";
    var userRole = ViewBag.UserRole as string ?? "Admin";
    var userName = ViewBag.UserName as string ?? "Admin";
}

<div class="dashboard-container">
    <!-- Welcome Banner matching Figma -->
    <div class="welcome-banner">
        <div class="welcome-content">
            <h1 class="welcome-title">Chào mừng trở lại, @userName! 👋</h1>
            <p class="welcome-desc">Dưới đây là báo cáo tổng hợp tiến độ xét duyệt hồ sơ học bổng UNETI ngày hôm nay.</p>
        </div>
        <div class="welcome-actions">
            <span class="badge-date">
                <i class="bi bi-calendar3 me-1"></i> @DateTime.Now.ToString("dd/MM/yyyy")
            </span>
            <a asp-controller="HocBong" asp-action="Index" class="btn btn-light btn-sm fw-semibold">
                <i class="bi bi-plus-circle me-1"></i> Quản lý học bổng
            </a>
        </div>
    </div>

    <!-- Stats Grid matching Figma frame 3:687 + 9 chỉ số doc.docx -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon icon-blue">
                <i class="bi bi-award-fill"></i>
            </div>
            <div class="stat-info">
                <span class="stat-label">Tổng học bổng</span>
                <h3 class="stat-value">@Model.TongHocBong <small>Chương trình</small></h3>
                <span class="stat-meta text-success"><i class="bi bi-check-circle me-1"></i>@Model.HocBongDangNhanHoSo đang nhận hồ sơ</span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon icon-indigo">
                <i class="bi bi-file-earmark-text-fill"></i>
            </div>
            <div class="stat-info">
                <span class="stat-label">Hồ sơ đã nộp</span>
                <h3 class="stat-value">@Model.TongHoSo <small>Hồ sơ</small></h3>
                <span class="stat-meta text-primary"><i class="bi bi-clock-history me-1"></i>Toàn thời gian</span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon icon-amber">
                <i class="bi bi-hourglass-split"></i>
            </div>
            <div class="stat-info">
                <span class="stat-label">Hồ sơ chờ duyệt</span>
                <h3 class="stat-value">@Model.HoSoChoDuyet <small>Hồ sơ</small></h3>
                <span class="stat-meta text-warning"><i class="bi bi-exclamation-circle me-1"></i>Cần xử lý sơ bộ</span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon icon-purple">
                <i class="bi bi-calendar-event-fill"></i>
            </div>
            <div class="stat-info">
                <span class="stat-label">Lịch phỏng vấn</span>
                <h3 class="stat-value">@Model.LichPhongVanSapToi <small>Phiên</small></h3>
                <span class="stat-meta text-info"><i class="bi bi-calendar2-check me-1"></i>Đã lên lịch hẹn</span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon icon-emerald">
                <i class="bi bi-patch-check-fill"></i>
            </div>
            <div class="stat-info">
                <span class="stat-label">Đã duyệt cấp học bổng</span>
                <h3 class="stat-value">@Model.HoSoDuocCapHocBong <small>Sinh viên</small></h3>
                <span class="stat-meta text-success"><i class="bi bi-trophy-fill me-1"></i>Trúng tuyển</span>
            </div>
        </div>
    </div>

    <!-- Secondary Metrics Row -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="mini-stat-card">
                <div class="mini-stat-icon text-primary"><i class="bi bi-building"></i></div>
                <div>
                    <span class="mini-stat-label">Đơn vị tài trợ</span>
                    <strong class="mini-stat-val">@Model.TongDonViTaiTro đối tác</strong>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="mini-stat-card">
                <div class="mini-stat-icon text-info"><i class="bi bi-people-fill"></i></div>
                <div>
                    <span class="mini-stat-label">Sinh viên đăng ký</span>
                    <strong class="mini-stat-val">@Model.TongSinhVien sinh viên</strong>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="mini-stat-card">
                <div class="mini-stat-icon text-success"><i class="bi bi-check2-all"></i></div>
                <div>
                    <span class="mini-stat-label">Đạt sơ bộ</span>
                    <strong class="mini-stat-val">@Model.HoSoDatSoBo hồ sơ</strong>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row matching Figma -->
    <div class="charts-row">
        <!-- Biểu đồ cột: Số lượng hồ sơ tiếp nhận theo tháng -->
        <div class="chart-card">
            <div class="chart-header">
                <div>
                    <h4 class="chart-title">Số lượng hồ sơ tiếp nhận theo tháng</h4>
                    <span class="chart-subtitle">Theo dõi lưu lượng ứng tuyển của sinh viên</span>
                </div>
                <span class="badge bg-light text-dark border">4 tháng gần nhất</span>
            </div>
            <div class="bar-chart-visualization">
                @{
                    var maxCount = Model.HoSoTheoThang.Any() ? Model.HoSoTheoThang.Max(m => m.SoLuong) : 100;
                    if (maxCount == 0) maxCount = 100;
                }
                @foreach (var item in Model.HoSoTheoThang)
                {
                    var heightPercent = (int)((double)item.SoLuong / maxCount * 80) + 10;
                    <div class="bar-column">
                        <span class="bar-val">@item.SoLuong</span>
                        <div class="bar-fill-track">
                            <div class="bar-fill" style="height: @(heightPercent)%"></div>
                        </div>
                        <span class="bar-label">@item.Thang</span>
                    </div>
                }
            </div>
        </div>

        <!-- Biểu đồ tròn: Tỷ lệ phân bố trạng thái hồ sơ -->
        <div class="chart-card">
            <div class="chart-header">
                <div>
                    <h4 class="chart-title">Tỷ lệ trạng thái hồ sơ (Tổng: @Model.TongHoSo)</h4>
                    <span class="chart-subtitle">Cơ cấu tiến độ xử lý hồ sơ hiện tại</span>
                </div>
                <a asp-controller="HoSoHocBong" asp-action="Index" class="btn btn-sm btn-outline-primary">Chi tiết</a>
            </div>
            <div class="donut-chart-container">
                <div class="donut-graphic-wrapper">
                    <!-- SVG Donut Chart -->
                    <svg viewBox="0 0 160 160" class="donut-svg">
                        <circle cx="80" cy="80" r="60" fill="transparent" stroke="#f1f5f9" stroke-width="22" />
                        @{
                            double offset = 0;
                            var circumference = 2 * Math.PI * 60; // ~377
                            foreach (var s in Model.PhanBoTrangThai)
                            {
                                var dash = (s.TiLePhanTram / 100.0) * circumference;
                                var space = circumference - dash;
                                <circle cx="80" cy="80" r="60" fill="transparent"
                                        stroke="@s.MauSac" stroke-width="22"
                                        stroke-dasharray="@dash.ToString("F1", System.Globalization.CultureInfo.InvariantCulture) @space.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)"
                                        stroke-dashoffset="@((-offset).ToString("F1", System.Globalization.CultureInfo.InvariantCulture))"
                                        transform="rotate(-90 80 80)" />
                                offset += dash;
                            }
                        }
                    </svg>
                    <div class="donut-center-text">
                        <strong>@Model.TongHoSo</strong>
                        <small>Hồ sơ</small>
                    </div>
                </div>
                <div class="legend-list">
                    @foreach (var s in Model.PhanBoTrangThai)
                    {
                        <div class="legend-item">
                            <span class="legend-dot" style="background-color: @s.MauSac"></span>
                            <span class="legend-name">@s.TenTrangThai</span>
                            <span class="legend-pct">@(s.TiLePhanTram)%</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Applications Table Section -->
    <div class="card border-0 shadow-sm mt-4 rounded-3">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <div>
                <h5 class="mb-0 fw-bold text-dark">Hồ sơ ứng tuyển gần đây</h5>
                <small class="text-muted">Cập nhật hồ sơ sinh viên vừa gửi lên hệ thống</small>
            </div>
            <a asp-controller="HoSoHocBong" asp-action="Index" class="btn btn-sm btn-primary">
                Xem tất cả hồ sơ <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Mã hồ sơ</th>
                        <th>Sinh viên</th>
                        <th>Chương trình học bổng</th>
                        <th>Ngày nộp</th>
                        <th>Trạng thái</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.HoSoGanDay.Any())
                    {
                        foreach (var item in Model.HoSoGanDay)
                        {
                            var badgeClass = item.TrangThai switch
                            {
                                "Chờ duyệt" => "badge-warning",
                                "Đạt xét duyệt sơ bộ" => "badge-info",
                                "Chờ phỏng vấn" => "badge-purple",
                                "Đã phỏng vấn" => "badge-cyan",
                                "Được cấp học bổng" => "badge-success",
                                "Không được cấp học bổng" => "badge-danger",
                                "Không đạt xét duyệt sơ bộ" => "badge-danger",
                                "Đã hủy" => "badge-secondary",
                                _ => "badge-secondary"
                            };

                            <tr>
                                <td class="ps-4 fw-semibold">#@item.MaHoSo</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="table-avatar">@(!string.IsNullOrEmpty(item.TenSinhVien) ? item.TenSinhVien.Substring(0, 1) : "S")</div>
                                        <span class="fw-bold text-dark">@item.TenSinhVien</span>
                                    </div>
                                </td>
                                <td>@item.TenHocBong</td>
                                <td>@item.NgayNop.ToString("dd/MM/yyyy HH:mm")</td>
                                <td><span class="status-badge @badgeClass">@item.TrangThai</span></td>
                                <td class="text-end pe-4">
                                    <a asp-controller="HoSoHocBong" asp-action="Details" asp-route-id="@item.MaHoSo" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-eye"></i> Xem
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                                Chưa có hồ sơ học bổng nào trong hệ thống.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
