@model QuanLyHocBong_UNETI2_TI17A3HN.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Trang tổng quan hệ thống";
    var userRole = ViewBag.UserRole as string ?? "Admin";
    var userName = ViewBag.UserName as string ?? "Admin";
}

<div class="dashboard-container admin-dashboard">
    <header class="portal-masthead">
        <div>
            <div class="portal-masthead-kicker">
                <i class="bi bi-shield-check"></i> Hội đồng Xét duyệt Học bổng UNETI · @DateTime.Now.ToString("dd/MM/yyyy")
            </div>
            <h1>Tổng quan điều hành học bổng</h1>
            <p>Theo dõi tiến độ tiếp nhận, thẩm định sơ bộ, lịch phỏng vấn và chỉ tiêu cấp phát trên toàn hệ thống.</p>
        </div>
        <div class="portal-masthead-actions">
            <a asp-controller="HoSoHocBong" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-file-earmark-check me-1"></i> Duyệt hồ sơ (@Model.HoSoChoDuyet)
            </a>
            <a asp-controller="HocBong" asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i> Tạo chương trình học bổng
            </a>
        </div>
    </header>

    <!-- Dải chỉ số học thuật (Metric Ledger) thay cho các hộp màu rời rạc -->
    <section class="metric-ledger" aria-label="Chỉ số điều hành trọng tâm">
        <div class="metric-cell @(Model.HoSoChoDuyet > 0 ? "is-priority" : "")">
            <div class="metric-cell-head">
                <span>Hồ sơ chờ sơ duyệt</span>
                <i class="bi bi-hourglass-split"></i>
            </div>
            <div class="metric-cell-num">@Model.HoSoChoDuyet <small>hồ sơ</small></div>
            <div class="metric-cell-foot">
                <a asp-controller="HoSoHocBong" asp-action="Index" asp-route-TrangThai="Chờ duyệt">Xử lý sơ bộ ngay</a>
            </div>
        </div>

        <div class="metric-cell">
            <div class="metric-cell-head">
                <span>Tổng hồ sơ tiếp nhận</span>
                <i class="bi bi-folder2-open"></i>
            </div>
            <div class="metric-cell-num">@Model.TongHoSo <small>hồ sơ</small></div>
            <div class="metric-cell-foot">@Model.HoSoDatSoBo hồ sơ đã đạt sơ bộ</div>
        </div>

        <div class="metric-cell">
            <div class="metric-cell-head">
                <span>Chương trình học bổng</span>
                <i class="bi bi-journal-bookmark"></i>
            </div>
            <div class="metric-cell-num">@Model.TongHocBong <small>quỹ</small></div>
            <div class="metric-cell-foot">@Model.HocBongDangNhanHoSo chương trình đang mở nhận</div>
        </div>

        <div class="metric-cell">
            <div class="metric-cell-head">
                <span>Lịch phỏng vấn sắp tới</span>
                <i class="bi bi-calendar-event"></i>
            </div>
            <div class="metric-cell-num">@Model.LichPhongVanSapToi <small>phiên</small></div>
            <div class="metric-cell-foot">
                <a asp-controller="LichPhongVan" asp-action="Index">Quản lý lịch hẹn</a>
            </div>
        </div>

        <div class="metric-cell">
            <div class="metric-cell-head">
                <span>Đã duyệt cấp học bổng</span>
                <i class="bi bi-award"></i>
            </div>
            <div class="metric-cell-num">@Model.HoSoDuocCapHocBong <small>suất</small></div>
            <div class="metric-cell-foot">@Model.TongDonViTaiTro đối tác · @Model.TongSinhVien sinh viên</div>
        </div>
    </section>

    <!-- Biểu đồ trực quan -->
    <div class="dashboard-charts">
        <div class="dashboard-chart-monthly">
            <div class="chart-card">
                <div class="chart-header">
                    <div>
                        <h5 class="chart-title">Lưu lượng hồ sơ nộp theo tháng</h5>
                        <p class="chart-sub">Biến động số lượng hồ sơ ứng tuyển qua các kỳ xét duyệt</p>
                    </div>
                    <a asp-controller="ThongKe" asp-action="Index" class="btn btn-sm btn-outline-secondary">Báo cáo chi tiết</a>
                </div>
                <div class="bar-chart-container">
                    @{
                        int maxCount = Model.HoSoTheoThang.Any() ? Model.HoSoTheoThang.Max(x => x.SoLuong) : 100;
                        if (maxCount == 0) maxCount = 100;
                    }
                    @foreach (var m in Model.HoSoTheoThang)
                    {
                        var heightPct = (double)m.SoLuong / maxCount * 100;
                        <div class="bar-col">
                            <div class="bar-track">
                                <div class="bar-fill" style="height: @(heightPct)%;" title="@m.Thang: @m.SoLuong hồ sơ">
                                    <span class="bar-val">@m.SoLuong</span>
                                </div>
                            </div>
                            <span class="bar-label">@m.Thang</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="dashboard-chart-status">
            <div class="chart-card">
                <div class="chart-header">
                    <div>
                        <h5 class="chart-title">Cơ cấu trạng thái hồ sơ</h5>
                        <p class="chart-sub">Tỷ lệ phân bổ theo giai đoạn xét duyệt</p>
                    </div>
                </div>
                <div class="status-chart-body">
                    <div class="donut-chart-wrapper">
                        <svg viewBox="0 0 160 160" class="donut-svg" role="img" aria-label="Biểu đồ phân bổ trạng thái hồ sơ">
                            <circle cx="80" cy="80" r="58" fill="transparent" stroke="#f1f5f9" stroke-width="28" />
                            @{
                                double offset = 0;
                                double radius = 58;
                                double circumference = 2 * Math.PI * radius;
                                foreach (var s in Model.PhanBoTrangThai)
                                {
                                    var dash = (s.TiLePhanTram / 100.0) * circumference;
                                    var midAngle = ((offset + dash / 2) / circumference) * (2 * Math.PI) - (Math.PI / 2);
                                    var labelX = 80 + Math.Cos(midAngle) * radius;
                                    var labelY = 80 + Math.Sin(midAngle) * radius;
                                    <circle cx="80" cy="80" r="@radius" fill="transparent"
                                            stroke="@s.MauSac" stroke-width="28"
                                            stroke-dasharray="@(dash.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)) @((circumference - dash).ToString("F2", System.Globalization.CultureInfo.InvariantCulture))"
                                            stroke-dashoffset="@((-offset).ToString("F2", System.Globalization.CultureInfo.InvariantCulture))"
                                            transform="rotate(-90 80 80)" />
                                    @Html.Raw($"<text x=\"{labelX.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)}\" y=\"{labelY.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)}\" class=\"donut-segment-label\">{s.TiLePhanTram.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)}%</text>")
                                    offset += dash;
                                }
                            }
                        </svg>
                        <div class="donut-center-text">
                            <strong>@Model.TongHoSo</strong>
                            <small>Tổng hồ sơ</small>
                        </div>
                    </div>
                    <div class="legend-list">
                        @foreach (var s in Model.PhanBoTrangThai)
                        {
                            <div class="legend-item">
                                <span class="legend-dot" style="background-color: @s.MauSac"></span>
                                <span class="legend-name">@s.TenTrangThai (@s.SoLuong)</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Hồ sơ ứng tuyển gần đây -->
    <section class="dashboard-recent-card">
        <div class="dashboard-recent-header">
            <div>
                <h2 class="dashboard-recent-title">Hồ sơ ứng tuyển mới tiếp nhận</h2>
                <p class="dashboard-recent-subtitle">Danh sách hồ sơ sinh viên gửi lên gần nhất cần kiểm tra</p>
            </div>
            <a asp-controller="HoSoHocBong" asp-action="Index" class="btn btn-sm btn-outline-primary">
                Mở toàn bộ danh sách hồ sơ
            </a>
        </div>
        <div class="table-responsive border-0">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Mã hồ sơ</th>
                        <th>Sinh viên ứng tuyển</th>
                        <th>Chương trình học bổng</th>
                        <th>Thời gian nộp</th>
                        <th>Trạng thái</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.HoSoGanDay.Any())
                    {
                        foreach (var item in Model.HoSoGanDay)
                        {
                            var badgeClass = item.TrangThai switch
                            {
                                "Chờ duyệt" => "badge-warning",
                                "Đạt xét duyệt sơ bộ" => "badge-info",
                                "Chờ phỏng vấn" => "badge-purple",
                                "Đã phỏng vấn" => "badge-cyan",
                                "Được cấp học bổng" => "badge-success",
                                "Không được cấp học bổng" => "badge-danger",
                                "Không đạt xét duyệt sơ bộ" => "badge-danger",
                                "Đã hủy" => "badge-secondary",
                                _ => "badge-secondary"
                            };

                            <tr>
                                <td class="ps-4 fw-bold text-primary text-nowrap" style="font-variant-numeric: tabular-nums;">#@item.MaHoSo</td>
                                <td class="text-nowrap">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="table-avatar">@(!string.IsNullOrEmpty(item.TenSinhVien) ? item.TenSinhVien.Substring(0, 1) : "S")</div>
                                        <span class="fw-semibold text-dark">@item.TenSinhVien</span>
                                    </div>
                                </td>
                                <td class="fw-medium">@item.TenHocBong</td>
                                <td class="text-muted small text-nowrap" style="font-variant-numeric: tabular-nums;">@item.NgayNop.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-nowrap"><span class="status-badge @badgeClass">@item.TrangThai</span></td>
                                <td class="text-end pe-4 text-nowrap">
                                    <a asp-controller="HoSoHocBong" asp-action="Details" asp-route-id="@item.MaHoSo" class="btn btn-sm btn-outline-secondary">
                                        Thẩm định
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                Chưa có hồ sơ học bổng nào được nộp lên hệ thống.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/views/home/index.css" asp-append-version="true" />
}
