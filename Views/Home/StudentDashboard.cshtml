@model QuanLyHocBong_UNETI2_TI17A3HN.Models.ViewModels.StudentDashboardViewModel
@{
    Layout = "_LayoutStudent";
    ViewData["Title"] = "Trang chủ sinh viên";
    var sv = Model.SinhVien;
    var gpaRating = sv.DiemTrungBinhTichLuy >= 3.6m ? "Xuất sắc" : (sv.DiemTrungBinhTichLuy >= 3.2m ? "Giỏi" : (sv.DiemTrungBinhTichLuy >= 2.5m ? "Khá" : "Trung bình"));
}

<div class="dashboard-container">
    <!-- Institutional Masthead -->
    <header class="portal-masthead">
        <div>
            <div class="portal-masthead-kicker">
                <i class="bi bi-mortarboard-fill"></i> @(string.IsNullOrWhiteSpace(sv.Nganh) ? "Sinh viên UNETI" : $"{sv.Nganh} · {sv.BacDaoTao}") · GPA tích lũy: @sv.DiemTrungBinhTichLuy.ToString("0.00") / 4.0 (@gpaRating)
            </div>
            <h1>@sv.HoTen</h1>
            <p>Theo dõi tiến độ xét duyệt hồ sơ, lịch hẹn phỏng vấn và các quỹ học bổng phù hợp với năng lực học tập của bạn.</p>
        </div>
        <div class="portal-masthead-actions">
            <a asp-controller="HoSoCaNhan" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-person-badge me-1"></i> Hồ sơ cá nhân
            </a>
            <a asp-controller="HocBongSinhVien" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-award me-1"></i> Tìm chương trình học bổng
            </a>
        </div>
    </header>

    <!-- Metric Ledger -->
    <section class="metric-ledger" aria-label="Tổng quan hồ sơ của bạn">
        <div class="metric-cell">
            <div class="metric-cell-head">
                <span>Hồ sơ đã nộp</span>
                <i class="bi bi-folder2-open"></i>
            </div>
            <div class="metric-cell-num">@Model.TongHoSoDaNop <small>hồ sơ</small></div>
            <div class="metric-cell-foot">
                <a asp-controller="HoSoCuaToi" asp-action="Index">Quản lý hồ sơ đã nộp</a>
            </div>
        </div>

        <div class="metric-cell @(Model.HoSoDangXetDuyet > 0 ? "is-priority" : "")">
            <div class="metric-cell-head">
                <span>Đang thẩm định</span>
                <i class="bi bi-hourglass-split"></i>
            </div>
            <div class="metric-cell-num">@Model.HoSoDangXetDuyet <small>hồ sơ</small></div>
            <div class="metric-cell-foot">Hội đồng đang xử lý</div>
        </div>

        <div class="metric-cell">
            <div class="metric-cell-head">
                <span>Lịch phỏng vấn sắp tới</span>
                <i class="bi bi-calendar-check"></i>
            </div>
            <div class="metric-cell-num">@Model.LichPhongVanSapToi <small>buổi</small></div>
            <div class="metric-cell-foot">
                <a asp-controller="HoSoCuaToi" asp-action="LichPhongVan">Xem lịch phỏng vấn</a>
            </div>
        </div>

        <div class="metric-cell">
            <div class="metric-cell-head">
                <span>Học bổng đạt được</span>
                <i class="bi bi-patch-check"></i>
            </div>
            <div class="metric-cell-num">@Model.HocBongDuocCap <small>suất</small></div>
            <div class="metric-cell-foot">
                <a asp-controller="HoSoCuaToi" asp-action="KetQua">Tra cứu quyết định</a>
            </div>
        </div>
    </section>

    <div class="row g-4">
        <div class="col-lg-8">
            <!-- Hồ sơ xét tuyển của tôi -->
            <div class="ui-card mb-4">
                <div class="ui-card-head">
                    <h5>Hồ sơ ứng tuyển gần đây</h5>
                    <a asp-controller="HoSoCuaToi" asp-action="Index" class="btn btn-sm btn-outline-secondary">
                        Tất cả hồ sơ (@Model.TongHoSoDaNop)
                    </a>
                </div>
                <div class="p-0">
                    @if (Model.DanhSachHoSo.Any())
                    {
                        <div class="table-responsive border-0">
                            <table class="ui-table">
                                <thead>
                                    <tr>
                                        <th>Chương trình học bổng</th>
                                        <th>Ngày nộp</th>
                                        <th>Trạng thái</th>
                                        <th class="text-end">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var hs in Model.DanhSachHoSo)
                                    {
                                        var badgeClass = hs.TrangThai switch
                                        {
                                            "Chờ duyệt" => "badge-warning",
                                            "Đạt xét duyệt sơ bộ" => "badge-info",
                                            "Không đạt xét duyệt sơ bộ" => "badge-danger",
                                            "Chờ phỏng vấn" => "badge-purple",
                                            "Đã phỏng vấn" => "badge-cyan",
                                            "Được cấp học bổng" => "badge-success",
                                            "Không được cấp học bổng" => "badge-danger",
                                            "Đã hủy" => "badge-secondary",
                                            _ => "badge-secondary"
                                        };

                                        <tr>
                                            <td>
                                                <div class="fw-semibold text-dark">@(hs.HocBong?.TenHocBong ?? "Học bổng")</div>
                                                <small class="text-muted">@(hs.HocBong?.DonViTaiTro?.TenDonViTaiTro ?? "Đơn vị tài trợ")</small>
                                            </td>
                                            <td class="small text-muted" style="font-variant-numeric: tabular-nums;">@hs.NgayNop.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>
                                                <span class="status-badge @badgeClass">@hs.TrangThai</span>
                                            </td>
                                            <td class="text-end">
                                                <a asp-controller="HoSoCuaToi" asp-action="Details" asp-route-id="@hs.MaHoSoHocBong" class="btn btn-sm btn-outline-secondary">
                                                    Chi tiết
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">
                            <p class="mb-3">Bạn chưa nộp hồ sơ xin học bổng nào trong kỳ này.</p>
                            <a asp-controller="HocBongSinhVien" asp-action="Index" class="btn btn-primary btn-sm">
                                Tìm chương trình học bổng phù hợp
                            </a>
                        </div>
                    }
                </div>
            </div>

            <!-- Chương trình học bổng đang nhận hồ sơ -->
            <div class="ui-card">
                <div class="ui-card-head">
                    <h5>Chương trình học bổng đang mở nhận hồ sơ</h5>
                    <a asp-controller="HocBongSinhVien" asp-action="Index" class="btn btn-sm btn-outline-secondary">
                        Xem toàn bộ danh mục
                    </a>
                </div>
                <div class="ui-card-body">
                    <div class="row g-3">
                        @if (Model.HocBongDangMo.Any())
                        {
                            foreach (var hb in Model.HocBongDangMo)
                            {
                                var duDieuKienGpa = sv.DiemTrungBinhTichLuy >= hb.DiemTrungBinhToiThieu;
                                <div class="col-md-6">
                                    <div class="ui-card scholarship-card h-100">
                                        <div class="card-body d-flex flex-column justify-content-between">
                                            <div>
                                                <div class="d-flex justify-content-between align-items-center mb-2 gap-2">
                                                    <span class="st st-green">Đang nhận hồ sơ</span>
                                                    @if (duDieuKienGpa)
                                                    {
                                                        <span class="st st-blue">Đủ chuẩn GPA</span>
                                                    }
                                                </div>
                                                <h6 class="card-title mb-1">
                                                    <a asp-controller="HocBongSinhVien" asp-action="Details" asp-route-id="@hb.MaHocBong">
                                                        @hb.TenHocBong
                                                    </a>
                                                </h6>
                                                <div class="text-muted small mb-3">
                                                    @(hb.DonViTaiTro?.TenDonViTaiTro ?? "Đơn vị tài trợ")
                                                </div>

                                                <ul class="scholarship-meta small">
                                                    <li class="d-flex justify-content-between">
                                                        <span class="text-muted">GPA tối thiểu:</span>
                                                        <strong>@hb.DiemTrungBinhToiThieu.ToString("0.00") / 4.0</strong>
                                                    </li>
                                                    <li class="d-flex justify-content-between">
                                                        <span class="text-muted">Chỉ tiêu:</span>
                                                        <strong>@hb.SoSuat suất</strong>
                                                    </li>
                                                    <li class="d-flex justify-content-between">
                                                        <span class="text-muted">Hạn chót:</span>
                                                        <strong class="text-danger">@hb.HanNopHoSo.ToString("dd/MM/yyyy")</strong>
                                                    </li>
                                                </ul>
                                            </div>
                                        </div>
                                        <div class="card-footer d-flex justify-content-between align-items-center">
                                            <a asp-controller="HocBongSinhVien" asp-action="Details" asp-route-id="@hb.MaHocBong" class="btn btn-sm btn-outline-secondary">
                                                Chi tiết
                                            </a>
                                            <a asp-controller="HoSoCuaToi" asp-action="Create" asp-route-maHocBong="@hb.MaHocBong" class="btn btn-sm btn-primary">
                                                Nộp hồ sơ
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="col-12 empty-state py-4">
                                Hiện tại chưa có chương trình học bổng mới nào đang mở nhận hồ sơ.
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Cột phải: Lịch phỏng vấn & Hướng dẫn quy trình -->
        <div class="col-lg-4">
            <div class="ui-card mb-4">
                <div class="ui-card-head">
                    <h6>Lịch phỏng vấn sắp tới</h6>
                    <a asp-controller="HoSoCuaToi" asp-action="LichPhongVan" class="small fw-semibold">Tất cả</a>
                </div>
                <div class="ui-card-body">
                    @if (Model.LichPhongVanList.Any())
                    {
                        <div class="d-flex flex-column gap-2">
                            @foreach (var pv in Model.LichPhongVanList)
                            {
                                <div class="p-3 rounded-3 border bg-light">
                                    <div class="fw-bold text-dark small mb-1">@(pv.HoSoHocBong?.HocBong?.TenHocBong ?? "Phỏng vấn học bổng")</div>
                                    <div class="small text-muted mb-1" style="font-variant-numeric: tabular-nums;">
                                        <i class="bi bi-clock me-1"></i>@pv.ThoiGianBatDau.ToString("dd/MM/yyyy HH:mm") – @pv.ThoiGianKetThuc.ToString("HH:mm")
                                    </div>
                                    <div class="small text-muted mb-1">
                                        <i class="bi bi-geo-alt me-1"></i>@pv.DiaDiemHoacLienKet (@pv.HinhThucPhongVan)
                                    </div>
                                    <div class="small text-muted">
                                        <i class="bi bi-person-workspace me-1"></i>Hội đồng: @pv.NguoiPhongVan
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-3 text-muted small">
                            Bạn chưa có lịch phỏng vấn nào cần tham dự.
                        </div>
                    }
                </div>
            </div>

            <div class="ui-card">
                <div class="ui-card-head">
                    <h6>Quy trình xét duyệt tại UNETI</h6>
                </div>
                <div class="ui-card-body">
                    <ul class="timeline">
                        <li class="done">
                            <strong class="d-block text-dark">Hoàn thiện hồ sơ cá nhân</strong>
                            <span class="small text-muted">Đồng bộ GPA tích lũy, chuyên ngành và thông tin liên hệ chính xác.</span>
                        </li>
                        <li class="current">
                            <strong class="d-block text-dark">Ứng tuyển & Đính kèm minh chứng</strong>
                            <span class="small text-muted">Nộp thư nguyện vọng kèm bảng điểm, chứng nhận thành tích (PDF/JPG/PNG).</span>
                        </li>
                        <li>
                            <strong class="d-block text-dark">Thẩm định sơ bộ & Phỏng vấn</strong>
                            <span class="small text-muted">Cán bộ đối chiếu điều kiện; ứng viên đạt sơ bộ tham gia phỏng vấn cùng Hội đồng.</span>
                        </li>
                        <li>
                            <strong class="d-block text-dark">Công bố quyết định cấp học bổng</strong>
                            <span class="small text-muted">Kết quả chính thức hiển thị trên cổng sinh viên và thông báo qua email.</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
