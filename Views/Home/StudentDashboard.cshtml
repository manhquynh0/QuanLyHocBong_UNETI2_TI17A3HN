@model QuanLyHocBong_UNETI2_TI17A3HN.Models.ViewModels.StudentDashboardViewModel
@{
    Layout = "_LayoutStudent";
    ViewData["Title"] = "Trang chủ sinh viên";
    var sv = Model.SinhVien;
    var gpaRating = sv.DiemTrungBinhTichLuy >= 3.6m ? "Xuất sắc" : (sv.DiemTrungBinhTichLuy >= 3.2m ? "Giỏi" : (sv.DiemTrungBinhTichLuy >= 2.5m ? "Khá" : "Trung bình"));
    var gpaBadgeColor = sv.DiemTrungBinhTichLuy >= 3.2m ? "bg-success" : (sv.DiemTrungBinhTichLuy >= 2.5m ? "bg-primary" : "bg-warning text-dark");
}

<div class="dashboard-container">
    <!-- Welcome Banner matching Figma Theme -->
    <div class="welcome-banner mb-4 d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div class="welcome-content d-flex align-items-center gap-3">
            <div>
                <h1 class="welcome-title mb-1">Xin chào, @sv.HoTen! 👋</h1>
                <p class="welcome-desc mb-0">
                    Cổng thông tin học bổng sinh viên UNETI — Theo dõi hồ sơ ứng tuyển, lịch phỏng vấn và cơ hội học bổng mới nhất.
                </p>
            </div>
        </div>
        <div class="welcome-actions">
            <a asp-controller="HocBongSinhVien" asp-action="Index" class="btn btn-light btn-sm fw-semibold shadow-sm">
                <i class="bi bi-award-fill me-1 text-primary"></i> Khám phá học bổng
            </a>
            <a asp-controller="HoSoCaNhan" asp-action="Index" class="btn btn-outline-light btn-sm fw-semibold">
                <i class="bi bi-person-circle me-1"></i> Thông tin cá nhân
            </a>
        </div>
    </div>

    <!-- 4 Quick Stat Cards -->
    <div class="stats-grid mb-4">
        <div class="stat-card">
            <div class="stat-icon icon-blue">
                <i class="bi bi-folder2-open"></i>
            </div>
            <div class="stat-info">
                <span class="stat-label">Hồ sơ đã nộp</span>
                <h3 class="stat-value">@Model.TongHoSoDaNop <small>Hồ sơ</small></h3>
                <span class="stat-meta text-primary">
                    <a asp-controller="HoSoCuaToi" asp-action="Index" class="text-decoration-none">
                        Xem chi tiết &rarr;
                    </a>
                </span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon icon-amber">
                <i class="bi bi-hourglass-split"></i>
            </div>
            <div class="stat-info">
                <span class="stat-label">Đang xét duyệt</span>
                <h3 class="stat-value">@Model.HoSoDangXetDuyet <small>Hồ sơ</small></h3>
                <span class="stat-meta text-warning"><i class="bi bi-clock-history me-1"></i>Hội đồng đang xử lý</span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon icon-green">
                <i class="bi bi-patch-check-fill"></i>
            </div>
            <div class="stat-info">
                <span class="stat-label">Học bổng được cấp</span>
                <h3 class="stat-value">@Model.HocBongDuocCap <small>Suất</small></h3>
                <span class="stat-meta text-success">
                    <a asp-controller="HoSoCuaToi" asp-action="KetQua" class="text-decoration-none text-success">
                        Xem kết quả &rarr;
                    </a>
                </span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon icon-purple">
                <i class="bi bi-calendar-check-fill"></i>
            </div>
            <div class="stat-info">
                <span class="stat-label">Lịch phỏng vấn sắp tới</span>
                <h3 class="stat-value">@Model.LichPhongVanSapToi <small>Lịch</small></h3>
                <span class="stat-meta text-secondary">
                    <a asp-controller="HoSoCuaToi" asp-action="LichPhongVan" class="text-decoration-none">
                        Xem lịch hẹn &rarr;
                    </a>
                </span>
            </div>
        </div>
    </div>

    <!-- Main Content 2 Columns -->
    <div class="row g-4">
        <!-- Cột trái: Hồ sơ gần đây & Học bổng đang mở -->
        <div class="col-lg-8">
            <!-- Hồ sơ của tôi gần đây -->
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-file-earmark-person-fill text-primary me-2"></i>Hồ sơ xét tuyển của tôi
                    </h5>
                    <a asp-controller="HoSoCuaToi" asp-action="Index" class="btn btn-sm btn-outline-primary">
                        Xem tất cả (@Model.TongHoSoDaNop) &rarr;
                    </a>
                </div>
                <div class="card-body p-0">
                    @if (Model.DanhSachHoSo.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light small text-secondary">
                                    <tr>
                                        <th class="ps-4">Chương trình học bổng</th>
                                        <th>Ngày nộp</th>
                                        <th>Trạng thái</th>
                                        <th class="text-end pe-4">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var hs in Model.DanhSachHoSo)
                                    {
                                        var badgeClass = hs.TrangThai switch
                                        {
                                            "Chờ duyệt" => "badge-warning",
                                            "Đạt xét duyệt sơ bộ" => "badge-info",
                                            "Không đạt xét duyệt sơ bộ" => "badge-danger",
                                            "Chờ phỏng vấn" => "badge-purple",
                                            "Đã phỏng vấn" => "badge-cyan",
                                            "Được cấp học bổng" => "badge-success",
                                            "Không được cấp học bổng" => "badge-danger",
                                            "Đã hủy" => "badge-secondary",
                                            _ => "badge-secondary"
                                        };

                                        <tr>
                                            <td class="ps-4">
                                                <div class="fw-semibold text-dark">@(hs.HocBong?.TenHocBong ?? "Học bổng")</div>
                                                <small class="text-muted"><i class="bi bi-building me-1"></i>@(hs.HocBong?.DonViTaiTro?.TenDonViTaiTro ?? "Đơn vị tài trợ")</small>
                                            </td>
                                            <td class="small text-secondary">@hs.NgayNop.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>
                                                <span class="status-badge @badgeClass">@hs.TrangThai</span>
                                            </td>
                                            <td class="text-end pe-4">
                                                <a asp-controller="HoSoCuaToi" asp-action="Details" asp-route-id="@hs.MaHoSoHocBong" class="btn btn-sm btn-light border">
                                                    Chi tiết
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="p-4 text-center text-muted">
                            <i class="bi bi-folder-x fs-1 text-secondary mb-2 d-block"></i>
                            <p class="mb-2">Bạn chưa nộp hồ sơ xin học bổng nào.</p>
                            <a asp-controller="HocBongSinhVien" asp-action="Index" class="btn btn-primary btn-sm">
                                <i class="bi bi-plus-circle me-1"></i> Khám phá học bổng và nộp hồ sơ ngay
                            </a>
                        </div>
                    }
                </div>
            </div>

            <!-- Học bổng đang mở nhận hồ sơ -->
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-award-fill text-warning me-2"></i>Chương trình học bổng đang nhận hồ sơ
                    </h5>
                    <a asp-controller="HocBongSinhVien" asp-action="Index" class="btn btn-sm btn-outline-primary">
                        Xem tất cả &rarr;
                    </a>
                </div>
                <div class="card-body p-3">
                    <div class="row g-3">
                        @if (Model.HocBongDangMo.Any())
                        {
                            foreach (var hb in Model.HocBongDangMo)
                            {
                                var duDieuKienGpa = sv.DiemTrungBinhTichLuy >= hb.DiemTrungBinhToiThieu;
                                <div class="col-md-6">
                                    <div class="card h-100 border border-light-subtle shadow-sm rounded-3 hover-card">
                                        <div class="card-body p-3 d-flex flex-column justify-content-between">
                                            <div>
                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle small">
                                                        <i class="bi bi-clock me-1"></i>Còn hạn
                                                    </span>
                                                    @if (duDieuKienGpa)
                                                    {
                                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle small">
                                                            <i class="bi bi-check2-circle me-1"></i>Đủ điều kiện GPA
                                                        </span>
                                                    }
                                                </div>
                                                <h6 class="fw-bold text-dark mb-1">
                                                    <a asp-controller="HocBongSinhVien" asp-action="Details" asp-route-id="@hb.MaHocBong" class="text-dark text-decoration-none">
                                                        @hb.TenHocBong
                                                    </a>
                                                </h6>
                                                <small class="text-primary d-block mb-2">
                                                    <i class="bi bi-building me-1"></i>@(hb.DonViTaiTro?.TenDonViTaiTro ?? "Nhà tài trợ")
                                                </small>

                                                <div class="bg-light p-2 rounded-2 small mb-2">
                                                    <div class="d-flex justify-content-between">
                                                        <span class="text-muted">GPA tối thiểu:</span>
                                                        <strong>@hb.DiemTrungBinhToiThieu / 4.0</strong>
                                                    </div>
                                                    <div class="d-flex justify-content-between">
                                                        <span class="text-muted">Số suất:</span>
                                                        <strong>@hb.SoSuat suất</strong>
                                                    </div>
                                                    <div class="d-flex justify-content-between">
                                                        <span class="text-muted">Hạn nộp:</span>
                                                        <strong class="text-danger">@hb.HanNopHoSo.ToString("dd/MM/yyyy")</strong>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="pt-2 d-flex justify-content-between align-items-center">
                                                <a asp-controller="HocBongSinhVien" asp-action="Details" asp-route-id="@hb.MaHocBong" class="btn btn-sm btn-outline-secondary">
                                                    Chi tiết
                                                </a>
                                                <a asp-controller="HoSoCuaToi" asp-action="Create" asp-route-maHocBong="@hb.MaHocBong" class="btn btn-sm btn-success fw-semibold">
                                                    <i class="bi bi-send-fill me-1"></i> Nộp hồ sơ
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="col-12 text-center py-4 text-muted">
                                <p class="mb-0">Hiện tại chưa có học bổng mới nào đang mở nhận hồ sơ.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Cột phải: Thông tin cá nhân, Lịch phỏng vấn & Hướng dẫn -->
        <div class="col-lg-4">
            <!-- Thẻ thông tin cá nhân & Điểm GPA -->
            <!-- Thẻ Lịch phỏng vấn sắp tới -->
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-calendar-check text-purple me-2"></i>Lịch phỏng vấn của tôi
                    </h6>
                    <a asp-controller="HoSoCuaToi" asp-action="LichPhongVan" class="btn btn-sm btn-link p-0 text-decoration-none">
                        Tất cả &rarr;
                    </a>
                </div>
                <div class="card-body p-3">
                    @if (Model.LichPhongVanList.Any())
                    {
                        foreach (var pv in Model.LichPhongVanList)
                        {
                            <div class="p-3 bg-light rounded-2 mb-2 border-start border-4 border-primary">
                                <div class="fw-bold text-dark small mb-1">@(pv.HoSoHocBong?.HocBong?.TenHocBong ?? "Phỏng vấn học bổng")</div>
                                <div class="small text-muted mb-1">
                                    <i class="bi bi-clock me-1"></i>@pv.ThoiGianBatDau.ToString("dd/MM/yyyy HH:mm") - @pv.ThoiGianKetThuc.ToString("HH:mm")
                                </div>
                                <div class="small text-muted mb-1">
                                    <i class="bi bi-geo-alt me-1"></i>@pv.DiaDiemHoacLienKet (@pv.HinhThucPhongVan)
                                </div>
                                <div class="small text-muted">
                                    <i class="bi bi-person me-1"></i>Người PV: @pv.NguoiPhongVan
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-3 text-muted small">
                            <i class="bi bi-calendar-x fs-2 d-block mb-1 text-secondary"></i>
                            Bạn chưa có lịch phỏng vấn nào cần tham dự.
                        </div>
                    }
                </div>
            </div>

            <!-- Quy trình xét duyệt học bổng UNETI -->
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3">
                    <h6 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-shield-check text-success me-2"></i>Quy trình xét học bổng UNETI
                    </h6>
                </div>
                <div class="card-body p-3">
                    <ul class="list-unstyled mb-0 small">
                        <li class="d-flex gap-2 mb-3">
                            <span class="badge bg-primary rounded-circle p-1" style="width: 22px; height: 22px; line-height: 14px;">1</span>
                            <div>
                                <strong>Chọn học bổng & Nộp hồ sơ</strong>
                                <p class="text-muted mb-0">Điền thông tin và tải lên file minh chứng (PDF/PNG).</p>
                            </div>
                        </li>
                        <li class="d-flex gap-2 mb-3">
                            <span class="badge bg-primary rounded-circle p-1" style="width: 22px; height: 22px; line-height: 14px;">2</span>
                            <div>
                                <strong>Xét duyệt sơ bộ</strong>
                                <p class="text-muted mb-0">Hội đồng kiểm tra điều kiện GPA, bậc đào tạo và minh chứng.</p>
                            </div>
                        </li>
                        <li class="d-flex gap-2 mb-3">
                            <span class="badge bg-primary rounded-circle p-1" style="width: 22px; height: 22px; line-height: 14px;">3</span>
                            <div>
                                <strong>Phỏng vấn đánh giá</strong>
                                <p class="text-muted mb-0">Tham dự phỏng vấn đúng giờ theo lịch được thông báo.</p>
                            </div>
                        </li>
                        <li class="d-flex gap-2">
                            <span class="badge bg-success rounded-circle p-1" style="width: 22px; height: 22px; line-height: 14px;">4</span>
                            <div>
                                <strong>Công bố & Trao học bổng</strong>
                                <p class="text-muted mb-0">Nhận kết quả và tiền học bổng theo danh sách được duyệt.</p>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

