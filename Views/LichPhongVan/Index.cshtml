@model IEnumerable<QuanLyHocBong_UNETI2_TI17A3HN.Models.LichPhongVan>
@{
    ViewData["Title"] = "Quản lý lịch phỏng vấn học bổng";
    var userRole = Context.Session.GetString("VaiTro") ?? "";
    bool isStudent = ViewBag.IsStudent ?? false;
    bool isCanBoOrAdmin = userRole == "Admin" || userRole == "Cán bộ học bổng";

    var currentSearch = ViewBag.CurrentSearch as string ?? "";
    var currentTrangThai = ViewBag.CurrentTrangThai as string ?? "";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? 0;
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold mb-1 text-dark">
            @(isStudent ? "Lịch phỏng vấn của tôi" : "Lịch phỏng vấn học bổng UNETI")
        </h4>
        <small class="text-muted">Tổng cộng @totalItems phiên phỏng vấn</small>
    </div>
    @if (isCanBoOrAdmin)
    {
        <a asp-action="Create" class="btn btn-primary fw-semibold">
            <i class="bi bi-calendar-plus me-1"></i> Thiết lập lịch phỏng vấn mới
        </a>
    }
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show small" role="alert">
        <i class="bi bi-check-circle me-1"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show small" role="alert">
        <i class="bi bi-exclamation-triangle me-1"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Bộ lọc tìm kiếm lịch -->
<div class="card border-0 shadow-sm mb-4 rounded-3">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchString" value="@currentSearch" class="form-control border-start-0" placeholder="Tìm theo tên SV, học bổng, người PV hoặc địa điểm..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="trangThaiFilter" class="form-select">
                    <option value="">-- Trạng thái lịch hẹn --</option>
                    <option value="Đã lên lịch" selected="@(currentTrangThai == "Đã lên lịch")">Đã lên lịch</option>
                    <option value="Đã hoàn thành" selected="@(currentTrangThai == "Đã hoàn thành")">Đã hoàn thành</option>
                    <option value="Đã hủy" selected="@(currentTrangThai == "Đã hủy")">Đã hủy</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary px-3"><i class="bi bi-funnel me-1"></i> Lọc</button>
                <a asp-action="Index" class="btn btn-light border px-3">Đặt lại</a>
            </div>
        </form>
    </div>
</div>

<!-- Danh sách lịch phỏng vấn -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Thời gian</th>
                    <th>Sinh viên ứng tuyển</th>
                    <th>Chương trình học bổng</th>
                    <th>Hình thức & Địa điểm</th>
                    <th>Hội đồng phỏng vấn</th>
                    <th>Trạng thái</th>
                    <th class="text-end pe-4">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var item in Model)
                    {
                        var statusBadge = item.TrangThai switch
                        {
                            "Đã lên lịch" => "badge-purple",
                            "Đã hoàn thành" => "badge-success",
                            "Đã hủy" => "badge-secondary",
                            _ => "badge-secondary"
                        };

                        <tr>
                            <td class="ps-4">
                                <strong class="d-block text-dark">@item.ThoiGianBatDau.ToString("dd/MM/yyyy")</strong>
                                <span class="badge bg-light text-primary border">
                                    <i class="bi bi-clock me-1"></i>@item.ThoiGianBatDau.ToString("HH:mm") - @item.ThoiGianKetThuc.ToString("HH:mm")
                                </span>
                            </td>
                            <td>
                                <strong class="text-dark d-block">@(item.HoSoHocBong?.SinhVien?.HoTen ?? "N/A")</strong>
                                <small class="text-muted">@(item.HoSoHocBong?.SinhVien?.SoDienThoai)</small>
                            </td>
                            <td>
                                <span class="fw-semibold text-dark d-block">@(item.HoSoHocBong?.HocBong?.TenHocBong ?? "N/A")</span>
                                <small class="text-muted">Mã hồ sơ: #@item.MaHoSoHocBong</small>
                            </td>
                            <td>
                                <span class="badge @(item.HinhThucPhongVan == "Trực tuyến" ? "bg-info-subtle text-info" : "bg-light text-dark") border mb-1 d-inline-block">
                                    @(item.HinhThucPhongVan)
                                </span>
                                <div class="small text-muted text-truncate" style="max-width: 220px;" title="@item.DiaDiemHoacLienKet">
                                    @(item.DiaDiemHoacLienKet ?? "Tại trường")
                                </div>
                            </td>
                            <td>@item.NguoiPhongVan</td>
                            <td><span class="status-badge @statusBadge">@item.TrangThai</span></td>
                            <td class="text-end pe-4">
                                @if (isCanBoOrAdmin)
                                {
                                    @if (item.TrangThai == "Đã lên lịch")
                                    {
                                        <form asp-action="HoanThanh" asp-route-id="@item.MaLichPhongVan" method="post" class="d-inline" onsubmit="return confirm('Xác nhận hoàn thành buổi phỏng vấn này để chuyển sang bước nhập điểm kết quả?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-success" title="Xác nhận hoàn thành buổi PV">
                                                <i class="bi bi-check2-circle me-1"></i> Hoàn thành
                                            </button>
                                        </form>
                                        <form asp-action="HuyLich" asp-route-id="@item.MaLichPhongVan" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn hủy lịch này?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Hủy lịch">
                                                <i class="bi bi-x-circle"></i>
                                            </button>
                                        </form>
                                    }
                                    else if (item.TrangThai == "Đã hoàn thành")
                                    {
                                        <a asp-controller="KetQuaHocBong" asp-action="NhapKetQua" asp-route-maHoSo="@item.MaHoSoHocBong" class="btn btn-sm btn-outline-primary" title="Nhập kết quả học bổng">
                                            <i class="bi bi-clipboard2-check me-1"></i> Nhập kết quả
                                        </a>
                                    }
                                }
                                <a asp-controller="HoSoHocBong" asp-action="Details" asp-route-id="@item.MaHoSoHocBong" class="btn btn-sm btn-outline-secondary" title="Chi tiết hồ sơ">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-calendar-x fs-2 d-block mb-2"></i>
                            Chưa có phiên phỏng vấn nào phù hợp.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (totalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
            <span class="small text-muted">Trang @currentPage / @totalPages</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-searchString="@currentSearch" asp-route-trangThaiFilter="@currentTrangThai">&laquo;</a>
                </li>
                @for (int p = 1; p <= totalPages; p++)
                {
                    <li class="page-item @(p == currentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-searchString="@currentSearch" asp-route-trangThaiFilter="@currentTrangThai">@p</a>
                    </li>
                }
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-searchString="@currentSearch" asp-route-trangThaiFilter="@currentTrangThai">&raquo;</a>
                </li>
            </ul>
        </div>
    }
</div>

