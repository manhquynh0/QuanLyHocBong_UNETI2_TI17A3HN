@model IEnumerable<QuanLyHocBong_UNETI2_TI17A3HN.Models.LichPhongVan>
@{
    ViewData["Title"] = "Quản lý lịch phỏng vấn học bổng";
    var userRole = Context.Session.GetString("VaiTro") ?? "";
    bool isStudent = ViewBag.IsStudent ?? false;
    bool isCanBoOrAdmin = userRole == "Admin" || userRole == "Cán bộ học bổng";

    var currentSearch = ViewBag.CurrentSearch as string ?? "";
    var currentTrangThai = ViewBag.CurrentTrangThai as string ?? "";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? 0;
}

<div class="page-hero">
    <div class="page-hero-copy">
        <h2>@(isStudent ? "Lịch phỏng vấn của tôi" : "Điều phối lịch phỏng vấn")</h2>
        <p>Quản lý thời gian, hình thức và phân công hội đồng phỏng vấn cho các hồ sơ đã đạt sơ duyệt.</p>
    </div>
    @if (isCanBoOrAdmin)
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-calendar-plus me-1"></i> Thiết lập lịch phỏng vấn
        </a>
    }
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Bộ lọc tìm kiếm lịch -->
<form method="get" class="uneti-filter-card">
    <div class="row g-2 align-items-end">
        <div class="col-md-6">
            <label class="form-label">Từ khóa tìm kiếm</label>
            <input type="text" name="searchString" value="@currentSearch" class="form-control" placeholder="Tìm theo tên sinh viên, học bổng, người phỏng vấn hoặc địa điểm..." />
        </div>
        <div class="col-md-3">
            <label class="form-label">Trạng thái lịch hẹn</label>
            <select name="trangThaiFilter" class="form-select">
                <option value="">Tất cả trạng thái</option>
                <option value="Đã lên lịch" selected="@(currentTrangThai == "Đã lên lịch")">Đã lên lịch</option>
                <option value="Đã hoàn thành" selected="@(currentTrangThai == "Đã hoàn thành")">Đã hoàn thành</option>
                <option value="Đã hủy" selected="@(currentTrangThai == "Đã hủy")">Đã hủy</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100"><i class="bi bi-funnel me-1"></i> Lọc</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Đặt lại</a>
        </div>
    </div>
</form>

<!-- Danh sách lịch phỏng vấn -->
<div class="ui-card">
    <div class="ui-card-head">
        <h5>Danh sách phiên phỏng vấn</h5>
        <span class="text-muted small">Tổng cộng <strong>@totalItems</strong> phiên</span>
    </div>
    <div class="table-responsive border-0">
        <table class="ui-table">
            <thead>
                <tr>
                    <th style="width: 130px;">Thời gian</th>
                    <th style="min-width: 155px;">Sinh viên ứng tuyển</th>
                    <th style="min-width: 220px;">Chương trình học bổng</th>
                    <th style="min-width: 190px;">Hình thức &amp; Địa điểm</th>
                    <th style="min-width: 170px;">Hội đồng phỏng vấn</th>
                    <th style="width: 130px;">Trạng thái</th>
                    <th class="text-end" style="width: 210px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var item in Model)
                    {
                        var statusBadge = item.TrangThai switch
                        {
                            "Đã lên lịch" => "st-blue",
                            "Đã hoàn thành" => "st-green",
                            "Đã hủy" => "st-gray",
                            _ => "st-gray"
                        };

                        <tr>
                            <td class="text-nowrap" style="font-variant-numeric: tabular-nums;">
                                <strong class="d-block text-dark">@item.ThoiGianBatDau.ToString("dd/MM/yyyy")</strong>
                                <span class="small text-muted">
                                    @item.ThoiGianBatDau.ToString("HH:mm") – @item.ThoiGianKetThuc.ToString("HH:mm")
                                </span>
                            </td>
                            <td class="text-nowrap">
                                <strong class="text-dark d-block">@(item.HoSoHocBong?.SinhVien?.HoTen ?? "N/A")</strong>
                                <small class="text-muted">@(item.HoSoHocBong?.SinhVien?.SoDienThoai)</small>
                            </td>
                            <td>
                                <span class="fw-semibold text-dark d-block">@(item.HoSoHocBong?.HocBong?.TenHocBong ?? "N/A")</span>
                                <small class="text-muted">Hồ sơ #@item.MaHoSoHocBong</small>
                            </td>
                            <td>
                                <span class="st @(item.HinhThucPhongVan == "Trực tuyến" ? "st-blue" : "st-gray") mb-1">
                                    @(item.HinhThucPhongVan)
                                </span>
                                <div class="small text-muted text-truncate" style="max-width: 220px;" title="@item.DiaDiemHoacLienKet">
                                    @(item.DiaDiemHoacLienKet ?? "Tại trường")
                                </div>
                            </td>
                            <td class="fw-medium">@item.NguoiPhongVan</td>
                            <td class="text-nowrap"><span class="st @statusBadge">@item.TrangThai</span></td>
                            <td class="text-end text-nowrap">
                                @if (isCanBoOrAdmin)
                                {
                                    @if (item.TrangThai == "Đã lên lịch")
                                    {
                                        <form asp-action="HoanThanh" asp-route-id="@item.MaLichPhongVan" method="post" class="d-inline" onsubmit="return confirm('Xác nhận hoàn thành buổi phỏng vấn này để chuyển sang bước nhập điểm kết quả?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-primary" title="Xác nhận hoàn thành buổi PV">
                                                Hoàn thành
                                            </button>
                                        </form>
                                        <form asp-action="HuyLich" asp-route-id="@item.MaLichPhongVan" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn hủy lịch này?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Hủy lịch">
                                                Hủy
                                            </button>
                                        </form>
                                    }
                                    else if (item.TrangThai == "Đã hoàn thành")
                                    {
                                        <a asp-controller="KetQuaHocBong" asp-action="NhapKetQua" asp-route-maHoSo="@item.MaHoSoHocBong" class="btn btn-sm btn-outline-primary" title="Nhập kết quả học bổng">
                                            Nhập kết quả
                                        </a>
                                    }
                                }
                                <a asp-controller="HoSoHocBong" asp-action="Details" asp-route-id="@item.MaHoSoHocBong" class="btn btn-sm btn-outline-secondary" title="Chi tiết hồ sơ">
                                    Hồ sơ
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="empty-state">
                            Chưa có phiên phỏng vấn nào phù hợp.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (totalPages > 1)
{
    <nav class="mt-4" aria-label="Phân trang lịch phỏng vấn">
        <ul class="pagination justify-content-center">
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-searchString="@currentSearch" asp-route-trangThaiFilter="@currentTrangThai">« Trước</a>
            </li>
            @for (int p = 1; p <= totalPages; p++)
            {
                <li class="page-item @(p == currentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-searchString="@currentSearch" asp-route-trangThaiFilter="@currentTrangThai">@p</a>
                </li>
            }
            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-searchString="@currentSearch" asp-route-trangThaiFilter="@currentTrangThai">Sau »</a>
            </li>
        </ul>
    </nav>
}
