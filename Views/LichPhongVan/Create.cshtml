@model QuanLyHocBong_UNETI2_TI17A3HN.Models.LichPhongVan
@{
    ViewData["Title"] = "Thiết lập lịch phỏng vấn mới";
    bool hasEligible = ViewBag.HasEligibleApplications ?? false;
}

<div class="sponsor-page" style="max-width: 780px;">
    <div class="page-hero">
        <div class="page-hero-copy">
            <h2>Thiết lập lịch phỏng vấn</h2>
            <p>Hệ thống tự động kiểm tra chống trùng lịch giữa ứng viên và hội đồng phỏng vấn.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Danh sách lịch hẹn
        </a>
    </div>

    <div class="ui-card">
        <div class="ui-card-body">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger mb-3">
                    <strong class="d-block mb-1">Không thể lưu lịch phỏng vấn do các lỗi sau:</strong>
                    <ul class="mb-0 ps-3">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            @if (!hasEligible && Model.MaHoSoHocBong == 0)
            {
                <div class="alert alert-warning mb-4">
                    <strong class="d-block mb-1">Chưa có hồ sơ nào ở trạng thái "Đạt xét duyệt sơ bộ"</strong>
                    <p class="mb-2 small">
                        Chỉ những hồ sơ đã được Cán bộ thẩm định sơ bộ và đánh giá <strong>"Đạt xét duyệt sơ bộ"</strong> mới có thể xếp lịch phỏng vấn.
                    </p>
                    <a asp-controller="HoSoHocBong" asp-action="Index" class="btn btn-sm btn-primary">
                        Mở danh sách hồ sơ để xét duyệt sơ bộ
                    </a>
                </div>
            }

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="MaHoSoHocBong" class="form-label">Hồ sơ ứng tuyển đã đạt sơ duyệt <span class="text-danger">*</span></label>
                        <select asp-for="MaHoSoHocBong" class="form-select" asp-items="ViewBag.MaHoSoHocBong">
                            <option value="">-- Chọn hồ sơ ứng tuyển --</option>
                        </select>
                        <span asp-validation-for="MaHoSoHocBong" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ThoiGianBatDau" class="form-label">Thời gian bắt đầu <span class="text-danger">*</span></label>
                        <input asp-for="ThoiGianBatDau" type="datetime-local" class="form-control" value="@Model.ThoiGianBatDau.ToString("yyyy-MM-ddTHH:mm")" />
                        <span asp-validation-for="ThoiGianBatDau" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ThoiGianKetThuc" class="form-label">Thời gian kết thúc <span class="text-danger">*</span></label>
                        <input asp-for="ThoiGianKetThuc" type="datetime-local" class="form-control" value="@Model.ThoiGianKetThuc.ToString("yyyy-MM-ddTHH:mm")" />
                        <span asp-validation-for="ThoiGianKetThuc" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="HinhThucPhongVan" class="form-label">Hình thức phỏng vấn <span class="text-danger">*</span></label>
                        <select asp-for="HinhThucPhongVan" class="form-select">
                            <option value="Trực tiếp" selected="@(Model.HinhThucPhongVan == "Trực tiếp")">Trực tiếp (Tại phòng họp trường)</option>
                            <option value="Trực tuyến" selected="@(Model.HinhThucPhongVan == "Trực tuyến")">Trực tuyến (Google Meet / Zoom / Teams)</option>
                        </select>
                        <span asp-validation-for="HinhThucPhongVan" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="NguoiPhongVan" class="form-label">Người / Hội đồng phỏng vấn <span class="text-danger">*</span></label>
                        <input asp-for="NguoiPhongVan" class="form-control" placeholder="Ví dụ: Hội đồng Công tác Sinh viên" />
                        <span asp-validation-for="NguoiPhongVan" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="DiaDiemHoacLienKet" class="form-label">Địa điểm hoặc đường dẫn phòng họp trực tuyến <span class="text-danger">*</span></label>
                        <input asp-for="DiaDiemHoacLienKet" class="form-control" placeholder="Ví dụ: Phòng họp H.A8 cơ sở Lĩnh Nam hoặc liên kết Google Meet" />
                        <span asp-validation-for="DiaDiemHoacLienKet" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="GhiChu" class="form-label">Ghi chú &amp; Hướng dẫn cho sinh viên</label>
                        <textarea asp-for="GhiChu" class="form-control" rows="3" placeholder="Ví dụ: Mang theo thẻ sinh viên, bản gốc bảng điểm và trang phục lịch sự..."></textarea>
                        <span asp-validation-for="GhiChu" class="text-danger small"></span>
                    </div>
                </div>

                <div class="form-actions mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">Hủy</a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-calendar-check me-1"></i> Lưu &amp; Lên lịch phỏng vấn
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
