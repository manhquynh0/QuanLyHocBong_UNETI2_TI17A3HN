@model QuanLyHocBong_UNETI2_TI17A3HN.Models.ViewModels.ThongKeViewModel
@{
    ViewData["Title"] = "Báo cáo & Thống kê tổng quan";
}

<div class="page-hero">
    <div class="page-hero-copy">
        <h2>Báo cáo &amp; Thống kê học bổng</h2>
        <p>Phân tích số liệu tiếp nhận hồ sơ, tỷ lệ qua vòng sơ duyệt và kết quả cấp phát học bổng theo đơn vị tài trợ.</p>
    </div>
    <a asp-action="ExportCsv" class="btn btn-primary">
        <i class="bi bi-file-earmark-spreadsheet me-1"></i> Xuất báo cáo CSV / Excel
    </a>
</div>

<!-- Metric Ledger -->
<section class="metric-ledger" aria-label="Chỉ số thống kê tổng hợp">
    <div class="metric-cell">
        <div class="metric-cell-head">
            <span>Tổng lượt hồ sơ nộp</span>
            <i class="bi bi-folder2-open"></i>
        </div>
        <div class="metric-cell-num">@Model.HoSoTheoThang.Sum(x => x.SoLuong) <small>hồ sơ</small></div>
        <div class="metric-cell-foot">Toàn bộ các kỳ xét duyệt</div>
    </div>

    <div class="metric-cell">
        <div class="metric-cell-head">
            <span>Phiên phỏng vấn đã tổ chức</span>
            <i class="bi bi-calendar-check"></i>
        </div>
        <div class="metric-cell-num">@Model.LichPVTheoThang.Sum(x => x.SoLuong) <small>phiên</small></div>
        <div class="metric-cell-foot">@Model.TongDaPhongVan hồ sơ đã phỏng vấn</div>
    </div>

    <div class="metric-cell">
        <div class="metric-cell-head">
            <span>Tỷ lệ trúng tuyển / Phỏng vấn</span>
            <i class="bi bi-award"></i>
        </div>
        <div class="metric-cell-num">@Model.TyLeCapTrenPhongVan%</div>
        <div class="metric-cell-foot">@Model.TongDuocCap sinh viên được trao học bổng</div>
    </div>

    <div class="metric-cell">
        <div class="metric-cell-head">
            <span>Chương trình thu hút nhất</span>
            <i class="bi bi-journal-bookmark"></i>
        </div>
        <div class="metric-cell-num">@Model.SoHoSoNhieuNhat <small>hồ sơ</small></div>
        <div class="metric-cell-foot text-truncate" title="@Model.HocBongNhieuHoSoNhat">@Model.HocBongNhieuHoSoNhat</div>
    </div>
</section>

<!-- Biểu đồ trực quan Chart.js -->
<div class="row g-3 mb-3">
    <div class="col-lg-5">
        <div class="ui-card h-100">
            <div class="ui-card-head">
                <h5>Cơ cấu trạng thái hồ sơ</h5>
                <span class="text-muted small">Phân bổ tỷ trọng</span>
            </div>
            <div class="ui-card-body d-flex flex-column align-items-center justify-content-center">
                <div style="position: relative; height: 250px; width: 100%; max-width: 320px;">
                    <canvas id="chartTrangThai"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="ui-card h-100">
            <div class="ui-card-head">
                <h5>Số lượng hồ sơ theo chương trình học bổng</h5>
                <span class="text-muted small">So sánh quy mô</span>
            </div>
            <div class="ui-card-body">
                <div style="position: relative; height: 250px; width: 100%;">
                    <canvas id="chartTopHocBong"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="ui-card mb-3">
    <div class="ui-card-head">
        <h5>Xu hướng nộp hồ sơ &amp; lịch phỏng vấn theo thời gian</h5>
        <span class="text-muted small">Theo tháng</span>
    </div>
    <div class="ui-card-body">
        <div style="position: relative; height: 260px; width: 100%;">
            <canvas id="chartXuHuong"></canvas>
        </div>
    </div>
</div>

<!-- Bảng tổng hợp chi tiết -->
<div class="row g-3 mb-3">
    <div class="col-md-6">
        <div class="ui-card h-100">
            <div class="ui-card-head">
                <h5>Số học bổng theo đơn vị tài trợ</h5>
            </div>
            <div class="table-responsive border-0">
                <table class="ui-table">
                    <thead>
                        <tr>
                            <th>Đơn vị tài trợ</th>
                            <th class="text-end">Số chương trình</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.HocBongTheoDonVi)
                        {
                            <tr>
                                <td class="fw-semibold">@item.Ten</td>
                                <td class="text-end" style="font-variant-numeric: tabular-nums;"><span class="st st-blue">@item.SoLuong chương trình</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="ui-card h-100">
            <div class="ui-card-head">
                <h5>Số suất đã cấp theo đơn vị tài trợ</h5>
            </div>
            <div class="table-responsive border-0">
                <table class="ui-table">
                    <thead>
                        <tr>
                            <th>Đơn vị tài trợ</th>
                            <th class="text-end">Sinh viên nhận học bổng</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.HoSoCapTheoDonVi)
                        {
                            <tr>
                                <td class="fw-semibold">@item.Ten</td>
                                <td class="text-end" style="font-variant-numeric: tabular-nums;"><span class="st st-green">@item.SoLuong sinh viên</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="ui-card">
    <div class="ui-card-head">
        <h5>Tỷ lệ hồ sơ vượt qua vòng xét duyệt sơ bộ theo từng học bổng</h5>
    </div>
    <div class="table-responsive border-0">
        <table class="ui-table">
            <thead>
                <tr>
                    <th>Chương trình học bổng</th>
                    <th class="text-center">Tổng hồ sơ nộp</th>
                    <th class="text-center">Đạt sơ bộ</th>
                    <th>Tỷ lệ đạt sơ bộ</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.TyLeDatSoBoTheoHocBong)
                {
                    <tr>
                        <td class="fw-semibold text-dark">@item.TenHocBong</td>
                        <td class="text-center" style="font-variant-numeric: tabular-nums;">@item.TongHoSo</td>
                        <td class="text-center text-success fw-bold" style="font-variant-numeric: tabular-nums;">@item.SoDatSoBo</td>
                        <td style="width: 260px;">
                            <div class="d-flex align-items-center gap-2">
                                <div class="progress flex-grow-1" style="height: 8px; background: #e2e8f0;">
                                    <div class="progress-bar" role="progressbar" style="width: @(item.TyLePhanTram)%; background: #1d5b9e;"></div>
                                </div>
                                <span class="small fw-bold text-dark" style="min-width: 42px; text-align: right; font-variant-numeric: tabular-nums;">@(item.TyLePhanTram)%</span>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const trangThaiLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.HoSoTheoTrangThai.Select(x => x.Ten)));
            const trangThaiValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.HoSoTheoTrangThai.Select(x => x.SoLuong)));

            const colorsTrangThai = [
                '#1d5b9e', '#15803d', '#d97706', '#0e7490', '#475569', '#b91c1c', '#64748b', '#0369a1'
            ];

            const ctxTrangThai = document.getElementById('chartTrangThai');
            if (ctxTrangThai) {
                new Chart(ctxTrangThai, {
                    type: 'doughnut',
                    data: {
                        labels: trangThaiLabels,
                        datasets: [{
                            data: trangThaiValues,
                            backgroundColor: colorsTrangThai.slice(0, trangThaiLabels.length),
                            borderWidth: 2,
                            borderColor: '#ffffff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: {
                                    boxWidth: 12,
                                    font: { size: 11, family: 'Be Vietnam Pro' }
                                }
                            }
                        },
                        cutout: '65%'
                    }
                });
            }

            const hbLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.HoSoTheoHocBong.Select(x => x.Ten.Length > 22 ? x.Ten.Substring(0, 20) + "..." : x.Ten)));
            const hbValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.HoSoTheoHocBong.Select(x => x.SoLuong)));

            const ctxTopHocBong = document.getElementById('chartTopHocBong');
            if (ctxTopHocBong) {
                new Chart(ctxTopHocBong, {
                    type: 'bar',
                    data: {
                        labels: hbLabels,
                        datasets: [{
                            label: 'Số hồ sơ nộp',
                            data: hbValues,
                            backgroundColor: '#1d5b9e',
                            borderRadius: 6,
                            maxBarThickness: 32
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: { stepSize: 1, font: { size: 11, family: 'Be Vietnam Pro' } }
                            },
                            x: {
                                ticks: { font: { size: 11, family: 'Be Vietnam Pro' } }
                            }
                        },
                        plugins: {
                            legend: { display: false }
                        }
                    }
                });
            }

            const months = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.HoSoTheoThang.Select(x => x.Ten)));
            const hoSoMonthData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.HoSoTheoThang.Select(x => x.SoLuong)));
            const lichPvMonthData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LichPVTheoThang.Select(x => x.SoLuong)));

            const ctxXuHuong = document.getElementById('chartXuHuong');
            if (ctxXuHuong) {
                new Chart(ctxXuHuong, {
                    type: 'line',
                    data: {
                        labels: months.length > 0 ? months : ['Tháng 9/2026', 'Tháng 10/2026', 'Tháng 11/2026'],
                        datasets: [
                            {
                                label: 'Hồ sơ đăng ký nộp',
                                data: hoSoMonthData.length > 0 ? hoSoMonthData : [12, 28, 5],
                                borderColor: '#1d5b9e',
                                backgroundColor: 'rgba(29, 91, 158, 0.10)',
                                fill: true,
                                tension: 0.3,
                                borderWidth: 2,
                                pointRadius: 4
                            },
                            {
                                label: 'Lịch phỏng vấn tổ chức',
                                data: lichPvMonthData.length > 0 ? lichPvMonthData : [4, 18, 2],
                                borderColor: '#d97706',
                                backgroundColor: 'rgba(217, 119, 6, 0.08)',
                                fill: true,
                                tension: 0.3,
                                borderWidth: 2,
                                pointRadius: 4
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: { font: { size: 11, family: 'Be Vietnam Pro' } }
                            },
                            x: {
                                ticks: { font: { size: 11, family: 'Be Vietnam Pro' } }
                            }
                        },
                        plugins: {
                            legend: {
                                position: 'top',
                                labels: { boxWidth: 12, font: { size: 12, family: 'Be Vietnam Pro' } }
                            }
                        }
                    }
                });
            }
        });
    </script>
}
