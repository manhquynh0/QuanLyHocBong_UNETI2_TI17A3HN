@model QuanLyHocBong_UNETI2_TI17A3HN.Models.ViewModels.ThongKeViewModel
@{
    ViewData["Title"] = "Báo cáo & Thống kê tổng quan";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold mb-1 text-dark">Thống kê & Báo cáo số liệu học bổng</h4>
        <small class="text-muted">Tổng hợp và phân tích chuyên sâu dữ liệu bằng truy vấn LINQ</small>
    </div>
    <!-- Chức năng nâng cao: Xuất dữ liệu CSV / Excel -->
    <a asp-action="ExportCsv" class="btn btn-success fw-semibold shadow-sm">
        <i class="bi bi-file-earmark-spreadsheet me-1"></i> Xuất báo cáo Excel / CSV
    </a>
</div>

<!-- Key Highlights Row -->
<div class="row g-3 mb-4">
    <div class="col-md-6 col-lg-4">
        <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
            <span class="text-muted small fw-semibold">Học bổng được quan tâm nhất</span>
            <h5 class="fw-bold text-primary mt-2 mb-1">@Model.HocBongNhieuHoSoNhat</h5>
            <span class="text-success small fw-semibold"><i class="bi bi-fire me-1"></i>@Model.SoHoSoNhieuNhat hồ sơ ứng tuyển</span>
        </div>
    </div>
    <div class="col-md-6 col-lg-4">
        <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
            <span class="text-muted small fw-semibold">Tỷ lệ trúng tuyển / Đã phỏng vấn</span>
            <h3 class="fw-bold text-success mt-1 mb-1">@Model.TyLeCapTrenPhongVan%</h3>
            <span class="text-muted small">@Model.TongDuocCap được cấp / @Model.TongDaPhongVan hồ sơ phỏng vấn</span>
        </div>
    </div>
    <div class="col-md-12 col-lg-4">
        <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
            <span class="text-muted small fw-semibold">Tiến độ tiếp nhận & xử lý</span>
            <div class="d-flex justify-content-between mt-2">
                <div>
                    <strong class="d-block text-dark fs-5">@Model.HoSoTheoThang.Sum(x => x.SoLuong)</strong>
                    <small class="text-muted">Tổng lượt nộp</small>
                </div>
                <div>
                    <strong class="d-block text-purple fs-5" style="color: #8b5cf6;">@Model.LichPVTheoThang.Sum(x => x.SoLuong)</strong>
                    <small class="text-muted">Lịch phỏng vấn</small>
                </div>
                <div>
                    <strong class="d-block text-success fs-5">@Model.TongDuocCap</strong>
                    <small class="text-muted">Đã trao thưởng</small>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- 1. Số học bổng theo đơn vị tài trợ -->
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white py-3 border-bottom">
                <h6 class="fw-bold text-dark mb-0"><i class="bi bi-building text-primary me-2"></i>Số học bổng theo đơn vị tài trợ</h6>
            </div>
            <div class="card-body p-3">
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Đơn vị tài trợ</th>
                                <th class="text-end">Số học bổng</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.HocBongTheoDonVi)
                            {
                                <tr>
                                    <td><strong class="text-dark">@item.Ten</strong></td>
                                    <td class="text-end"><span class="badge bg-primary-subtle text-primary border px-2 py-1">@item.SoLuong chương trình</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. Số hồ sơ theo trạng thái -->
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white py-3 border-bottom">
                <h6 class="fw-bold text-dark mb-0"><i class="bi bi-pie-chart-fill text-info me-2"></i>Phân bổ hồ sơ theo trạng thái xử lý</h6>
            </div>
            <div class="card-body p-3">
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Trạng thái</th>
                                <th class="text-end">Số lượng hồ sơ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.HoSoTheoTrangThai)
                            {
                                <tr>
                                    <td><span class="status-badge badge-secondary">@item.Ten</span></td>
                                    <td class="text-end fw-bold">@item.SoLuong hồ sơ</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- 3. Số hồ sơ theo từng học bổng -->
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white py-3 border-bottom">
                <h6 class="fw-bold text-dark mb-0"><i class="bi bi-bar-chart-fill text-success me-2"></i>Số lượng hồ sơ theo từng học bổng</h6>
            </div>
            <div class="card-body p-3">
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Tên học bổng</th>
                                <th class="text-end">Số hồ sơ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.HoSoTheoHocBong)
                            {
                                <tr>
                                    <td class="text-truncate" style="max-width: 280px;" title="@item.Ten">@item.Ten</td>
                                    <td class="text-end fw-bold text-primary">@item.SoLuong hồ sơ</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- 4. Số hồ sơ được cấp học bổng theo đơn vị tài trợ -->
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white py-3 border-bottom">
                <h6 class="fw-bold text-dark mb-0"><i class="bi bi-trophy-fill text-warning me-2"></i>Số hồ sơ được cấp theo đơn vị tài trợ</h6>
            </div>
            <div class="card-body p-3">
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Đơn vị tài trợ</th>
                                <th class="text-end">Đã cấp học bổng</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.HoSoCapTheoDonVi)
                            {
                                <tr>
                                    <td>@item.Ten</td>
                                    <td class="text-end"><span class="badge bg-success px-2 py-1">@item.SoLuong sinh viên</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 5. Tỷ lệ qua xét duyệt sơ bộ theo từng học bổng -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-header bg-white py-3 border-bottom">
        <h6 class="fw-bold text-dark mb-0"><i class="bi bi-check2-all text-primary me-2"></i>Tỷ lệ hồ sơ qua xét duyệt sơ bộ theo từng học bổng</h6>
    </div>
    <div class="card-body p-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Tên chương trình học bổng</th>
                        <th class="text-center">Tổng hồ sơ nộp</th>
                        <th class="text-center">Số đạt sơ bộ</th>
                        <th>Tỷ lệ đạt sơ bộ (%)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.TyLeDatSoBoTheoHocBong)
                    {
                        <tr>
                            <td class="ps-3 fw-semibold text-dark">@item.TenHocBong</td>
                            <td class="text-center">@item.TongHoSo</td>
                            <td class="text-center text-success fw-bold">@item.SoDatSoBo</td>
                            <td style="width: 250px;">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress flex-grow-1" style="height: 8px;">
                                        <div class="progress-bar bg-success" role="progressbar" style="width: @(item.TyLePhanTram)%;"></div>
                                    </div>
                                    <span class="small fw-bold text-dark">@(item.TyLePhanTram)%</span>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- CHỨC NĂNG NÂNG CAO: TRỰC QUAN HÓA BẰNG BIỂU ĐỒ TƯƠNG TÁC CHART.JS (Mục 19 doc.docx) -->
<div class="row g-4 mb-4">
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold text-dark mb-0"><i class="bi bi-pie-chart-fill text-info me-2"></i>Biểu đồ phân bổ trạng thái hồ sơ</h6>
                <span class="badge bg-primary-subtle text-primary border">Chart.js</span>
            </div>
            <div class="card-body p-4 d-flex flex-column align-items-center justify-content-center">
                <div style="position: relative; height: 260px; width: 100%; max-width: 320px;">
                    <canvas id="chartTrangThai"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold text-dark mb-0"><i class="bi bi-bar-chart-line-fill text-primary me-2"></i>Top học bổng nhận nhiều hồ sơ nhất</h6>
                <span class="badge bg-primary-subtle text-primary border">Chart.js</span>
            </div>
            <div class="card-body p-3">
                <div style="position: relative; height: 260px; width: 100%;">
                    <canvas id="chartTopHocBong"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h6 class="fw-bold text-dark mb-0"><i class="bi bi-graph-up-arrow text-success me-2"></i>Biểu đồ xu hướng nộp hồ sơ & lịch phỏng vấn theo thời gian</h6>
        <span class="badge bg-primary-subtle text-primary border">Chart.js Timeline</span>
    </div>
    <div class="card-body p-3">
        <div style="position: relative; height: 280px; width: 100%;">
            <canvas id="chartXuHuong"></canvas>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // 1. Dữ liệu trạng thái hồ sơ
            const trangThaiLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.HoSoTheoTrangThai.Select(x => x.Ten)));
            const trangThaiValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.HoSoTheoTrangThai.Select(x => x.SoLuong)));

            const colorsTrangThai = [
                '#f59e0b', '#3b82f6', '#8b5cf6', '#10b981', '#06b6d4', '#ef4444', '#64748b', '#ec4899'
            ];

            const ctxTrangThai = document.getElementById('chartTrangThai');
            if (ctxTrangThai) {
                new Chart(ctxTrangThai, {
                    type: 'doughnut',
                    data: {
                        labels: trangThaiLabels,
                        datasets: [{
                            data: trangThaiValues,
                            backgroundColor: colorsTrangThai.slice(0, trangThaiLabels.length),
                            borderWidth: 2,
                            borderColor: '#ffffff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: {
                                    boxWidth: 12,
                                    font: { size: 11, family: 'Inter' }
                                }
                            }
                        },
                        cutout: '65%'
                    }
                });
            }

            // 2. Dữ liệu Top học bổng
            const hbLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.HoSoTheoHocBong.Select(x => x.Ten.Length > 20 ? x.Ten.Substring(0, 18) + "..." : x.Ten)));
            const hbValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.HoSoTheoHocBong.Select(x => x.SoLuong)));

            const ctxTopHocBong = document.getElementById('chartTopHocBong');
            if (ctxTopHocBong) {
                new Chart(ctxTopHocBong, {
                    type: 'bar',
                    data: {
                        labels: hbLabels,
                        datasets: [{
                            label: 'Số hồ sơ nộp',
                            data: hbValues,
                            backgroundColor: '#2160ad',
                            borderRadius: 6,
                            maxBarThickness: 32
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: { stepSize: 1, font: { size: 11 } }
                            },
                            x: {
                                ticks: { font: { size: 11 } }
                            }
                        },
                        plugins: {
                            legend: { display: false }
                        }
                    }
                });
            }

            // 3. Dữ liệu xu hướng theo tháng
            const months = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.HoSoTheoThang.Select(x => x.Ten)));
            const hoSoMonthData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.HoSoTheoThang.Select(x => x.SoLuong)));
            const lichPvMonthData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LichPVTheoThang.Select(x => x.SoLuong)));

            const ctxXuHuong = document.getElementById('chartXuHuong');
            if (ctxXuHuong) {
                new Chart(ctxXuHuong, {
                    type: 'line',
                    data: {
                        labels: months.length > 0 ? months : ['Tháng 9/2026', 'Tháng 10/2026', 'Tháng 11/2026'],
                        datasets: [
                            {
                                label: 'Hồ sơ đăng ký nộp',
                                data: hoSoMonthData.length > 0 ? hoSoMonthData : [12, 28, 5],
                                borderColor: '#2160ad',
                                backgroundColor: 'rgba(33, 96, 173, 0.12)',
                                fill: true,
                                tension: 0.35,
                                borderWidth: 2,
                                pointRadius: 4
                            },
                            {
                                label: 'Lịch phỏng vấn tổ chức',
                                data: lichPvMonthData.length > 0 ? lichPvMonthData : [4, 18, 2],
                                borderColor: '#8b5cf6',
                                backgroundColor: 'rgba(139, 92, 246, 0.10)',
                                fill: true,
                                tension: 0.35,
                                borderWidth: 2,
                                pointRadius: 4
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: { font: { size: 11 } }
                            },
                            x: {
                                ticks: { font: { size: 11 } }
                            }
                        },
                        plugins: {
                            legend: {
                                position: 'top',
                                labels: { boxWidth: 12, font: { size: 12, family: 'Inter' } }
                            }
                        }
                    }
                });
            }
        });
    </script>
}

