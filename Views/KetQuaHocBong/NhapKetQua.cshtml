@model QuanLyHocBong_UNETI2_TI17A3HN.Models.KetQuaHocBong
@{
    ViewData["Title"] = "Nhập kết quả xét học bổng";
    var hoSo = ViewBag.HoSo as QuanLyHocBong_UNETI2_TI17A3HN.Models.HoSoHocBong;
    bool canhBaoHetSuat = ViewBag.CanhBaoHetSuat ?? false;
    int soDaCap = ViewBag.SoDaCap ?? 0;
    int tongSoSuat = ViewBag.TongSoSuat ?? 0;
}

<div class="sponsor-page" style="max-width: 800px;">
    <div class="page-hero">
        <div class="page-hero-copy">
            <h2>Công bố kết quả xét duyệt cuối cùng</h2>
            <p>Ghi nhận điểm phỏng vấn và quyết định trao học bổng chính thức của Hội đồng.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Danh sách kết quả
        </a>
    </div>

    @if (canhBaoHetSuat && hoSo?.TrangThai != "Được cấp học bổng")
    {
        <div class="alert alert-danger mb-3 d-flex align-items-center">
            <i class="bi bi-exclamation-triangle-fill fs-4 me-2 text-danger"></i>
            <div>
                <strong>Cảnh báo chỉ tiêu học bổng:</strong> Chương trình học bổng này đã cấp <strong>@soDaCap/@tongSoSuat</strong> suất (đã đạt giới hạn tối đa). Không thể cấp thêm sinh viên mới theo quy định tại Mục 8.5!
            </div>
        </div>
    }
    else if (soDaCap + 1 >= tongSoSuat && hoSo?.TrangThai != "Được cấp học bổng")
    {
        <div class="alert alert-warning mb-3 d-flex align-items-center">
            <i class="bi bi-info-circle-fill fs-5 me-2 text-warning"></i>
            <div>
                <strong>Lưu ý số suất còn lại:</strong> Hiện tại đã cấp <strong>@soDaCap/@tongSoSuat</strong> suất. Nếu hồ sơ này được cấp, học bổng sẽ đạt đủ chỉ tiêu và hệ thống sẽ tự động chuyển trạng thái học bổng thành <strong>"Đã đóng"</strong>.
            </div>
        </div>
    }

    <div class="ui-card mb-3">
        <div class="ui-card-head">
            <h5>Hồ sơ ứng viên</h5>
        </div>
        <div class="ui-card-body">
            <div class="info-grid">
                <div>
                    <span class="field-label">Sinh viên</span>
                    <div class="field-value">@(hoSo?.SinhVien?.HoTen)</div>
                </div>
                <div>
                    <span class="field-label">GPA tích lũy</span>
                    <div class="field-value accent">@(hoSo?.SinhVien?.DiemTrungBinhTichLuy.ToString("0.00")) / 4.0</div>
                </div>
                <div>
                    <span class="field-label">Chương trình học bổng</span>
                    <div class="field-value">@(hoSo?.HocBong?.TenHocBong)</div>
                </div>
            </div>
        </div>
    </div>

    <div class="ui-card">
        <div class="ui-card-head">
            <h5>Quyết định của Hội đồng xét duyệt</h5>
        </div>
        <div class="ui-card-body">
            <form asp-action="NhapKetQua" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>
                <input type="hidden" name="MaHoSoHocBong" value="@Model.MaHoSoHocBong" />

                <div class="alert alert-info py-2 px-3 small mb-3">
                    <strong>Thông báo tự động:</strong> Khi lưu kết quả, hệ thống sẽ gửi email thông báo quyết định tới địa chỉ <strong>@(hoSo?.SinhVien?.Email ?? "Chưa có email")</strong>.
                </div>

                <div class="mb-3">
                    <label class="form-label">Quyết định kết quả xét duyệt <span class="text-danger">*</span></label>
                    <div class="d-flex flex-wrap gap-4 p-3 bg-light rounded-3 border">
                        <div class="form-check">
                            @{
                                bool daHetSuat = canhBaoHetSuat && hoSo?.TrangThai != "Được cấp học bổng";
                            }
                            <input class="form-check-input" type="radio" name="KetQua" id="grantYes" value="Được cấp học bổng" 
                                   checked="@(Model.KetQua == "Được cấp học bổng" && !daHetSuat)" 
                                   disabled="@daHetSuat" />
                            <label class="form-check-label fw-bold @(daHetSuat ? "text-muted text-decoration-line-through" : "text-success")" for="grantYes">
                                Được cấp học bổng (Trúng tuyển) @(daHetSuat ? "- [ĐÃ HẾT SUẤT]" : "")
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="KetQua" id="grantNo" value="Không được cấp học bổng" 
                                   checked="@(Model.KetQua == "Không được cấp học bổng" || daHetSuat)" />
                            <label class="form-check-label fw-bold text-danger" for="grantNo">
                                Không được cấp học bổng
                            </label>
                        </div>
                    </div>
                    <span asp-validation-for="KetQua" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="DiemDanhGia" class="form-label">Điểm đánh giá hội đồng (Thang điểm 100) <span class="text-danger">*</span></label>
                    <input asp-for="DiemDanhGia" type="number" step="0.5" min="0" max="100" class="form-control" placeholder="Ví dụ: 88.5" required />
                    <span asp-validation-for="DiemDanhGia" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NhanXet" class="form-label">Nhận xét chi tiết của Hội đồng xét duyệt <span class="text-danger">*</span></label>
                    <textarea asp-for="NhanXet" class="form-control" rows="4" placeholder="Nhập đánh giá về năng lực học tập, phần trả lời phỏng vấn và kết luận của hội đồng..." required></textarea>
                    <span asp-validation-for="NhanXet" class="text-danger small"></span>
                </div>

                <div class="form-actions mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">Hủy</a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check2-circle me-1"></i> Lưu &amp; Công bố kết quả
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
