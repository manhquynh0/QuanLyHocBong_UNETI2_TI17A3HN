@model IEnumerable<QuanLyHocBong_UNETI2_TI17A3HN.Models.KetQuaHocBong>
@{
    ViewData["Title"] = "Kết quả xét học bổng";
    var userRole = Context.Session.GetString("VaiTro") ?? "";
    bool isStudent = ViewBag.IsStudent ?? false;
    bool isCanBoOrAdmin = userRole == "Admin" || userRole == "Cán bộ học bổng";

    var currentSearch = ViewBag.CurrentSearch as string ?? "";
    int? currentHocBong = ViewBag.CurrentHocBong as int?;
    var currentKetQua = ViewBag.CurrentKetQua as string ?? "";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? 0;
}

<div class="page-hero">
    <div class="page-hero-copy">
        <h2>@(isStudent ? "Kết quả học bổng của tôi" : "Quyết định xét cấp học bổng")</h2>
        <p>Danh sách tổng hợp kết quả đánh giá hội đồng và quyết định trao học bổng UNETI.</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Bộ lọc -->
<form method="get" class="uneti-filter-card">
    <div class="row g-2 align-items-end">
        <div class="col-md-5">
            <label class="form-label">Từ khóa tìm kiếm</label>
            <input type="text" name="searchString" value="@currentSearch" class="form-control" placeholder="Tìm theo họ tên sinh viên hoặc chương trình học bổng..." />
        </div>
        <div class="col-md-4">
            <label class="form-label">Kết quả xét duyệt</label>
            <select name="ketQuaFilter" class="form-select">
                <option value="">Tất cả kết quả</option>
                <option value="Được cấp học bổng" selected="@(currentKetQua == "Được cấp học bổng")">Được cấp học bổng</option>
                <option value="Không được cấp học bổng" selected="@(currentKetQua == "Không được cấp học bổng")">Không được cấp học bổng</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100"><i class="bi bi-funnel me-1"></i> Lọc</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Đặt lại</a>
        </div>
    </div>
</form>

<!-- Bảng kết quả -->
<div class="ui-card">
    <div class="ui-card-head">
        <h5>Danh sách kết quả công bố</h5>
        <span class="text-muted small">Tổng cộng <strong>@totalItems</strong> hồ sơ đã có quyết định</span>
    </div>
    <div class="table-responsive border-0">
        <table class="ui-table">
            <thead>
                <tr>
                    <th style="min-width: 150px;">Sinh viên</th>
                    <th style="min-width: 220px;">Chương trình học bổng</th>
                    <th style="width: 130px;">Điểm hội đồng</th>
                    <th style="width: 170px;">Kết quả cuối cùng</th>
                    <th style="width: 140px;">Ngày công bố</th>
                    <th style="min-width: 200px;">Nhận xét của Hội đồng</th>
                    <th class="text-end" style="width: 165px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var item in Model)
                    {
                        var isGranted = item.KetQua == "Được cấp học bổng";
                        <tr>
                            <td class="text-nowrap">
                                <strong class="text-dark d-block">@(item.HoSoHocBong?.SinhVien?.HoTen ?? "N/A")</strong>
                                <small class="text-muted">Hồ sơ #@item.MaHoSoHocBong</small>
                            </td>
                            <td>
                                <strong class="text-dark d-block">@(item.HoSoHocBong?.HocBong?.TenHocBong ?? "N/A")</strong>
                                <small class="text-muted">@(item.HoSoHocBong?.HocBong?.DonViTaiTro?.TenDonViTaiTro)</small>
                            </td>
                            <td class="text-nowrap" style="font-variant-numeric: tabular-nums;">
                                @if (item.DiemDanhGia.HasValue)
                                {
                                    <strong class="@(item.DiemDanhGia >= 80 ? "text-success" : "text-primary")">
                                        @item.DiemDanhGia.Value.ToString("0.##") / 100
                                    </strong>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-nowrap">
                                @if (isGranted)
                                {
                                    <span class="st st-green">Được cấp học bổng</span>
                                }
                                else
                                {
                                    <span class="st st-red">Không được cấp</span>
                                }
                            </td>
                            <td class="small text-muted text-nowrap" style="font-variant-numeric: tabular-nums;">@item.NgayCapNhat.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <div class="text-truncate text-secondary small" style="max-width: 240px;" title="@item.NhanXet">
                                    @(item.NhanXet ?? "Không có nhận xét")
                                </div>
                            </td>
                            <td class="text-end text-nowrap">
                                @if (isCanBoOrAdmin)
                                {
                                    <a asp-action="NhapKetQua" asp-route-maHoSo="@item.MaHoSoHocBong" class="btn btn-sm btn-outline-primary">
                                        Cập nhật
                                    </a>
                                }
                                <a asp-controller="HoSoHocBong" asp-action="Details" asp-route-id="@item.MaHoSoHocBong" class="btn btn-sm btn-outline-secondary">
                                    Hồ sơ
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="empty-state">
                            Chưa có kết quả học bổng nào được ghi nhận.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (totalPages > 1)
{
    <nav class="mt-4" aria-label="Phân trang kết quả học bổng">
        <ul class="pagination justify-content-center">
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-searchString="@currentSearch" asp-route-ketQuaFilter="@currentKetQua">« Trước</a>
            </li>
            @for (int p = 1; p <= totalPages; p++)
            {
                <li class="page-item @(p == currentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-searchString="@currentSearch" asp-route-ketQuaFilter="@currentKetQua">@p</a>
                </li>
            }
            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-searchString="@currentSearch" asp-route-ketQuaFilter="@currentKetQua">Sau »</a>
            </li>
        </ul>
    </nav>
}
