@model IEnumerable<QuanLyHocBong_UNETI2_TI17A3HN.Models.KetQuaHocBong>
@{
    ViewData["Title"] = "Kết quả xét học bổng";
    var userRole = Context.Session.GetString("VaiTro") ?? "";
    bool isStudent = ViewBag.IsStudent ?? false;
    bool isCanBoOrAdmin = userRole == "Admin" || userRole == "Cán bộ học bổng";

    var currentSearch = ViewBag.CurrentSearch as string ?? "";
    int? currentHocBong = ViewBag.CurrentHocBong as int?;
    var currentKetQua = ViewBag.CurrentKetQua as string ?? "";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? 0;
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold mb-1 text-dark">
            @(isStudent ? "Kết quả học bổng của tôi" : "Công bố kết quả xét cấp học bổng UNETI")
        </h4>
        <small class="text-muted">Tổng cộng @totalItems hồ sơ đã có kết quả đánh giá</small>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show small" role="alert">
        <i class="bi bi-check-circle me-1"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show small" role="alert">
        <i class="bi bi-exclamation-triangle me-1"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Bộ lọc -->
<div class="card border-0 shadow-sm mb-4 rounded-3">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchString" value="@currentSearch" class="form-control border-start-0" placeholder="Tìm theo tên SV hoặc học bổng..." />
                </div>
            </div>
            <div class="col-md-4">
                <select name="ketQuaFilter" class="form-select">
                    <option value="">-- Tất cả kết quả --</option>
                    <option value="Được cấp học bổng" selected="@(currentKetQua == "Được cấp học bổng")">🟢 Được cấp học bổng</option>
                    <option value="Không được cấp học bổng" selected="@(currentKetQua == "Không được cấp học bổng")">🔴 Không được cấp học bổng</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary px-3"><i class="bi bi-funnel me-1"></i> Lọc</button>
                <a asp-action="Index" class="btn btn-light border px-3">Đặt lại</a>
            </div>
        </form>
    </div>
</div>

<!-- Bảng kết quả -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Sinh viên</th>
                    <th>Chương trình học bổng</th>
                    <th>Điểm đánh giá</th>
                    <th>Kết quả cuối cùng</th>
                    <th>Ngày công bố</th>
                    <th>Nhận xét của Hội đồng</th>
                    <th class="text-end pe-4">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var item in Model)
                    {
                        var isGranted = item.KetQua == "Được cấp học bổng";
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="table-avatar @(isGranted ? "bg-success text-white" : "bg-danger text-white")">
                                        <i class="bi @(isGranted ? "bi-trophy-fill" : "bi-x")"></i>
                                    </div>
                                    <div>
                                        <strong class="text-dark d-block">@(item.HoSoHocBong?.SinhVien?.HoTen ?? "N/A")</strong>
                                        <small class="text-muted">Mã hồ sơ: #@item.MaHoSoHocBong</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <strong class="text-dark d-block">@(item.HoSoHocBong?.HocBong?.TenHocBong ?? "N/A")</strong>
                                <small class="text-muted">@(item.HoSoHocBong?.HocBong?.DonViTaiTro?.TenDonViTaiTro)</small>
                            </td>
                            <td>
                                @if (item.DiemDanhGia.HasValue)
                                {
                                    <span class="badge @(item.DiemDanhGia >= 80 ? "bg-success" : (item.DiemDanhGia >= 65 ? "bg-primary" : "bg-warning text-dark")) fw-bold fs-6">
                                        @item.DiemDanhGia đ
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">N/A</span>
                                }
                            </td>
                            <td>
                                @if (isGranted)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 fw-bold">
                                        <i class="bi bi-patch-check-fill me-1"></i>Trúng tuyển
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 fw-bold">
                                        <i class="bi bi-x-octagon-fill me-1"></i>Không đạt
                                    </span>
                                }
                            </td>
                            <td>@item.NgayCapNhat.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <div class="text-truncate text-secondary" style="max-width: 250px;" title="@item.NhanXet">
                                    @(item.NhanXet ?? "Không có nhận xét")
                                </div>
                            </td>
                            <td class="text-end pe-4">
                                @if (isCanBoOrAdmin)
                                {
                                    <a asp-action="NhapKetQua" asp-route-maHoSo="@item.MaHoSoHocBong" class="btn btn-sm btn-outline-primary" title="Cập nhật lại kết quả">
                                        <i class="bi bi-pencil-square"></i> Sửa
                                    </a>
                                }
                                <a asp-controller="HoSoHocBong" asp-action="Details" asp-route-id="@item.MaHoSoHocBong" class="btn btn-sm btn-outline-secondary" title="Xem hồ sơ">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-award fs-2 d-block mb-2"></i>
                            Chưa có kết quả học bổng nào được ghi nhận.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (totalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
            <span class="small text-muted">Trang @currentPage / @totalPages</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-searchString="@currentSearch" asp-route-ketQuaFilter="@currentKetQua">&laquo;</a>
                </li>
                @for (int p = 1; p <= totalPages; p++)
                {
                    <li class="page-item @(p == currentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-searchString="@currentSearch" asp-route-ketQuaFilter="@currentKetQua">@p</a>
                    </li>
                }
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-searchString="@currentSearch" asp-route-ketQuaFilter="@currentKetQua">&raquo;</a>
                </li>
            </ul>
        </div>
    }
</div>

