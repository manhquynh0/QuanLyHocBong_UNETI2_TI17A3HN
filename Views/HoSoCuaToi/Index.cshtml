@* Họ và tên: Nguyễn Phi Hùng - Mã sinh viên: 23103100148
   Nội dung thực hiện: Module 3 - danh sách hồ sơ đã nộp, trạng thái, lịch phỏng vấn, kết quả; hủy hồ sơ. *@
@using QuanLyHocBong_UNETI2_TI17A3HN.ViewModels
@model List<HoSoDaNopViewModel>
@{
    ViewData["Title"] = "Hồ sơ của tôi";
    ViewData["Nav"] = "HoSoCuaToi";
}

<div class="page-hero">
    <div class="page-hero-copy">
        <h2>Hồ sơ của tôi</h2>
        <p>Theo dõi trạng thái các hồ sơ xin học bổng đã nộp.</p>
    </div>
</div>

@if (TempData["ThongBao"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["ThongBao"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Loi"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Loi"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="ui-card">
        <div class="empty-state">
            <p class="mb-3">Bạn chưa nộp hồ sơ xin học bổng nào.</p>
            <a asp-controller="HocBongSinhVien" asp-action="Index" class="btn btn-primary">Xem danh sách học bổng</a>
        </div>
    </div>
}
else
{
    <div class="ui-card">
        <div class="table-responsive border-0">
            <table class="ui-table">
                <thead>
                    <tr>
                        <th>Học bổng</th>
                        <th>Ngày nộp</th>
                        <th>Trạng thái</th>
                        <th>Lịch phỏng vấn</th>
                        <th>Kết quả</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var h in Model)
                    {
                        <tr>
                            <td>
                                <a asp-action="Details" asp-route-id="@h.MaHoSoHocBong" class="fw-semibold">@h.TenHocBong</a>
                                <div class="text-muted small">@h.TenDonViTaiTro</div>
                            </td>
                            <td class="text-nowrap">@h.NgayNop.ToString("dd/MM/yyyy HH:mm")</td>
                            <td><partial name="_TrangThaiBadge" model="@h.TrangThai" /></td>
                            <td class="small">
                                @if (h.LichPhongVan != null)
                                {
                                    <div>@h.LichPhongVan.ThoiGianBatDau.ToString("dd/MM/yyyy HH:mm")</div>
                                    <div class="text-muted">@h.LichPhongVan.DiaDiemHoacLienKet</div>
                                }
                                else
                                {
                                    <span class="text-muted">Chưa có</span>
                                }
                            </td>
                            <td class="small">
                                @if (h.DaCongBoKetQua)
                                {
                                    <span class="@(h.KetQua!.KetQua == "Được cấp học bổng" ? "text-success fw-semibold" : "text-danger")">@h.KetQua.KetQua</span>
                                }
                                else
                                {
                                    <span class="text-muted">Chưa công bố</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@h.MaHoSoHocBong" class="btn btn-sm btn-outline-secondary">Chi tiết</a>
                                @if (h.CoTheHuy)
                                {
                                    <form asp-action="Huy" asp-route-id="@h.MaHoSoHocBong" method="post" class="d-inline js-confirm"
                                          data-confirm-title="Xác nhận hủy hồ sơ?"
                                          data-confirm-body="Hồ sơ xin học bổng sẽ bị hủy. Hành động này không thể hoàn tác."
                                          data-confirm-ok="Hủy hồ sơ">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Hủy</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
