@* Họ và tên: Nguyễn Phi Hùng - Mã sinh viên: 23103100148
   Nội dung thực hiện: Module 3 - chi tiết một hồ sơ đã nộp (chỉ hồ sơ của chính sinh viên). *@
@using QuanLyHocBong_UNETI2_TI17A3HN.ViewModels
@model HoSoDaNopViewModel
@{
    ViewData["Title"] = "Chi tiết hồ sơ";
}

<nav aria-label="breadcrumb" class="mt-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Hồ sơ đã nộp</a></li>
        <li class="breadcrumb-item active">@Model.TenHocBong</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h2 class="mb-1">@Model.TenHocBong</h2>
        <div class="text-muted">@Model.TenDonViTaiTro · Nộp lúc @Model.NgayNop.ToString("dd/MM/yyyy HH:mm")</div>
    </div>
    <div class="fs-5"><partial name="_TrangThaiBadge" model="@Model.TrangThai" /></div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card mb-3">
            <div class="card-header fw-semibold">Thư xin học bổng</div>
            <div class="card-body" style="white-space: pre-line;">@Model.ThuXinHocBong</div>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.GhiChu))
        {
            <div class="card mb-3">
                <div class="card-header fw-semibold">Ghi chú của bạn</div>
                <div class="card-body" style="white-space: pre-line;">@Model.GhiChu</div>
            </div>
        }
        @if (Model.NgayXuLy.HasValue)
        {
            <div class="card mb-3">
                <div class="card-header fw-semibold">Kết quả xét duyệt sơ bộ</div>
                <div class="card-body">
                    <div class="text-muted small mb-1">Xử lý ngày @Model.NgayXuLy.Value.ToString("dd/MM/yyyy HH:mm")</div>
                    <div style="white-space: pre-line;">@(string.IsNullOrWhiteSpace(Model.NhanXetXetDuyet) ? "Không có nhận xét." : Model.NhanXetXetDuyet)</div>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-header fw-semibold">Lịch phỏng vấn</div>
            <div class="card-body">
                @if (Model.LichPhongVan != null)
                {
                    var l = Model.LichPhongVan;
                    <dl class="mb-0">
                        <dt>Thời gian</dt>
                        <dd>@l.ThoiGianBatDau.ToString("dd/MM/yyyy HH:mm") – @l.ThoiGianKetThuc.ToString("HH:mm")</dd>
                        <dt>Hình thức</dt>
                        <dd>@(l.HinhThucPhongVan ?? "—")</dd>
                        <dt>Địa điểm / liên kết</dt>
                        <dd>@(l.DiaDiemHoacLienKet ?? "—")</dd>
                        <dt>Người phỏng vấn</dt>
                        <dd>@(l.NguoiPhongVan ?? "—")</dd>
                        @if (!string.IsNullOrWhiteSpace(l.GhiChu))
                        {
                            <dt>Lưu ý</dt>
                            <dd>@l.GhiChu</dd>
                        }
                        <dt>Trạng thái lịch</dt>
                        <dd class="mb-0">@l.TrangThai</dd>
                    </dl>
                }
                else
                {
                    <span class="text-muted">Chưa có lịch phỏng vấn.</span>
                }
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header fw-semibold">Kết quả xét học bổng</div>
            <div class="card-body">
                @if (Model.DaCongBoKetQua)
                {
                    <div class="fs-5 fw-semibold @(Model.KetQua!.KetQua == "Được cấp học bổng" ? "text-success" : "text-danger")">@Model.KetQua.KetQua</div>
                    @if (Model.KetQua.DiemDanhGia.HasValue)
                    {
                        <div class="small">Điểm đánh giá: @Model.KetQua.DiemDanhGia.Value.ToString("0.##")</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.KetQua.NhanXet))
                    {
                        <div class="small mt-2" style="white-space: pre-line;">@Model.KetQua.NhanXet</div>
                    }
                    <div class="text-muted small mt-2">Cập nhật @Model.KetQua.NgayCapNhat.ToString("dd/MM/yyyy")</div>
                }
                else
                {
                    <span class="text-muted">Chưa công bố.</span>
                }
            </div>
        </div>

        @if (Model.CoTheHuy)
        {
            <form asp-action="Huy" asp-route-id="@Model.MaHoSoHocBong" method="post"
                  onsubmit="return confirm('Bạn chắc chắn muốn hủy hồ sơ này?');">
                <button type="submit" class="btn btn-outline-danger w-100">Hủy hồ sơ</button>
            </form>
        }
    </div>
</div>
