@using QuanLyHocBong_UNETI2_TI17A3HN.Helpers
@using QuanLyHocBong_UNETI2_TI17A3HN.ViewModels
@model List<HoSoDaNopViewModel>
@{
    ViewData["Title"] = "Kết quả học bổng của tôi";
    ViewData["Nav"] = "KetQua";
    var dat = Model.FirstOrDefault(h => h.TrangThai == TrangThaiHoSo.DuocCap);
}

<div class="page-hero">
    <div class="page-hero-copy">
        <h2>Kết quả học bổng của tôi</h2>
        <p>Các quyết định đã được hội đồng xét duyệt và công bố chính thức.</p>
    </div>
</div>

@if (dat != null)
{
    <div class="result-banner">
        <div class="result-banner-copy">
            <div class="result-icon"><i class="bi bi-award-fill"></i></div>
            <div>
                <h3>Chúc mừng! Bạn đã đạt học bổng</h3>
                <p>@dat.TenHocBong</p>
            </div>
        </div>
    </div>
}

<div class="ui-card">
    @if (!Model.Any())
    {
        <div class="empty-state">Chưa có hồ sơ để hiển thị kết quả.</div>
    }
    else
    {
        <div class="table-responsive border-0">
            <table class="ui-table">
                <thead>
                    <tr>
                        <th>Chương trình</th>
                        <th>Kết quả</th>
                        <th>Ngày nộp</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var h in Model)
                    {
                        string kqText;
                        string kqClass;
                        if (h.TrangThai == TrangThaiHoSo.DuocCap)
                        {
                            kqText = "Đạt học bổng";
                            kqClass = "st-green";
                        }
                        else if (h.TrangThai == TrangThaiHoSo.KhongDuocCap || h.TrangThai == TrangThaiHoSo.KhongDatSoBo)
                        {
                            kqText = "Không đạt";
                            kqClass = "st-red";
                        }
                        else if (h.TrangThai == TrangThaiHoSo.DaHuy)
                        {
                            kqText = "Đã hủy";
                            kqClass = "st-gray";
                        }
                        else
                        {
                            kqText = "Chờ công bố";
                            kqClass = "st-yellow";
                        }
                        <tr>
                            <td class="fw-semibold">@h.TenHocBong</td>
                            <td><span class="st @kqClass">@kqText</span></td>
                            <td style="font-variant-numeric: tabular-nums;">@h.NgayNop.ToString("dd/MM/yyyy")</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@h.MaHoSoHocBong" class="btn btn-sm btn-outline-secondary">Chi tiết</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
