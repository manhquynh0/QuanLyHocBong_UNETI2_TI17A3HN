@{
    ViewData["Title"] = "Từ chối truy cập";
}

<div class="text-center py-5">
    <div class="display-1 text-danger mb-3"><i class="bi bi-shield-x"></i></div>
    <h2 class="fw-bold text-dark">403 - Bạn không có quyền truy cập</h2>
    <p class="text-muted max-w-md mx-auto">
        Tài khoản hiện tại của bạn không có đủ thẩm quyền để thực hiện chức năng này. Vui lòng liên hệ Quản trị viên nếu bạn cho rằng đây là một sự nhầm lẫn.
    </p>
    <div class="mt-4">
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 me-2">
            <i class="bi bi-house-door me-1"></i> Quay về trang chủ
        </a>
        <a asp-controller="TaiKhoan" asp-action="DangNhap" class="btn btn-outline-secondary px-4">
            <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập tài khoản khác
        </a>
    </div>
</div>

